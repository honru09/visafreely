---
import { data, countries, countryBySlug, verifiedCount, changelogCount, passportsByEasy } from '../lib/data';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pairCountFmt = data.pairCount.toLocaleString('en-US');
const verifiedFmt = verifiedCount.toLocaleString('en-US');
const correctionsFmt = changelogCount.toLocaleString('en-US');
const topPassports = passportsByEasy.slice(0, 6);
const footerDestinations = ['thailand', 'japan', 'united-states', 'france', 'united-arab-emirates', 'turkiye']
  .map((slug) => countryBySlug[slug])
  .filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="visafreely" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect x='5' y='5' width='38' height='38' rx='10' fill='none' stroke='%230b6e4f' stroke-width='3'/%3E%3Crect x='11' y='11' width='26' height='26' rx='6' fill='none' stroke='%230b6e4f' stroke-width='1.6'/%3E%3Cpath d='M16 24.5l5.5 5.5L32 19' fill='none' stroke='%230b6e4f' stroke-width='3.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <style>
      :root {
        --ink: #0d2137;
        --ink-2: #33475c;
        --muted: #64748b;
        --paper: #faf8f4;
        --card: #ffffff;
        --line: #e5e0d5;
        --brand: #0b6e4f;
        --brand-deep: #083f2e;
        --brand-ink: #0a2e3f;
        --gold: #c9a227;
        --f: #0b6e4f;
        --a: #0e7490;
        --e: #b45309;
        --t: #6d28d9;
        --r: #b3261e;
        --n: #57534e;
        --f-bg: #e9f6ef;
        --a-bg: #e6f4f8;
        --e-bg: #fdf3e3;
        --t-bg: #f1eafd;
        --r-bg: #fdeceb;
        --n-bg: #f0efed;
        --soft: #f7f4ee;
        --accent: #0b6e4f;
        --shadow: 0 1px 2px rgba(13,33,55,.05), 0 8px 24px -12px rgba(13,33,55,.18);
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; overflow-x: clip; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.55;
        font-size: 16.5px;
      }
      a { color: var(--brand); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      .narrow { max-width: 760px; }

      /* ---------- header ---------- */
      header.site {
        position: sticky; top: 0; z-index: 60;
        background: rgba(250,248,244,.94);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
        box-shadow: 0 1px 0 rgba(13,33,55,.03);
      }
      .header-in { display: flex; align-items: center; gap: 26px; padding-top: 10px; padding-bottom: 10px; }
      .brand { display: flex; align-items: center; gap: 9px; color: var(--ink); }
      .brand:hover { text-decoration: none; }
      .stamp-mark { color: var(--brand); display: inline-flex; flex: none; }
      .stamp-mark svg { width: 30px; height: 30px; display: block; }
      .wordmark { font-weight: 800; font-size: 21px; letter-spacing: -0.02em; color: var(--ink); }
      .wordmark em { font-style: normal; color: var(--brand); }
      nav.main { display: flex; gap: 20px; font-size: 15px; margin-left: auto; }
      nav.main a { color: var(--ink-2); font-weight: 550; }
      .check-btn {
        background: var(--brand); color: #fff; font-weight: 700; font-size: 14.5px;
        padding: 8px 16px; border-radius: 999px; white-space: nowrap;
      }
      .check-btn:hover { text-decoration: none; filter: brightness(1.08); }
      @media (max-width: 640px) { nav.main { display: none; } .check-btn { margin-left: auto; } }
      main { padding: 28px 0 52px; }

      /* ---------- type ---------- */
      h1 { font-size: 32px; line-height: 1.15; letter-spacing: -0.015em; margin: 0 0 10px; }
      .h-display { font-size: clamp(34px, 6vw, 52px); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 14px; }
      h2 { font-size: 22px; margin: 34px 0 12px; letter-spacing: -0.01em; }
      h3 { font-size: 17px; margin: 22px 0 8px; }
      p.lede { font-size: 18px; color: var(--ink-2); margin: 0 0 14px; }
      .muted { color: var(--muted); }
      .small { font-size: 13.5px; }
      .micro { font-size: 12px; text-transform: uppercase; letter-spacing: .07em; font-weight: 700; color: var(--muted); }

      /* ---------- chips / pills ---------- */
      .chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 650;
        border: 1px solid var(--line); background: var(--soft); white-space: nowrap; color: var(--ink-2);
      }
      .chip .g {
        display: inline-flex; align-items: center; justify-content: center;
        width: 15px; height: 15px; border-radius: 50%; font-size: 10.5px; font-weight: 800;
        background: currentColor; flex: none;
      }
      .chip .g i { font-style: normal; color: #fff; line-height: 1; }
      .chip.F { color: var(--f); border-color: #bfe3d0; background: var(--f-bg); }
      .chip.A { color: var(--a); border-color: #bfe0eb; background: var(--a-bg); }
      .chip.E { color: var(--e); border-color: #f0d9ae; background: var(--e-bg); }
      .chip.T { color: var(--t); border-color: #ddd0f5; background: var(--t-bg); }
      .chip.R { color: var(--r); border-color: #f0c4c1; background: var(--r-bg); }
      .chip.N { color: var(--n); border-color: #d8d4cc; background: var(--n-bg); }
      .count-pill {
        display: inline-block; vertical-align: middle; margin-left: 8px;
        background: var(--soft); border: 1px solid var(--line); color: var(--ink-2);
        border-radius: 999px; font-size: 13.5px; font-weight: 700; padding: 1px 10px;
      }
      .sdot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; flex: none; }
      .sdot.F { background: var(--f); } .sdot.A { background: var(--a); } .sdot.E { background: var(--e); }
      .sdot.T { background: var(--t); } .sdot.R { background: var(--r); } .sdot.N { background: var(--n); }

      /* ---------- bands / hero ---------- */
      .band {
        width: 100vw; margin-left: calc(50% - 50vw); margin-top: -28px;
        position: relative; overflow: hidden;
      }
      .band-in { max-width: 1080px; margin: 0 auto; padding: 52px 20px 56px; position: relative; }
      .band.dark { background: linear-gradient(125deg, var(--brand-ink) 0%, var(--brand-deep) 90%); color: #eef6f1; }
      .band.dark .lede { color: #c9ded2; }
      .band.light { background: linear-gradient(160deg, #f4f0e6 0%, #eaf3ec 100%); border-bottom: 1px solid var(--line); }
      .band.light .band-in { padding-top: 40px; padding-bottom: 40px; }
      .hero-wm { position: absolute; width: 430px; height: 430px; right: -110px; top: -120px; opacity: .09; color: #ffffff; transform: rotate(10deg); pointer-events: none; }
      .hero-wm svg { width: 100%; height: 100%; }
      .hero-note { font-size: 14px; color: #bcd6c6; margin: 14px 2px 0; max-width: 640px; }

      /* ---------- checker ---------- */
      .checker-card { background: var(--card); border-radius: 14px; box-shadow: var(--shadow); padding: 20px; color: var(--ink); max-width: 820px; }
      .checker { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; }
      .checker label { display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; font-weight: 650; color: var(--ink-2); flex: 1 1 200px; }
      .checker input {
        padding: 11px 12px; font-size: 16px; border: 1px solid var(--line); border-radius: 10px;
        background: #fff; color: var(--ink); width: 100%; font-family: inherit;
      }
      .checker input:focus { outline: 2px solid var(--brand); outline-offset: 1px; border-color: var(--brand); }
      .swap-btn {
        flex: none; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line);
        background: var(--soft); color: var(--ink-2); font-size: 17px; cursor: pointer; line-height: 1;
      }
      .swap-btn:hover { border-color: var(--brand); color: var(--brand); }
      .checker .go-btn {
        padding: 11px 24px; font-size: 16px; font-weight: 700; border: 0; border-radius: 10px;
        background: var(--brand); color: #fff; cursor: pointer; font-family: inherit;
      }
      .checker .go-btn:hover { filter: brightness(1.08); }
      .route-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; align-items: center; }
      .route-chips .rc-label { font-size: 13px; color: #bcd6c6; font-weight: 600; }
      .route-chip {
        border: 1px solid rgba(255,255,255,.35); background: rgba(255,255,255,.08); color: #eef6f1;
        border-radius: 999px; padding: 5px 13px; font-size: 13.5px; font-weight: 600; cursor: pointer; font-family: inherit;
      }
      .route-chip:hover { background: rgba(255,255,255,.18); }
      .instant-verdict { margin-top: 16px; border: 1px solid var(--line); border-left: 5px solid var(--brand); border-radius: 12px; padding: 16px 18px; background: var(--soft); }
      .instant-verdict .big { font-size: 22px; font-weight: 750; letter-spacing: -0.01em; }
      .instant-verdict.s-F { border-left-color: var(--f); background: var(--f-bg); }
      .instant-verdict.s-A { border-left-color: var(--a); background: var(--a-bg); }
      .instant-verdict.s-E { border-left-color: var(--e); background: var(--e-bg); }
      .instant-verdict.s-T { border-left-color: var(--t); background: var(--t-bg); }
      .instant-verdict.s-R { border-left-color: var(--r); background: var(--r-bg); }
      .instant-verdict.s-N { border-left-color: var(--n); background: var(--n-bg); }
      .btn {
        display: inline-block; background: var(--brand); color: #fff; font-weight: 700;
        padding: 9px 18px; border-radius: 10px; font-size: 15px;
      }
      .btn:hover { text-decoration: none; filter: brightness(1.08); }

      /* ---------- stat band ---------- */
      .stat-band { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 26px 0 6px; }
      @media (max-width: 720px) { .stat-band { grid-template-columns: repeat(2, 1fr); } }
      .stat-tile { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
      .stat-tile b { display: block; font-size: 30px; font-weight: 750; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
      .stat-tile span { font-size: 13.5px; color: var(--muted); }
      .stat-row { display: flex; gap: 26px; flex-wrap: wrap; margin: 16px 0; }
      .stat-row .stat b { display: block; font-size: 22px; letter-spacing: -0.01em; }
      .stat-row .stat span { font-size: 13px; color: var(--muted); }

      /* ---------- cards & grids ---------- */
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
      .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 14px 0; }
      @media (max-width: 860px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }
      .route-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(228px, 1fr)); gap: 10px; margin: 12px 0 6px; }
      .route-card {
        display: block; background: var(--card); border: 1px solid var(--line); border-radius: 12px;
        padding: 12px 14px; color: var(--ink);
      }
      .route-card:hover { text-decoration: none; border-color: var(--brand); box-shadow: var(--shadow); }
      .route-card .rc-top { display: flex; align-items: center; gap: 8px; }
      .route-card .rc-name { font-weight: 700; font-size: 15.5px; }
      .route-card .rc-meta { display: block; font-size: 13.5px; color: var(--muted); margin-top: 3px; }
      .route-card .chip { margin-top: 8px; }
      .pill-cloud { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
      .pill-cloud a {
        border: 1px solid var(--line); background: var(--card); color: var(--ink-2);
        border-radius: 999px; padding: 4px 13px; font-size: 14px;
      }
      .pill-cloud a:hover { border-color: var(--brand); color: var(--brand); text-decoration: none; }
      ul.linklist { list-style: none; padding: 0; margin: 8px 0; columns: 2; column-gap: 28px; }
      ul.linklist li { padding: 3px 0; break-inside: avoid; font-size: 15px; }
      @media (max-width: 640px) { ul.linklist { columns: 1; } }

      /* ---------- verdict hero & seal ---------- */
      .crumbs { font-size: 13.5px; color: var(--muted); margin-bottom: 14px; }
      .verdict { border: 1px solid var(--line); border-left: 5px solid var(--brand); border-radius: 12px; padding: 18px 20px; background: var(--soft); margin: 18px 0; }
      .verdict .big { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; }
      .verdict-hero { border: 1px solid var(--line); border-top: 6px solid var(--brand); border-radius: 14px; padding: 20px 22px; margin: 16px 0; background: var(--card); }
      .verdict-hero.s-F { border-top-color: var(--f); background: var(--f-bg); }
      .verdict-hero.s-A { border-top-color: var(--a); background: var(--a-bg); }
      .verdict-hero.s-E { border-top-color: var(--e); background: var(--e-bg); }
      .verdict-hero.s-T { border-top-color: var(--t); background: var(--t-bg); }
      .verdict-hero.s-R { border-top-color: var(--r); background: var(--r-bg); }
      .verdict-hero.s-N { border-top-color: var(--n); background: var(--n-bg); }
      .verdict-hero .route-line { font-size: 12px; text-transform: uppercase; letter-spacing: .07em; font-weight: 700; color: var(--ink-2); margin: 0 0 6px; }
      .verdict-hero .big { font-size: 30px; font-weight: 780; letter-spacing: -0.015em; line-height: 1.15; margin: 0 0 6px; }
      .fact-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px; }
      @media (max-width: 640px) { .fact-tiles { grid-template-columns: 1fr; } .verdict-hero .big { font-size: 25px; } }
      .fact-tile { background: rgba(255,255,255,.75); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; }
      .fact-tile .fl { font-size: 12px; text-transform: uppercase; letter-spacing: .07em; font-weight: 700; color: var(--muted); }
      .fact-tile .fv { font-weight: 650; font-size: 15.5px; margin-top: 2px; }
      .seal { display: flex; gap: 14px; border-radius: 14px; padding: 16px 18px; margin: 14px 0; font-size: 15px; }
      .seal .seal-mark { flex: none; width: 46px; height: 46px; }
      .seal .seal-mark svg { width: 46px; height: 46px; display: block; }
      .seal p { margin: 0 0 4px; }
      .seal p:last-child { margin-bottom: 0; }
      .seal .seal-title { font-weight: 700; }
      .seal.verified { border: 1.5px solid var(--brand); background: #eef7f2; color: var(--ink); }
      .seal.verified .seal-mark { color: var(--brand); }
      .seal.pending { border: 1.5px dashed #b8b2a4; background: #f4f2ec; color: var(--ink-2); }
      .seal.pending .seal-mark { color: #8a8378; }
      .stamp { font-size: 13.5px; border: 1px dashed var(--line); border-radius: 8px; padding: 10px 14px; margin: 14px 0; color: var(--ink-2); background: #fff; }
      .warn { border: 1px solid #e6cd7e; border-left: 5px solid var(--gold); background: #fdf6dd; border-radius: 12px; padding: 13px 17px; font-size: 15px; margin: 14px 0; }

      /* ---------- spec grid ---------- */
      table.spec { border-collapse: collapse; width: 100%; margin: 12px 0; }
      table.spec th, table.spec td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; font-size: 15px; }
      table.spec th { width: 190px; color: var(--muted); font-weight: 600; }
      .spec-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 6px 20px; margin: 12px 0; }
      .spec-row { display: flex; gap: 18px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 15.5px; }
      .spec-row:last-child { border-bottom: 0; }
      .spec-row dt { flex: 0 0 190px; color: var(--muted); font-weight: 600; margin: 0; }
      .spec-row dd { margin: 0; }
      @media (max-width: 640px) { .spec-row { flex-direction: column; gap: 2px; } .spec-row dt { flex: none; } }

      /* ---------- steps & checklist ---------- */
      ol.steps { list-style: none; counter-reset: step; padding: 0; margin: 12px 0; display: grid; gap: 10px; }
      ol.steps li {
        counter-increment: step; display: flex; gap: 13px; align-items: flex-start;
        background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 13px 16px; font-size: 15.5px;
      }
      ol.steps li::before {
        content: counter(step); flex: none; width: 26px; height: 26px; border-radius: 50%;
        background: var(--brand); color: #fff; font-weight: 750; font-size: 14.5px;
        display: flex; align-items: center; justify-content: center; margin-top: 1px;
      }
      ul.checklist { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 9px; }
      ul.checklist li { display: flex; gap: 10px; font-size: 15.5px; align-items: flex-start; }
      ul.checklist li::before {
        content: "✓"; flex: none; width: 20px; height: 20px; border-radius: 50%; margin-top: 2px;
        background: var(--f-bg); color: var(--brand); border: 1px solid #bfe3d0;
        font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center;
      }

      /* ---------- FAQ ---------- */
      .faq-item { background: var(--card); border: 1px solid var(--line); border-radius: 12px; margin: 10px 0; }
      .faq-item summary { cursor: pointer; font-weight: 700; font-size: 16px; padding: 14px 18px; list-style-position: inside; }
      .faq-item .faq-a { padding: 0 18px 15px; color: var(--ink-2); font-size: 15.5px; }
      .faq-item .faq-a p { margin: 0; }

      /* ---------- shelf ---------- */
      .shelf { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 14px 0; }
      @media (max-width: 720px) { .shelf { grid-template-columns: 1fr; } }
      .shelf .card { border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; background: var(--card); }
      .shelf .card .k { font-size: 12px; text-transform: uppercase; letter-spacing: .07em; color: var(--gold); font-weight: 750; }
      .shelf .card .t { font-weight: 750; font-size: 17px; margin: 3px 0; }
      .shelf .card p { margin: 4px 0 10px; font-size: 14.5px; color: var(--ink-2); }

      /* ---------- home sections ---------- */
      .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 14px 0; }
      .how-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
      @media (max-width: 860px) { .how-grid { grid-template-columns: 1fr; } .how-grid.cols-2 { grid-template-columns: 1fr; } }
      .how-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
      .how-card .num {
        display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px;
        border-radius: 50%; background: var(--brand-ink); color: #fff; font-weight: 750; font-size: 15px;
      }
      .how-card h3 { margin: 10px 0 6px; }
      .how-card p { margin: 0; font-size: 15px; color: var(--ink-2); }
      .seal.mini { margin: 12px 0 0; padding: 12px 14px; font-size: 13.5px; }
      .seal.mini .seal-mark, .seal.mini .seal-mark svg { width: 34px; height: 34px; }
      .contrast { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 14px 0; }
      @media (max-width: 720px) { .contrast { grid-template-columns: 1fr; } }
      .contrast-card { border-radius: 14px; padding: 18px 20px; border: 1px solid var(--line); background: var(--card); }
      .contrast-card.bad { background: #f4f2ec; color: var(--ink-2); }
      .contrast-card.good { border-color: var(--brand); background: #eef7f2; }
      .contrast-card h3 { margin: 0 0 8px; }
      .contrast-card ul { margin: 0; padding-left: 18px; font-size: 15px; display: grid; gap: 5px; }
      .rank-rows { display: grid; gap: 8px; margin: 12px 0; }
      .rank-row { display: flex; align-items: center; gap: 13px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 11px 16px; }
      .rank-medal {
        flex: none; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 14.5px; background: var(--soft); border: 1px solid var(--line); color: var(--ink-2); font-variant-numeric: tabular-nums;
      }
      .rank-medal.top { background: #faf0cd; border-color: var(--gold); color: #7a5d08; }
      .rank-medal.big { width: 52px; height: 52px; font-size: 19px; }
      .rank-row .rr-name { font-weight: 700; flex: none; }
      .rank-row .bar { flex: 1; height: 8px; border-radius: 999px; background: var(--soft); border: 1px solid var(--line); overflow: hidden; min-width: 60px; }
      .rank-row .bar i { display: block; height: 100%; background: var(--brand); }
      .rank-row .rr-count { flex: none; font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; text-align: right; }
      @media (max-width: 560px) { .rank-row .rr-count { display: none; } }
      .legend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 12px 0; }
      @media (max-width: 860px) { .legend-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 560px) { .legend-grid { grid-template-columns: 1fr; } }
      .legend-card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 13px 15px; font-size: 14.5px; color: var(--ink-2); }
      .legend-card p { margin: 7px 0 0; }
      .closing-band { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 22px; text-align: center; margin: 30px 0 6px; }
      .closing-band h2 { margin-top: 0; }
      .hub-hero-flex { display: flex; gap: 18px; align-items: flex-start; }
      .hub-hero-flex .rank-block { flex: none; text-align: center; }
      .hub-hero-flex .rank-block .rb-label { font-size: 12px; text-transform: uppercase; letter-spacing: .07em; font-weight: 700; color: var(--muted); margin-top: 5px; }

      /* ---------- indexes ---------- */
      .letter-jump {
        position: sticky; top: 53px; z-index: 40; background: var(--paper);
        display: flex; flex-wrap: wrap; gap: 4px; padding: 9px 0; border-bottom: 1px solid var(--line); margin-bottom: 6px;
      }
      .letter-jump a {
        min-width: 30px; text-align: center; padding: 3px 7px; border-radius: 8px;
        font-size: 14px; font-weight: 700; color: var(--ink-2); background: var(--card); border: 1px solid var(--line);
      }
      .letter-jump a:hover { text-decoration: none; border-color: var(--brand); color: var(--brand); }
      .index-group h2 { font-size: 26px; margin: 26px 0 8px; color: var(--brand-ink); }
      .index-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      @media (max-width: 640px) { .index-rows { grid-template-columns: 1fr; } }
      .index-row {
        display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
        background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; color: var(--ink);
      }
      .index-row:hover { text-decoration: none; border-color: var(--brand); }
      .index-row .ir-name { font-weight: 650; }
      .index-row .ir-stat { font-size: 13px; color: var(--muted); white-space: nowrap; }

      /* ---------- changelog timeline ---------- */
      .timeline { margin: 18px 0 0; }
      .tl-entry { display: grid; grid-template-columns: 118px 1fr; gap: 16px; padding: 0 0 14px; }
      @media (max-width: 640px) { .tl-entry { grid-template-columns: 1fr; gap: 6px; } }
      .tl-date { font-size: 13.5px; color: var(--muted); font-weight: 650; padding-top: 15px; font-variant-numeric: tabular-nums; }
      @media (max-width: 640px) { .tl-date { padding-top: 0; } }
      .tl-card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; }
      .tl-card h3 { margin: 5px 0 6px; }
      .tl-card p { margin: 4px 0; font-size: 15px; color: var(--ink-2); }
      .pill-old, .pill-new { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 650; border: 1px solid; }
      .pill-old { color: var(--r); border-color: #f0c4c1; background: var(--r-bg); }
      .pill-new { color: var(--f); border-color: #bfe3d0; background: var(--f-bg); }
      .source-chip {
        display: inline-flex; max-width: 100%; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 600;
        border: 1px solid var(--line); background: var(--soft); color: var(--ink-2); overflow-wrap: anywhere;
      }
      .pair-chip {
        display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 650;
        border: 1px solid #bfe3d0; background: var(--f-bg); color: var(--brand-deep);
      }

      /* ---------- trust bar & footer ---------- */
      .trustbar { border-top: 1px solid var(--line); background: #eef5f0; }
      .trustbar p { margin: 0; padding: 11px 0; font-size: 14px; color: var(--ink-2); text-align: center; }
      footer.site { border-top: 1px solid var(--line); padding: 30px 0 34px; color: var(--muted); font-size: 14px; background: var(--card); }
      .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 26px; }
      @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
      @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
      footer.site h4 { font-size: 12px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); margin: 0 0 9px; }
      footer.site ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
      footer.site ul a { color: var(--muted); }
      .f-brand p { margin: 10px 0 0; max-width: 300px; }
      .f-legal { border-top: 1px solid var(--line); margin: 24px 0 0; padding-top: 16px; font-size: 13.5px; }
      @media (max-width: 640px) { h1 { font-size: 26px; } }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap header-in">
        <a class="brand" href="/" aria-label="visafreely — home">
          <span class="stamp-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><g transform="rotate(-4 24 24)"><rect x="4.5" y="4.5" width="39" height="39" rx="10" stroke="currentColor" stroke-width="2.6"/><rect x="10" y="10" width="28" height="28" rx="6.5" stroke="currentColor" stroke-width="1.3"/><path d="M16 24.5l5.5 5.5L32 19" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
          </span>
          <span class="wordmark">visa<em>freely</em></span>
        </a>
        <nav class="main">
          <a href="/passports/">Passports</a>
          <a href="/destinations/">Destinations</a>
          <a href="/changelog/">Changelog</a>
          <a href="/about/">About</a>
        </nav>
        <a class="check-btn" href="/#checker">Check a route</a>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <div class="trustbar">
      <div class="wrap">
        <p>
          <strong>{pairCountFmt} pairs</strong> · {verifiedFmt} verified against official sources · {correctionsFmt} corrections published —
          see the <a href="/changelog/">changelog</a> and <a href="/about/">how we verify</a>.
        </p>
      </div>
    </div>
    <footer class="site">
      <div class="wrap">
        <div class="footer-grid">
          <div class="f-brand">
            <a class="brand" href="/" aria-label="visafreely — home">
              <span class="stamp-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><g transform="rotate(-4 24 24)"><rect x="4.5" y="4.5" width="39" height="39" rx="10" stroke="currentColor" stroke-width="2.6"/><rect x="10" y="10" width="28" height="28" rx="6.5" stroke="currentColor" stroke-width="1.3"/><path d="M16 24.5l5.5 5.5L32 19" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
              </span>
              <span class="wordmark">visa<em>freely</em></span>
            </a>
            <p>
              Free visa requirement checks for {countries.length} passports. Every answer shows its
              evidence — a verified date and an official source, or an honest dataset label.
            </p>
          </div>
          <nav aria-label="Top passports">
            <h4>Passports</h4>
            <ul>
              {topPassports.map((r) => (
                <li><a href={`/passport/${r.c.slug}/`}>{r.c.name} passport</a></li>
              ))}
              <li><a href="/passports/">All passports</a></li>
            </ul>
          </nav>
          <nav aria-label="Popular destinations">
            <h4>Destinations</h4>
            <ul>
              {footerDestinations.map((c) => (
                <li><a href={`/destination/${c.slug}/`}>{c.name}</a></li>
              ))}
              <li><a href="/destinations/">All destinations</a></li>
            </ul>
          </nav>
          <nav aria-label="About visafreely">
            <h4>visafreely</h4>
            <ul>
              <li><a href="/about/">About the data</a></li>
              <li><a href="/changelog/">Changelog</a></li>
              <li><a href="/#checker">Check a route</a></li>
            </ul>
          </nav>
        </div>
        <p class="f-legal">
          Visa requirements change often and this site is a guide, not an official source.
          Always confirm with the destination's embassy or official immigration authority before you travel.
          Data: passport-index dataset (MIT), February 2026 snapshot, with corrections listed in the
          <a href="/changelog/">changelog</a>. See <a href="/about/">how we verify</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
