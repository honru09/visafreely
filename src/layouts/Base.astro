---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛂</text></svg>" />
    <style>
      :root {
        --ink: #17202a;
        --muted: #5d6d7e;
        --line: #e3e8ee;
        --bg: #ffffff;
        --soft: #f6f8fa;
        --accent: #0b5cad;
        --f: #117a3d;
        --a: #0e7490;
        --e: #b45309;
        --t: #b45309;
        --r: #b3261e;
        --n: #44403c;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.55;
        font-size: 16px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 920px; margin: 0 auto; padding: 0 20px; }
      header.site {
        border-bottom: 1px solid var(--line);
        padding: 14px 0;
      }
      header.site .wrap { display: flex; align-items: baseline; gap: 22px; flex-wrap: wrap; }
      .brand { font-weight: 700; font-size: 20px; color: var(--ink); letter-spacing: -0.01em; }
      .brand span { color: var(--accent); }
      nav.main { display: flex; gap: 16px; font-size: 14.5px; }
      nav.main a { color: var(--muted); }
      main { padding: 28px 0 48px; }
      footer.site {
        border-top: 1px solid var(--line);
        padding: 22px 0 34px;
        color: var(--muted);
        font-size: 13.5px;
      }
      h1 { font-size: 30px; line-height: 1.2; letter-spacing: -0.015em; margin: 0 0 10px; }
      h2 { font-size: 20px; margin: 30px 0 10px; letter-spacing: -0.01em; }
      h3 { font-size: 16.5px; margin: 22px 0 8px; }
      p.lede { font-size: 17.5px; color: #2c3e50; margin: 0 0 14px; }
      .muted { color: var(--muted); }
      .small { font-size: 13.5px; }
      .chip {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--line);
        background: var(--soft);
        white-space: nowrap;
      }
      .chip.F { color: var(--f); border-color: #bbe5c8; background: #effaf2; }
      .chip.A { color: var(--a); border-color: #bfe6ef; background: #effafd; }
      .chip.E, .chip.T { color: var(--e); border-color: #f3ddba; background: #fdf6e9; }
      .chip.R { color: var(--r); border-color: #f3c2bf; background: #fdf0ef; }
      .chip.N { color: var(--n); }
      .verdict {
        border: 1px solid var(--line);
        border-left: 5px solid var(--accent);
        border-radius: 8px;
        padding: 18px 20px;
        background: var(--soft);
        margin: 18px 0;
      }
      .verdict .big { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; }
      table.spec { border-collapse: collapse; width: 100%; margin: 12px 0; }
      table.spec th, table.spec td {
        text-align: left;
        padding: 9px 12px;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
        font-size: 15px;
      }
      table.spec th { width: 190px; color: var(--muted); font-weight: 600; }
      .stamp {
        font-size: 13.5px;
        border: 1px dashed var(--line);
        border-radius: 8px;
        padding: 10px 14px;
        margin: 14px 0;
        color: #2c3e50;
        background: #fff;
      }
      .warn {
        border: 1px solid #f3ddba;
        background: #fdf6e9;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 14.5px;
        margin: 14px 0;
      }
      ul.linklist { list-style: none; padding: 0; margin: 8px 0; columns: 2; column-gap: 28px; }
      ul.linklist li { padding: 3px 0; break-inside: avoid; font-size: 15px; }
      @media (max-width: 640px) { ul.linklist { columns: 1; } h1 { font-size: 25px; } }
      .shelf { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 14px 0; }
      @media (max-width: 720px) { .shelf { grid-template-columns: 1fr; } }
      .shelf .card {
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 14px 16px;
        background: #fff;
      }
      .shelf .card .k { font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
      .shelf .card .t { font-weight: 700; margin: 3px 0; }
      .shelf .card p { margin: 4px 0 8px; font-size: 14px; color: #2c3e50; }
      .crumbs { font-size: 13.5px; color: var(--muted); margin-bottom: 14px; }
      .stat-row { display: flex; gap: 26px; flex-wrap: wrap; margin: 16px 0; }
      .stat-row .stat b { display: block; font-size: 22px; letter-spacing: -0.01em; }
      .stat-row .stat span { font-size: 13px; color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">visa<span>freely</span></a>
        <nav class="main">
          <a href="/passports/">Passports</a>
          <a href="/destinations/">Destinations</a>
          <a href="/changelog/">Data changelog</a>
          <a href="/about/">About the data</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          Visa requirements change often and this site is a guide, not an official source.
          Always confirm with the destination's embassy or official immigration authority before you travel.
          Data: passport-index dataset (MIT), February 2026 snapshot, with corrections listed in the
          <a href="/changelog/">changelog</a>. See <a href="/about/">how we verify</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
