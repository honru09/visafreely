---
// Passport comparison — the "second passport delta" tool (passports.io study, ADOPT-2).
// Pick the passport you hold (A) and one to compare (B): the page lines up every
// destination both can be judged on and shows where B is easier, where it newly
// opens a destination without a prior visa, and — honestly — where it is worse.
// Everything is computed from the same dataset as the route pages; SSR renders
// the default comparison in full, the inline script recomputes in place.
// No shelf, no affiliate links, and nothing about how to obtain a passport.
//
// Localized variant: display names, short status labels and all script
// strings ride in the payload (M.names / M.short / M.str); the English
// page renders exactly the original text.
import Base from '../layouts/Base.astro';
import ExploreStrip from '../components/ExploreStrip.astro';
import {
  countries,
  countryByCode,
  easyAccessCount,
  passportRank,
  pairPath,
  flagEmoji,
  data,
  type Country,
} from '../lib/data';
import {
  t as i18nT,
  countryName,
  statusShortL,
  hrefFor,
  type LocaleCode,
} from '../i18n/locales';
import availabilityRaw from '../i18n/availability.json';
import aliasesRaw from '../data/country-aliases.json';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);
const nm = (c: Country) => countryName(locale, c);
const shortL = (code: string) => statusShortL(locale, code);

const DEFAULT_A = 'CN';
const DEFAULT_B = 'JP';

// ---- Ease ladder (contract in compare-tool-2026-11-14/PROGRESS.md) ----
// F nothing to file · A nothing before departure · T light online authorisation
// (counted in the site's "no prior visa" metric) · E full application approved
// before travel · R embassy application · N no admission.
const RANK: Record<string, number> = { F: 5, A: 4, T: 3, E: 2, R: 1, N: 0 };
const EASY = new Set(['F', 'A', 'T']);
const SHORT: Record<string, string> = Object.fromEntries(
  ['F', 'A', 'E', 'T', 'R', 'N'].map((s) => [s, shortL(s)]),
);

// ---- Per-passport status + stay-length strings, indexed by countries order ----
// Status row: 'S' = own country, else the pair status. Days row: only F/A rows
// carry a stay length, encoded as the index char into DAYS_TABLE ('·' = none).
const ALPHA = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const posByCode: Record<string, number> = Object.fromEntries(countries.map((c, i) => [c.code, i]));
const dayValues = new Set<number>();
for (const rows of Object.values(data.byPassport))
  for (const r of rows) if ((r.s === 'F' || r.s === 'A') && r.days != null) dayValues.add(r.days);
const DAYS_TABLE = [...dayValues].sort((a, b) => a - b);
if (DAYS_TABLE.length > ALPHA.length) throw new Error('compare: days table overflows alphabet');

const rows: Record<string, string> = {};
const daysRows: Record<string, string> = {};
for (const c of countries) {
  const byDest = new Map((data.byPassport[c.code] || []).map((r) => [r.d, r]));
  rows[c.code] = countries.map((d) => (d.code === c.code ? 'S' : byDest.get(d.code)?.s ?? '·')).join('');
  daysRows[c.code] = countries
    .map((d) => {
      if (d.code === c.code) return '·';
      const r = byDest.get(d.code);
      if (!r || (r.s !== 'F' && r.s !== 'A') || r.days == null) return '·';
      return ALPHA[DAYS_TABLE.indexOf(r.days)];
    })
    .join('');
}
// Build-time guards: the comparison must mirror the pair pages exactly, or not ship.
const totalRows = Object.values(data.byPassport).reduce((n, r) => n + r.length, 0);
if (totalRows !== data.pairCount) throw new Error(`compare: row total ${totalRows} != pairCount ${data.pairCount}`);
for (const c of countries) {
  if ((data.byPassport[c.code] || []).length !== countries.length - 1)
    throw new Error(`compare: ${c.code} has ${(data.byPassport[c.code] || []).length} rows, expected ${countries.length - 1}`);
  if (rows[c.code].includes('·')) throw new Error(`compare: ${c.code} status string has a gap`);
  if (rows[c.code].length !== countries.length || daysRows[c.code].length !== countries.length)
    throw new Error(`compare: ${c.code} row length mismatch`);
}

interface Item {
  dest: (typeof countries)[number];
  a: string;
  b: string;
  aDays: number | null;
  bDays: number | null;
  gain: number;
}
interface Group {
  title: string;
  items: Item[];
  gain: number;
  lostEasy?: boolean;
}
interface Delta {
  newly: Group[];
  easier: Group[];
  worse: Group[];
  nNew: number;
  nEasier: number;
  nWorse: number;
  common: number;
}

function compare(aCode: string, bCode: string): Delta {
  const rowA = rows[aCode];
  const rowB = rows[bCode];
  const dayA = daysRows[aCode];
  const dayB = daysRows[bCode];
  const daysOf = (row: string, i: number) => (row[i] === '·' ? null : DAYS_TABLE[ALPHA.indexOf(row[i])]);
  const newlyByStatus: Record<string, Item[]> = { F: [], A: [], T: [] };
  const easierByTrans = new Map<string, Item[]>();
  const worseByTrans = new Map<string, Item[]>();
  const stayUp: Item[] = [];
  const stayDown: Item[] = [];
  let common = 0;
  countries.forEach((dest, i) => {
    if (dest.code === aCode || dest.code === bCode) return;
    common++;
    const sa = rowA[i];
    const sb = rowB[i];
    const item: Item = {
      dest,
      a: sa,
      b: sb,
      aDays: daysOf(dayA, i),
      bDays: daysOf(dayB, i),
      gain: RANK[sb] - RANK[sa],
    };
    if (RANK[sb] > RANK[sa]) {
      if (EASY.has(sb) && !EASY.has(sa)) newlyByStatus[sb].push(item);
      else {
        const k = `${sa}>${sb}`;
        (easierByTrans.get(k) || easierByTrans.set(k, []).get(k)!).push(item);
      }
    } else if (RANK[sb] < RANK[sa]) {
      const k = `${sa}>${sb}`;
      (worseByTrans.get(k) || worseByTrans.set(k, []).get(k)!).push(item);
    } else if (
      (sa === 'F' || sa === 'A') &&
      item.aDays != null &&
      item.bDays != null &&
      item.bDays !== item.aDays
    ) {
      (item.bDays > item.aDays ? stayUp : stayDown).push(item);
    }
  });
  const byName = (x: Item, y: Item) => (nm(x.dest) < nm(y.dest) ? -1 : 1);
  const newly: Group[] = (['F', 'A', 'T'] as const)
    .filter((s) => newlyByStatus[s].length)
    .map((s) => ({
      title: SHORT[s],
      items: newlyByStatus[s].sort(byName),
      gain: 0,
    }));
  const transGroups = (m: Map<string, Item[]>, sign: 1 | -1): Group[] =>
    [...m.entries()]
      .map(([k, items]) => {
        const [sa, sb] = k.split('>');
        return {
          title: `${SHORT[sa]} → ${SHORT[sb]}`,
          items: items.sort(byName),
          gain: (RANK[sb] - RANK[sa]) * sign,
          lostEasy: EASY.has(sa) && !EASY.has(sb),
        };
      })
      .sort((g1, g2) => g2.gain - g1.gain || g2.items.length - g1.items.length);
  const easier = transGroups(easierByTrans, 1);
  if (stayUp.length) easier.push({ title: T('cmp_stay_up'), items: stayUp.sort(byName), gain: 0 });
  const worseTrans = transGroups(worseByTrans, -1).sort(
    (g1, g2) => Number(g2.lostEasy || false) - Number(g1.lostEasy || false) || g2.gain - g1.gain || g2.items.length - g1.items.length,
  );
  if (stayDown.length) worseTrans.push({ title: T('cmp_stay_down'), items: stayDown.sort(byName), gain: 0 });
  const nNew = newly.reduce((n, g) => n + g.items.length, 0);
  const nEasier = nNew + easier.reduce((n, g) => n + g.items.length, 0);
  const nWorse = worseTrans.reduce((n, g) => n + g.items.length, 0);
  return { newly, easier, worse: worseTrans, nNew, nEasier, nWorse, common };
}

function transText(it: Item): string {
  if (it.a === it.b) {
    // Longer/shorter stay at the same status.
    return `${SHORT[it.b]} · ${T('cmp_stay_trans', { a: it.aDays, b: it.bDays })}`;
  }
  let t = `${SHORT[it.a]} → ${SHORT[it.b]}`;
  if (it.b === 'F' && it.bDays != null) t += T('cmp_dot_days', { days: it.bDays });
  if (it.b === 'A' && it.bDays != null) t += T('cmp_up_to', { days: it.bDays });
  return t;
}

const defA = countryByCode[DEFAULT_A];
const defB = countryByCode[DEFAULT_B];
const defDelta = compare(DEFAULT_A, DEFAULT_B);
const defEasyA = easyAccessCount(DEFAULT_A);
const defEasyB = easyAccessCount(DEFAULT_B);

const payload = {
  codes: countries.map((c) => c.code),
  names: Object.fromEntries(countries.map((c) => [c.code, nm(c)])),
  aka: aliasesRaw,
  slugs: Object.fromEntries(countries.map((c) => [c.code, c.slug])),
  ranks: passportRank,
  easy: Object.fromEntries(countries.map((c) => [c.code, easyAccessCount(c.code)])),
  rows,
  daysRows,
  daysTable: DAYS_TABLE,
  alpha: ALPHA,
  short: SHORT,
  total: countries.length,
  locale,
  str: {
    nameTpl: T('home_name_passport', { name: '{name}' }),
    ctxA: T('cmp_ctx_a', { a: '{a}' }),
    ctxB: T('cmp_ctx_b'),
    ctxC: T('cmp_ctx_c', { b: '{b}', total: '{total}' }),
    ctxD: T('cmp_ctx_d'),
    ctxE: T('cmp_ctx_e'),
    stayUp: T('cmp_stay_up'),
    stayDown: T('cmp_stay_down'),
    stayTrans: T('cmp_stay_trans', { a: '{a}', b: '{b}' }),
    dotDays: T('cmp_dot_days', { days: '{days}' }),
    upTo: T('cmp_up_to', { days: '{days}' }),
    hNewly: T('cmp_h_newly', { b: '{b}' }),
    hEasier: T('cmp_h_easier', { b: '{b}' }),
    hWorse: T('cmp_h_worse', { b: '{b}' }),
    empty: T('ck_empty'),
  },
};
const pairCountFmt = data.pairCount.toLocaleString('en-US');
---

<Base
  title={T('cmp_title')}
  description={T('cmp_desc', { pairs: pairCountFmt })}
  locale={locale}
>
  <h1>{T('cmp_h1')}</h1>
  <p class="lede">
    {T('cmp_lede', { pairs: pairCountFmt })}
  </p>

  <div class="checker-card cmp-card">
    <div class="checker cmp-checker">
      <div class="ck-field">
        <label for="cmp-a">{T('cmp_label_a')}</label>
        <div class="ck-wrap" id="cmp-wrap-a">
          <span class="ck-flag" id="cmp-flag-a" aria-hidden="true">{flagEmoji(defA.code)}</span>
          <input
            id="cmp-a"
            class="ck-input has-flag"
            value={nm(defA)}
            placeholder={T('ck_placeholder')}
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="cmp-list-a"
            aria-autocomplete="list"
          />
          <svg class="ck-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <button type="button" class="ck-clear" id="cmp-clear-a" aria-label={T('map_clear')} tabindex="-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          </button>
          <ul class="ck-list" id="cmp-list-a" role="listbox" aria-label={T('cmp_list_a')}></ul>
        </div>
      </div>
      <button class="swap-btn" id="cmp-swap" type="button" aria-label={T('cmp_swap')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h14M13 3l4 4-4 4M21 17H7M11 13l-4 4 4 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="ck-field">
        <label for="cmp-b">{T('cmp_label_b')}</label>
        <div class="ck-wrap" id="cmp-wrap-b">
          <span class="ck-flag" id="cmp-flag-b" aria-hidden="true">{flagEmoji(defB.code)}</span>
          <input
            id="cmp-b"
            class="ck-input has-flag"
            value={nm(defB)}
            placeholder={T('ck_placeholder')}
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="cmp-list-b"
            aria-autocomplete="list"
          />
          <svg class="ck-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <button type="button" class="ck-clear" id="cmp-clear-b" aria-label={T('map_clear')} tabindex="-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          </button>
          <ul class="ck-list" id="cmp-list-b" role="listbox" aria-label={T('cmp_list_b')}></ul>
        </div>
      </div>
    </div>
  </div>

  <div id="cmp-results">
    <p class="cmp-summary" aria-live="polite">
      {T('cmp_sum_a')}<b id="cs-b-name">{T('home_name_passport', { name: nm(defB) })}</b>{T('cmp_sum_b')}<b id="cs-a-name">{T('home_name_passport', { name: nm(defA) })}</b>{T('cmp_sum_c')}<b class="tnum" id="cs-common">{defDelta.common}</b>{T('cmp_sum_d')}
    </p>
    <div class="cmp-stats">
      <div class="stat-tile"><b class="tnum" id="cs-new">{defDelta.nNew}</b><span>{T('cmp_stat_new')}</span></div>
      <div class="stat-tile"><b class="tnum" id="cs-easier">{defDelta.nEasier}</b><span>{T('cmp_stat_easier')}</span></div>
      <div class="stat-tile"><b class="tnum" id="cs-worse">{defDelta.nWorse}</b><span>{T('cmp_stat_worse')}</span></div>
    </div>
    <p class="cmp-context">
      <span id="cs-ctx-a">{T('cmp_ctx_a', { a: nm(defA), b: nm(defB) })}</span><b class="tnum" id="cs-easy-a">{defEasyA}</b><span id="cs-ctx-b">{T('cmp_ctx_b', { a: nm(defA), b: nm(defB) })}</span><b class="tnum" id="cs-rank-a">#{passportRank[DEFAULT_A]}</b><span id="cs-ctx-c">{T('cmp_ctx_c', { a: nm(defA), b: nm(defB), total: countries.length })}</span><b class="tnum" id="cs-easy-b">{defEasyB}</b><span id="cs-ctx-d">{T('cmp_ctx_d', { a: nm(defA), b: nm(defB) })}</span><b class="tnum" id="cs-rank-b">#{passportRank[DEFAULT_B]}</b><span id="cs-ctx-e">{T('cmp_ctx_e')}</span>
    </p>

    <div id="cmp-sections">
      {
        defDelta.newly.length > 0 && (
          <section class="cmp-sec">
            <h2>{T('cmp_h_newly', { b: nm(defB) })}</h2>
            {defDelta.newly.map((g) => (
              <div class="cmp-group">
                <h3>{g.title}<span class="count-pill">{g.items.length}</span></h3>
                <div class="cmp-rows">
                  {g.items.map((it) => (
                    <a class="cmp-row" href={href(pairPath(defB, it.dest))}>
                      <span class="fl" aria-hidden="true">{flagEmoji(it.dest.code)}</span>
                      <span class="cmp-name">{nm(it.dest)}</span>
                      <span class="cmp-trans"><span class={`sdot ${it.b}`} aria-hidden="true"></span>{transText(it)}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )
      }
      {
        defDelta.easier.length > 0 && (
          <section class="cmp-sec">
            <h2>{T('cmp_h_easier', { b: nm(defB) })}</h2>
            {defDelta.easier.map((g) => (
              <div class="cmp-group">
                <h3>{g.title}<span class="count-pill">{g.items.length}</span></h3>
                <div class="cmp-rows">
                  {g.items.map((it) => (
                    <a class="cmp-row" href={href(pairPath(defB, it.dest))}>
                      <span class="fl" aria-hidden="true">{flagEmoji(it.dest.code)}</span>
                      <span class="cmp-name">{nm(it.dest)}</span>
                      <span class="cmp-trans"><span class={`sdot ${it.b}`} aria-hidden="true"></span>{transText(it)}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )
      }
      {
        defDelta.worse.length > 0 && (
          <section class="cmp-sec">
            <h2>{T('cmp_h_worse', { b: nm(defB) })}</h2>
            {defDelta.worse.map((g) => (
              <div class="cmp-group">
                <h3>{g.title}<span class="count-pill">{g.items.length}</span></h3>
                <div class="cmp-rows">
                  {g.items.map((it) => (
                    <a class="cmp-row" href={href(pairPath(defB, it.dest))}>
                      <span class="fl" aria-hidden="true">{flagEmoji(it.dest.code)}</span>
                      <span class="cmp-name">{nm(it.dest)}</span>
                      <span class="cmp-trans"><span class={`sdot ${it.b}`} aria-hidden="true"></span>{transText(it)}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )
      }
    </div>
    <p class="cmp-empty" id="cmp-empty" hidden>
      {T('cmp_empty_text')}
    </p>
    <p class="cmp-method">
      {T('cmp_method_a', { common: defDelta.common })}<a href={href('/passport-ranking/')}>{T('cmp_method_link')}</a>{T('cmp_method_b')}
    </p>
  </div>

  <script is:inline define:vars={{ payload, defaultA: DEFAULT_A, defaultB: DEFAULT_B }}>
    (function () {
      var M = payload;
      /* P0 (2026-11-14): row links prefer the localized pair page when
         the route is launched for this locale (wave-A set), else the
         English pair page — same availability manifest the language
         switcher consults. Re-renders once the manifest arrives so
         first-paint rows upgrade in place. */
      var AVAIL = null;
      var availReady = fetch('/i18n-availability.json')
        .then(function (r) { return r.json(); })
        .then(function (j) { AVAIL = j; })
        .catch(function () {});
      function pairHref(pslug, dslug) {
        var en = '/visa/' + pslug + '/' + dslug + '/';
        if (M.locale === 'en' || !AVAIL) return en;
        var locs = AVAIL[en];
        return locs && locs.indexOf(M.locale) >= 0 ? '/' + M.locale + en : en;
      }
      availReady.then(function () { try { render(); } catch (e) {} });
      var RANK = { F: 5, A: 4, T: 3, E: 2, R: 1, N: 0 };
      var EASY = { F: 1, A: 1, T: 1 };
      var pos = {};
      M.codes.forEach(function (c, i) { pos[c] = i; });
      var byName = {};
      var bySlug = {};
      M.codes.forEach(function (c) {
        byName[M.names[c].toLowerCase()] = c;
        bySlug[M.slugs[c]] = c;
      });
      var ALL = M.codes.map(function (c) { return { code: c, name: M.names[c], slug: M.slugs[c], a: M.aka[c] || '' }; });
      function normQ(s) {
        return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7a3\u0e00-\u0e7f]/g, '');
      }
      function akaHit(a, qn, prefix) {
        if (!a || !qn) return false;
        var ts = a.split('|');
        for (var k = 0; k < ts.length; k++) {
          var ix = ts[k].indexOf(qn);
          if (prefix ? ix === 0 : ix >= 0) return true;
        }
        return false;
      }

      function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
      function fill(tpl, vars) {
        return String(tpl).replace(/\{(\w+)\}/g, function (_, k) { return vars[k] != null ? vars[k] : ''; });
      }
      function flagEmoji(code) {
        if (!/^[A-Za-z]{2}$/.test(code || '')) return '';
        try {
          return String.fromCodePoint.apply(null, code.toUpperCase().split('').map(function (c) { return 127397 + c.charCodeAt(0); }));
        } catch (e) { return ''; }
      }
      function daysOf(row, i) {
        var ch = row[i];
        return ch === '·' ? null : M.daysTable[M.alpha.indexOf(ch)];
      }

      /* ---------- delta computation (mirrors the build-time compare) ---------- */
      function compare(aCode, bCode) {
        var rowA = M.rows[aCode], rowB = M.rows[bCode];
        var dayA = M.daysRows[aCode], dayB = M.daysRows[bCode];
        var newly = { F: [], A: [], T: [] };
        var easierBy = {}, worseBy = {};
        var stayUp = [], stayDown = [];
        var common = 0;
        M.codes.forEach(function (dc, i) {
          if (dc === aCode || dc === bCode) return;
          common++;
          var sa = rowA[i], sb = rowB[i];
          var it = { code: dc, a: sa, b: sb, aDays: daysOf(dayA, i), bDays: daysOf(dayB, i), gain: RANK[sb] - RANK[sa] };
          if (RANK[sb] > RANK[sa]) {
            if (EASY[sb] && !EASY[sa]) newly[sb].push(it);
            else { var k1 = sa + '>' + sb; (easierBy[k1] = easierBy[k1] || []).push(it); }
          } else if (RANK[sb] < RANK[sa]) {
            var k2 = sa + '>' + sb; (worseBy[k2] = worseBy[k2] || []).push(it);
          } else if ((sa === 'F' || sa === 'A') && it.aDays != null && it.bDays != null && it.bDays !== it.aDays) {
            (it.bDays > it.aDays ? stayUp : stayDown).push(it);
          }
        });
        function byNameSort(x, y) { return M.names[x.code] < M.names[y.code] ? -1 : 1; }
        var newlyGroups = ['F', 'A', 'T'].filter(function (s) { return newly[s].length; }).map(function (s) {
          return { title: M.short[s], items: newly[s].sort(byNameSort), gain: 0 };
        });
        function transGroups(map, sign) {
          return Object.keys(map).map(function (k) {
            var parts = k.split('>');
            return {
              title: M.short[parts[0]] + ' → ' + M.short[parts[1]],
              items: map[k].sort(byNameSort),
              gain: (RANK[parts[1]] - RANK[parts[0]]) * sign,
              lostEasy: !!EASY[parts[0]] && !EASY[parts[1]],
            };
          }).sort(function (g1, g2) { return g2.gain - g1.gain || g2.items.length - g1.items.length; });
        }
        var easierGroups = transGroups(easierBy, 1);
        if (stayUp.length) easierGroups.push({ title: M.str.stayUp, items: stayUp.sort(byNameSort), gain: 0 });
        var worseGroups = transGroups(worseBy, -1).sort(function (g1, g2) {
          return (g2.lostEasy ? 1 : 0) - (g1.lostEasy ? 1 : 0) || g2.gain - g1.gain || g2.items.length - g1.items.length;
        });
        if (stayDown.length) worseGroups.push({ title: M.str.stayDown, items: stayDown.sort(byNameSort), gain: 0 });
        var nNew = newlyGroups.reduce(function (n, g) { return n + g.items.length; }, 0);
        var nEasier = nNew + easierGroups.reduce(function (n, g) { return n + g.items.length; }, 0);
        var nWorse = worseGroups.reduce(function (n, g) { return n + g.items.length; }, 0);
        return { newly: newlyGroups, easier: easierGroups, worse: worseGroups, nNew: nNew, nEasier: nEasier, nWorse: nWorse, common: common };
      }

      function transText(it) {
        if (it.a === it.b) return M.short[it.b] + ' · ' + fill(M.str.stayTrans, { a: it.aDays, b: it.bDays });
        var t = M.short[it.a] + ' → ' + M.short[it.b];
        if (it.b === 'F' && it.bDays != null) t += fill(M.str.dotDays, { days: it.bDays });
        if (it.b === 'A' && it.bDays != null) t += fill(M.str.upTo, { days: it.bDays });
        return t;
      }
      function rowHtml(it, bCode) {
        return '<a class="cmp-row" href="' + pairHref(M.slugs[bCode], M.slugs[it.code]) + '">'
          + '<span class="fl" aria-hidden="true">' + flagEmoji(it.code) + '</span>'
          + '<span class="cmp-name">' + esc(M.names[it.code]) + '</span>'
          + '<span class="cmp-trans"><span class="sdot ' + it.b + '" aria-hidden="true"></span>' + esc(transText(it)) + '</span></a>';
      }
      function sectionHtml(heading, groups, bCode) {
        if (!groups.length) return '';
        var h = '<section class="cmp-sec"><h2>' + esc(heading) + '</h2>';
        groups.forEach(function (g) {
          h += '<div class="cmp-group"><h3>' + esc(g.title) + '<span class="count-pill">' + g.items.length + '</span></h3><div class="cmp-rows">';
          g.items.forEach(function (it) { h += rowHtml(it, bCode); });
          h += '</div></div>';
        });
        return h + '</section>';
      }

      /* ---------- state + rendering ---------- */
      var state = { a: defaultA, b: defaultB };
      var sectionsEl = document.getElementById('cmp-sections');
      var emptyEl = document.getElementById('cmp-empty');

      function render() {
        var a = state.a, b = state.b;
        document.getElementById('cs-a-name').textContent = fill(M.str.nameTpl, { name: M.names[a] });
        document.getElementById('cs-b-name').textContent = fill(M.str.nameTpl, { name: M.names[b] });
        document.getElementById('cs-easy-a').textContent = M.easy[a];
        document.getElementById('cs-easy-b').textContent = M.easy[b];
        document.getElementById('cs-rank-a').textContent = '#' + M.ranks[a];
        document.getElementById('cs-rank-b').textContent = '#' + M.ranks[b];
        document.getElementById('cs-ctx-a').textContent = fill(M.str.ctxA, { a: M.names[a] });
        document.getElementById('cs-ctx-b').textContent = M.str.ctxB;
        document.getElementById('cs-ctx-c').textContent = fill(M.str.ctxC, { b: M.names[b], total: M.total });
        document.getElementById('cs-ctx-d').textContent = M.str.ctxD;
        document.getElementById('cs-ctx-e').textContent = M.str.ctxE;
        document.getElementById('cmp-results').classList.toggle('is-same', a === b);
        if (a === b) {
          document.getElementById('cs-common').textContent = '0';
          document.getElementById('cs-new').textContent = '0';
          document.getElementById('cs-easier').textContent = '0';
          document.getElementById('cs-worse').textContent = '0';
          sectionsEl.innerHTML = '';
          emptyEl.hidden = false;
          return;
        }
        emptyEl.hidden = true;
        var d = compare(a, b);
        document.getElementById('cs-common').textContent = d.common;
        document.getElementById('cs-new').textContent = d.nNew;
        document.getElementById('cs-easier').textContent = d.nEasier;
        document.getElementById('cs-worse').textContent = d.nWorse;
        sectionsEl.innerHTML =
          sectionHtml(fill(M.str.hNewly, { b: M.names[b] }), d.newly, b)
          + sectionHtml(fill(M.str.hEasier, { b: M.names[b] }), d.easier, b)
          + sectionHtml(fill(M.str.hWorse, { b: M.names[b] }), d.worse, b);
        try { localStorage.setItem('vf_cmp', a + ':' + b); } catch (e) {}
        try {
          var url = new URL(location.href);
          url.searchParams.set('a', M.slugs[a]);
          url.searchParams.set('b', M.slugs[b]);
          history.replaceState(null, '', url);
        } catch (e) {}
      }

      /* ---------- comboboxes (same pattern as the route checker / map) ---------- */
      function makeCombo(prefix, get, set) {
        var input = document.getElementById('cmp-' + prefix);
        var list = document.getElementById('cmp-list-' + prefix);
        var flagEl = document.getElementById('cmp-flag-' + prefix);
        var wrap = document.getElementById('cmp-wrap-' + prefix);
        var clearBtn = document.getElementById('cmp-clear-' + prefix);
        var active = -1;
        var currentList = [];
        /* Selector-fix (2026-11-14): on open, select the shown name so typing
           replaces it; the × clears the text and opens the full list without
           changing the compared passport until a new one is chosen. */
        function syncClear() { wrap.classList.toggle('ck-has-text', input.value.length > 0); }
        function maybeSelectAll() {
          if (input.value !== M.names[get()]) return;
          try { input.select(); } catch (e) {}
          try { input.setSelectionRange(0, input.value.length); } catch (e) {}
          // WebKit applies the tap caret after the focus/click handlers run,
          // wiping the selection — re-apply once the gesture task has settled.
          setTimeout(function () {
            if (document.activeElement === input && input.value === M.names[get()]
                && (input.selectionStart !== 0 || input.selectionEnd !== input.value.length)) {
              try { input.select(); } catch (e) {}
              try { input.setSelectionRange(0, input.value.length); } catch (e) {}
            }
          }, 0);
        }
        function doClear() {
          input.value = '';
          flagEl.textContent = '';
          input.classList.remove('has-flag');
          renderList();
          syncClear();
          input.focus();
        }
        clearBtn.addEventListener('pointerdown', function (ev) { ev.preventDefault(); doClear(); });
        clearBtn.addEventListener('click', function (ev) { ev.preventDefault(); if (input.value) doClear(); });
        function close() {
          wrap.classList.remove('open');
          input.setAttribute('aria-expanded', 'false');
          input.removeAttribute('aria-activedescendant');
          active = -1;
          // Free text that was never chosen snaps back to the current selection.
          if (input.value !== M.names[get()]) input.value = M.names[get()];
          syncClear();
        }
        function renderList() {
          var q = input.value.trim().toLowerCase();
          // An untouched selected name is a label, not a query: show the full list.
          if (q === M.names[get()].toLowerCase()) q = '';
          var starts = [], contains = [];
          var qn = normQ(q);
          for (var i = 0; i < ALL.length; i++) {
            var n = ALL[i].name.toLowerCase();
            if (n.indexOf(q) === 0 || akaHit(ALL[i].a, qn, true)) starts.push(ALL[i]);
            else if (q && (n.indexOf(q) >= 0 || akaHit(ALL[i].a, qn, false))) contains.push(ALL[i]);
          }
          currentList = q ? starts.concat(contains) : ALL;
          if (!currentList.length) {
            list.innerHTML = '<li class="ck-empty">' + M.str.empty + '</li>';
          } else {
            list.innerHTML = currentList.map(function (c, i) {
              return '<li class="ck-option" role="option" id="cmp-list-' + prefix + '-o' + i + '" data-name="' + esc(c.name) + '" aria-selected="false">'
                + '<span class="fl">' + flagEmoji(c.code) + '</span>' + esc(c.name)
                + '<span class="cd">' + esc(c.code) + '</span></li>';
            }).join('');
          }
          wrap.classList.add('open');
          input.setAttribute('aria-expanded', 'true');
          active = -1;
        }
        function setActive(i) {
          var opts = list.querySelectorAll('.ck-option');
          opts.forEach(function (o, j) { o.classList.toggle('active', j === i); });
          active = i;
          if (i >= 0 && opts[i]) { input.setAttribute('aria-activedescendant', opts[i].id); opts[i].scrollIntoView({ block: 'nearest' }); }
          else input.removeAttribute('aria-activedescendant');
        }
        function choose(c) {
          set(c.code);
          input.value = c.name;
          var f = flagEmoji(c.code);
          flagEl.textContent = f;
          input.classList.toggle('has-flag', !!f);
          close();
          render();
        }
        input.addEventListener('input', function () { flagEl.textContent = ''; input.classList.remove('has-flag'); renderList(); syncClear(); });
        input.addEventListener('focus', function () { combos.forEach(function (cb) { if (cb !== api) cb.close(); }); renderList(); maybeSelectAll(); });
        // Choosing an option leaves focus in the field with the list closed;
        // a fresh tap on the still-focused field must reopen it (no new focus event fires).
        input.addEventListener('click', function () { if (!wrap.classList.contains('open')) { renderList(); maybeSelectAll(); } });
        /* BUG-001 hold: a touch-scroll of the list must never let the blur timer close it mid-gesture. */
        var holdUntil = 0;
        function hold() { holdUntil = Date.now() + 800; }
        list.addEventListener('pointerdown', hold);
        list.addEventListener('touchstart', hold, { passive: true });
        list.addEventListener('scroll', hold, { passive: true });
        input.addEventListener('blur', function () {
          setTimeout(function deferClose() {
            if (Date.now() < holdUntil) setTimeout(deferClose, 400);
            else close();
          }, 120);
        });
        input.addEventListener('keydown', function (ev) {
          if (ev.key === 'ArrowDown') { ev.preventDefault(); if (!wrap.classList.contains('open')) renderList(); setActive(Math.min(active + 1, currentList.length - 1)); }
          else if (ev.key === 'ArrowUp') { ev.preventDefault(); setActive(Math.max(active - 1, 0)); }
          else if (ev.key === 'Enter' && wrap.classList.contains('open') && active >= 0 && currentList[active]) { ev.preventDefault(); choose(currentList[active]); }
          else if (ev.key === 'Escape') { close(); }
        });
        list.addEventListener('mousedown', function (ev) {
          var li = ev.target.closest ? ev.target.closest('.ck-option') : null;
          if (!li) return;
          ev.preventDefault();
          var code = byName[li.getAttribute('data-name').toLowerCase()];
          if (code) choose({ code: code, name: M.names[code], slug: M.slugs[code] });
        });
        syncClear();
        var api = { close: close, choose: choose, input: input, flagEl: flagEl, sync: syncClear };
        return api;
      }
      var combos = [];
      var comboA = makeCombo('a', function () { return state.a; }, function (code) { state.a = code; });
      var comboB = makeCombo('b', function () { return state.b; }, function (code) { state.b = code; });
      combos.push(comboA, comboB);

      var swapBtn = document.getElementById('cmp-swap');
      swapBtn.addEventListener('click', function () {
        var t = state.a; state.a = state.b; state.b = t;
        [comboA, comboB].forEach(function (cb, i) {
          var code = i === 0 ? state.a : state.b;
          cb.input.value = M.names[code];
          cb.flagEl.textContent = flagEmoji(code);
          cb.input.classList.add('has-flag');
          cb.close();
        });
        swapBtn.classList.toggle('flip');
        render();
      });

      /* ---------- initial selection: ?a=&b= win, then the last-used pair ---------- */
      var initA = null, initB = null;
      try {
        var sp = new URL(location.href).searchParams;
        if (sp.get('a') && bySlug[sp.get('a')]) initA = bySlug[sp.get('a')];
        if (sp.get('b') && bySlug[sp.get('b')]) initB = bySlug[sp.get('b')];
      } catch (e) {}
      if (!initA && !initB) {
        try {
          var saved = (localStorage.getItem('vf_cmp') || '').split(':');
          if (saved.length === 2 && M.rows[saved[0]] && M.rows[saved[1]]) { initA = saved[0]; initB = saved[1]; }
        } catch (e) {}
      }
      if ((initA && initA !== state.a) || (initB && initB !== state.b)) {
        if (initA) state.a = initA;
        if (initB) state.b = initB;
        [comboA, comboB].forEach(function (cb, i) {
          var code = i === 0 ? state.a : state.b;
          cb.input.value = M.names[code];
          cb.flagEl.textContent = flagEmoji(code);
        });
        render();
      }
    })();
  </script>

  <style>
    .cmp-card { max-width: 880px; margin-top: 20px; }
    .cmp-checker { align-items: end; }
    .cmp-card .ck-wrap.open { z-index: 80; }
    .cmp-summary { font-size: 16.5px; margin: 22px 0 12px; }
    .cmp-summary b { font-weight: 800; }
    .cmp-stats { display: flex; flex-wrap: wrap; gap: 10px; }
    .cmp-context { font-size: 14.5px; color: var(--ink-2); margin: 12px 0 4px; }
    #cmp-results.is-same .cmp-summary,
    #cmp-results.is-same .cmp-stats,
    #cmp-results.is-same .cmp-context { display: none; }
    .cmp-empty {
      margin-top: 22px; padding: 16px 18px; border: 1px dashed var(--line-strong);
      border-radius: 14px; font-size: 15px; color: var(--ink-2); background: var(--soft);
    }
    .cmp-method { font-size: 13.5px; color: var(--muted); margin-top: 26px; max-width: 760px; }
    .cmp-more { margin-top: 30px; font-size: 15px; }
  </style>

  <style is:global>
    /* BUG-004: #cmp-sections is rebuilt by client JS (innerHTML), so the
       rows it contains can never carry Astro's scoped-style hash. Their
       rules live in this global block, anchored under #cmp-sections so
       they cannot leak to other pages, and they style the server-rendered
       first paint and every JS re-render identically. */
    #cmp-sections .cmp-sec { margin-top: 30px; }
    #cmp-sections .cmp-group { margin-top: 18px; }
    #cmp-sections .cmp-group h3 { display: flex; align-items: center; margin: 0 0 8px; }
    #cmp-sections .cmp-rows {
      background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
    }
    #cmp-sections .cmp-row {
      display: flex; align-items: center; gap: 10px; min-height: 44px; flex-wrap: wrap;
      padding: 7px 14px; color: var(--ink); text-decoration: none; font-size: 15px;
    }
    #cmp-sections .cmp-row + .cmp-row { border-top: 1px solid var(--line); }
    #cmp-sections .cmp-row:hover { background: var(--soft); }
    #cmp-sections .cmp-row .fl { font-size: 17px; width: 24px; text-align: center; flex: none; }
    #cmp-sections .cmp-name { font-weight: 600; flex: 1 1 auto; min-width: 0; overflow-wrap: break-word; }
    #cmp-sections .cmp-trans {
      display: inline-flex; align-items: center; gap: 7px; flex: none; margin-left: auto;
      font-size: 13.5px; font-weight: 600; color: var(--ink-2); text-align: right;
    }
    @media (max-width: 720px) {
      #cmp-sections .cmp-trans { font-size: 12.5px; }
    }
    @media (max-width: 560px) {
      /* Uniform two-line row on narrow screens: the transition note takes
         its own line, indented 34px (flag 24px + gap 10px) so it aligns
         under the country name — never a ragged half-line. */
      #cmp-sections .cmp-trans {
        flex: 1 1 100%; margin-left: 0; padding-left: 34px; text-align: left;
      }
    }
  </style>
  <ExploreStrip locale={locale} items={[{ key: 'feat_map', href: href('/map/') }, { key: 'feat_ranking', href: href('/passport-ranking/') }, { key: 'explore_check', href: href('/#checker') }]} />
