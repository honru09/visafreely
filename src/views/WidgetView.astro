---
// Widget landing page (QA-003: locale-parameterized; was English-only).
// The snippet and the live demo point at the reader's own locale embed, so
// a localized blog embeds a checker that speaks its language.
import Base from '../layouts/Base.astro';
import ExploreStrip from '../components/ExploreStrip.astro';
import { t as i18nT, hrefFor, localeByCode, countryName, type LocaleCode } from '../i18n/locales';
import { countries } from '../lib/data';
import availabilityRaw from '../i18n/availability.json';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);
const selfDef = localeByCode[locale];
const prefix = selfDef.prefix ? `/${selfDef.prefix}` : '';

// One-step embed (EMBED-KIT 2026-11-14): preset selects drive both the
// live demo iframe and the snippet, so what the reader tests is exactly
// what they copy. Defaults match the long-standing demo route JP -> TH.
const presetCountries = [...countries].sort((a, b) =>
  countryName(locale, a).localeCompare(countryName(locale, b), locale));
const snippetFor = (p: string, d: string) =>
  `<iframe src="https://visafreely.com${prefix}/embed/?p=${p}&d=${d}" title="${T('wg_snippet_title')}" width="100%" height="430" style="border:0;width:100%;max-width:560px" loading="lazy"></iframe>`;
const snippet = snippetFor('JP', 'TH');
const copyStr = { copy: T('wg_copy'), copied: T('wg_copied') };
const presetCfg = {
  base: `https://visafreely.com${prefix}/embed/`,
  demoBase: `${prefix}/embed/`,
  title: T('wg_snippet_title'),
};
// SEO L10 breadcrumb (2026-11-14).
const absUrl = (p: string) => new URL(href(p), Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T('l10_crumb_home'), item: absUrl('/') },
    { '@type': 'ListItem', position: 2, name: T('wg_h1'), item: absUrl('/widget/') },
  ],
};
---

<Base title={T('wg_title')} description={T('wg_desc')} locale={locale}>
  <h1>{T('wg_h1')}</h1>
  <p class="lede">
    {T('wg_lede')}
  </p>

  <h2>{T('wg_try_h2')}</h2>
  <p>{T('wg_try_p')}</p>
  <div class="preset-row">
    <label>
      <span>{T('wg_preset_p')}</span>
      <select id="wg-preset-p">
        {presetCountries.map((c) => <option value={c.code} selected={c.code === 'JP'}>{countryName(locale, c)}</option>)}
      </select>
    </label>
    <label>
      <span>{T('wg_preset_d')}</span>
      <select id="wg-preset-d">
        {presetCountries.map((c) => <option value={c.code} selected={c.code === 'TH'}>{countryName(locale, c)}</option>)}
      </select>
    </label>
  </div>
  <p class="small muted">{T('wg_preset_hint')}</p>
  <iframe
    class="widget-demo"
    id="widget-demo"
    src={`${prefix}/embed/?p=JP&d=TH`}
    title={T('wg_iframe_title')}
    loading="lazy"></iframe>

  <h2>{T('wg_add_h2')}</h2>
  <p>
    {T('wg_add_p')}
  </p>
  <div class="snippet-box">
    <textarea id="widget-snippet" readonly rows="4" spellcheck="false">{snippet}</textarea>
    <button type="button" class="copy-btn" id="widget-copy">{T('wg_copy')}</button>
  </div>
  <p class="small muted">
    {T('wg_note')}
  </p>

  <h2>{T('wg_shots_h2')}</h2>
  <img
    class="wg-shot"
    src="/images/widget-article-desktop.png"
    width="1280"
    height="1000"
    loading="lazy"
    alt={T('wg_shots_h2')} />
  <img
    class="wg-shot wg-shot-mobile"
    src="/images/widget-article-mobile.png"
    width="390"
    height="844"
    loading="lazy"
    alt={T('wg_shots_h2')} />
  <p class="small muted">{T('wg_shots_cap')}</p>

  <h2>{T('wg_good_h2')}</h2>
  <div class="card">
    <ul style="margin:0; padding-left:20px;">
      <li>
        <strong>{T('wg_li1_strong')}</strong>{T('wg_li1')}
      </li>
      <li>
        <strong>{T('wg_li2_strong')}</strong>{T('wg_li2')}
      </li>
      <li>
        <strong>{T('wg_li3_strong')}</strong>{T('wg_li3_a')}<code>?p=JP&amp;d=TH</code>{T('wg_li3_b')}
      </li>
      <li>
        <strong>{T('wg_li4_strong')}</strong>{T('wg_li4')}
      </li>
    </ul>
  </div>
  <p>
    {T('wg_q_a')} <a href={href('/about/')}>{T('wg_q_link')}</a>{T('wg_q_b')}
  </p>

  <h2>{T('wg_attr_h2')}</h2>
  <p>{T('wg_attr_p')}</p>

  <h2>{T('wg_data_h2')}</h2>
  <p>
    {T('wg_data_p_a')}<a href={href('/policy-changes/')}>{T('wg_data_tracker')}</a>{T('wg_data_p_b')}
  </p>

  <h2>{T('wg_fit_h2')}</h2>
  <p>{T('wg_fit_p')}</p>

  <h2>{T('wg_contact_h2')}</h2>
  <p>
    {T('wg_contact_a')}<a href="mailto:partners@visafreely.com">partners@visafreely.com</a>{T('wg_contact_b')}
  </p>
  <p>{T('wg_remove_p')}</p>

  <style>
    .widget-demo {
      border: 0;
      width: 100%;
      max-width: 560px;
      height: 430px;
      display: block;
      background: transparent;
    }
    .snippet-box {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      flex-wrap: wrap;
      margin: 12px 0 6px;
    }
    .snippet-box textarea {
      flex: 1 1 420px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 13px;
      line-height: 1.55;
      color: var(--ink);
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px 14px;
      resize: vertical;
    }
    .copy-btn {
      background: var(--brand);
      color: #fff;
      font: inherit;
      font-weight: 700;
      font-size: 14.5px;
      padding: 10px 18px;
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      white-space: nowrap;
    }
    .copy-btn:hover { background: var(--brand-deep); }
    .preset-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin: 10px 0 4px;
    }
    .preset-row label {
      display: flex;
      flex-direction: column;
      gap: 5px;
      font-size: 13px;
      font-weight: 600;
      color: var(--muted, #5b6472);
    }
    .preset-row select {
      font: inherit;
      font-size: 15px;
      font-weight: 400;
      color: var(--ink);
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 8px 10px;
      min-width: 180px;
    }
    .wg-shot {
      width: 100%;
      height: auto;
      border: 1px solid var(--line);
      border-radius: 12px;
      display: block;
      margin: 12px 0;
    }
    .wg-shot-mobile { max-width: 320px; }
  </style>
  <script is:inline define:vars={{ copyStr, presetCfg }}>
    (function () {
      var btn = document.getElementById('widget-copy');
      var box = document.getElementById('widget-snippet');
      var demo = document.getElementById('widget-demo');
      var selP = document.getElementById('wg-preset-p');
      var selD = document.getElementById('wg-preset-d');
      function applyPreset() {
        if (!selP || !selD) return;
        var q = '?p=' + encodeURIComponent(selP.value) + '&d=' + encodeURIComponent(selD.value);
        if (demo) demo.src = presetCfg.demoBase + q;
        if (box) {
          box.value =
            '<iframe src="' + presetCfg.base + q + '" title="' + presetCfg.title +
            '" width="100%" height="430" style="border:0;width:100%;max-width:560px" loading="lazy"></iframe>';
        }
      }
      if (selP) selP.addEventListener('change', applyPreset);
      if (selD) selD.addEventListener('change', applyPreset);
      if (!btn || !box) return;
      btn.addEventListener('click', function () {
        function done() {
          btn.textContent = copyStr.copied;
          setTimeout(function () { btn.textContent = copyStr.copy; }, 2000);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(box.value).then(done, function () {
            box.select();
            document.execCommand('copy');
            done();
          });
        } else {
          box.select();
          document.execCommand('copy');
          done();
        }
      });
    })();
  </script>
  <ExploreStrip locale={locale} items={[{ key: 'explore_check', href: href('/#checker') }, { key: 'feat_map', href: href('/map/') }, { key: 'feat_compare', href: href('/compare/') }]} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>
