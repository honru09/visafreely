---
// Residency route page (batch 1, 2026-11-14; redo 2026-11-15) — PLAN
// section 1 template in the redo grammar: a verdict hero (reader lede
// + two fact tiles) leads, the decision figures follow as a tile grid
// (short value up front, full official wording as the tile's small
// print), government fees are itemised rows split from the verified
// fee text, and the basis/sources section carries the legal basis and
// the neutral sourcing note. Every figure still renders from
// src/data/residency-routes.json at build time; closed programmes keep
// the archive presentation (no decision figures, unmistakable box).
import Base from '../layouts/Base.astro';
import {
  countryByCode,
  easyAccessCount,
  flagEmoji,
  formatDateLong,
} from '../lib/data';
import {
  familyTotalText,
  feeGroups,
  fmtMoney,
  heroTiles,
  minThreshold,
  NOT_PUBLISHED,
  openRoutes,
  relatedRoutes,
  residencyDisclaimer,
  routePath,
  RESIDENCY_VERIFIED_DATE,
  type ResidencyRoute,
} from '../lib/residency';

interface Props {
  route: ResidencyRoute;
}
const { route: r } = Astro.props;
const c = countryByCode[r.code];
const easy = easyAccessCount(r.code);
const totalDestinations = Object.keys(countryByCode).length - 1;
const verifiedLong = formatDateLong(RESIDENCY_VERIFIED_DATE);
const closed = r.status === 'closed';
const min = minThreshold(r);
const typeLabel =
  r.type === 'cbi' ? 'Citizenship by investment' : 'Residence by investment';
const title = closed
  ? `${r.country} — ${r.programme} | VisaFreely`
  : `${r.country} ${typeLabel} — from ${min != null ? fmtMoney(min, r.currency) : ''} | VisaFreely`;
const description = closed
  ? r.status_date
    ? `The ${r.country} investor programme closed on ${formatDateLong(r.status_date)}. What the law says, the historical thresholds, and the transitional rules — from the official gazette.`
    : `The ${r.country} investor citizenship programme has closed. What the law says, and what replaced it — from official sources.`
  : `${r.country} ${r.programme}: minimum investment, government fees, family-of-4 total, processing time and rules — every figure checked against official sources on ${verifiedLong}.`;
const tiles = closed ? [] : heroTiles(r);
const fees = closed ? [] : feeGroups(r);
const related = closed ? openRoutes : relatedRoutes(r);
const relTypeLabel = (x: ResidencyRoute) =>
  x.type === 'cbi' ? 'Citizenship by investment' : 'Residence by investment';
/* Decision tiles: short reader value first, the full official wording
   as small print. Unpublished fields say so; years-to-PR on a direct
   citizenship route is not applicable, never a gap. */
const decisionTiles: { label: string; value: string; note?: string }[] = closed
  ? []
  : [
      {
        label: 'Processing time (official)',
        value: r.shorts?.processing ?? NOT_PUBLISHED,
        note: r.processing_note ?? r.processing_time ?? undefined,
      },
      {
        label: 'Residence requirement',
        value: r.shorts?.residence ?? NOT_PUBLISHED,
        note: r.residence_requirement ?? undefined,
      },
      {
        label: 'Years to permanent residence',
        value:
          r.time_to_pr != null
            ? (r.shorts?.pr ?? NOT_PUBLISHED)
            : r.type === 'cbi'
              ? 'Not applicable'
              : NOT_PUBLISHED,
        note:
          r.time_to_pr ??
          (r.type === 'cbi'
            ? 'Citizenship is granted directly — there is no PR stage'
            : undefined),
      },
      {
        label: 'Years to citizenship',
        value: r.shorts?.citizenship ?? NOT_PUBLISHED,
        note: r.time_to_citizenship ?? undefined,
      },
      {
        label: 'Dual citizenship',
        value: r.shorts?.dual ?? NOT_PUBLISHED,
        note: r.dual_citizenship ?? undefined,
      },
      {
        label: 'Destinations, no advance application',
        value: String(easy),
        note: `Visa-free, visa on arrival or an electronic authorisation, of ${totalDestinations} in our index`,
      },
    ];
const absUrl = (p: string) => new URL(p, Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Residency & citizenship', item: absUrl('/residency/') },
    { '@type': 'ListItem', position: 3, name: r.country, item: absUrl(`/residency/${c.slug}/`) },
    { '@type': 'ListItem', position: 4, name: r.programme, item: absUrl(routePath(r)) },
  ],
};
const hostOf = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
---

<Base title={title} description={description} locale="en">
  <section class="band light">
    <div class="band-in">
      <div class="crumbs">
        <a href="/residency/">Residency &amp; citizenship</a> /
        <a href={`/residency/${c.slug}/`}>{r.country}</a>
      </div>
      <h1>
        <span aria-hidden="true">{flagEmoji(r.code)}</span>
        {r.country} — {r.programme}
      </h1>
      <p class="res-badges">
        {
          closed ? (
            <span class="res-badge closed">
              Closed{r.status_date ? ` — ${formatDateLong(r.status_date)}` : ''}
            </span>
          ) : (
            <span class="res-badge open">Open</span>
          )
        }
        <span class="res-stamp">Data verified {verifiedLong} · Official sources</span>
      </p>
      {closed && r.legal_basis && <p class="muted">Legal basis: {r.legal_basis}</p>}
      {!closed && r.lede && <p class="res-lede">{r.lede}</p>}
    </div>
  </section>

  <div class="band-in res-body">
    {
      closed ? (
        <>
          <div class="res-closed-box">
            <h2>This programme is closed</h2>
            <p>
              {r.status_date ? (
                <>
                  No new applications have been possible since{' '}
                  {formatDateLong(r.status_date)}. This page is kept as an
                  archive because out-of-date sources still present the programme
                  as available.
                </>
              ) : (
                <>
                  This programme has closed and no longer accepts applications.
                  This page is kept as an archive because out-of-date sources
                  still present the programme as available.
                </>
              )}
            </p>
          </div>
          {r.status_note && <p class="res-note">{r.status_note}</p>}
          {r.historical_thresholds && (
            <>
              <h2>Historical thresholds — no longer available</h2>
              <p>{r.historical_thresholds}</p>
            </>
          )}
          {r.status_date && r.residence_requirement && (
            <>
              <h2>Existing holders</h2>
              <p>{r.residence_requirement}</p>
            </>
          )}
        </>
      ) : (
        <>
          <div class="res-hero-tiles">
            {tiles.map((t) => (
              <div class="fact-tile">
                <span class="fl">{t.label}</span>
                <span class="fv">{t.value}</span>
                {t.sub && <span class="fs">{t.sub}</span>}
              </div>
            ))}
          </div>

          <h2>The decision figures</h2>
          <div class="spec-grid">
            {decisionTiles.map((t) => (
              <div class="spec-tile">
                <span class="fl">{t.label}</span>
                <span class="fv">{t.value}</span>
                {t.note && t.note !== t.value && <span class="fs">{t.note}</span>}
              </div>
            ))}
          </div>

          <h2>Government fees</h2>
          {fees.length > 0 ? (
            <div class="fee-card">
              {fees.map((g) => (
                <>
                  {g.group && <p class="fee-group">{g.group}</p>}
                  {g.items.map((item) => (
                    <div class="fee-row">
                      <span class="fee-main">
                        <span class="fee-label">{item.label}</span>
                        {item.sub && <span class="fee-sub">{item.sub}</span>}
                      </span>
                      {item.amount && <span class="fee-amt">{item.amount}</span>}
                    </div>
                  ))}
                </>
              ))}
            </div>
          ) : (
            <p>{r.gov_fees ?? NOT_PUBLISHED}</p>
          )}
          {r.family_total_basis && (
            <p class="res-note-card">
              How the family-of-4 total is built: {r.family_total_basis}. It
              covers the investment plus official government fees only — agent
              and legal fees are not included.
            </p>
          )}

          <h2>Investment options</h2>
          <div class="fee-card">
            {r.options.map((o) => (
              <div class="fee-row">
                <span class="fee-main">
                  <span class="fee-label">
                    {o.name}
                    {o.basis ? <span class="fee-basis"> — {o.basis}</span> : null}
                  </span>
                  {o.notes && <span class="fee-sub">{o.notes}</span>}
                </span>
                <span class="fee-amt">{o.amount != null ? fmtMoney(o.amount, o.currency) : '—'}</span>
              </div>
            ))}
          </div>

          {r.documents.length > 0 && (
            <>
              <h2>Documents and application channel</h2>
              <ul class="res-docs">
                {r.documents.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </>
          )}

          <h2>Restricted nationalities</h2>
          <p class="res-note-card">{r.restricted_nationalities ?? NOT_PUBLISHED}</p>

          {r.conflicts.length > 0 && (
            <>
              <h2>Where official sources disagree</h2>
              {r.conflicts.map((x) => (
                <p class="res-conflict">{x}</p>
              ))}
            </>
          )}
        </>
      )
    }

    {
      !closed && r.type === 'rbi' ? (
        <>
          <h2>Residence, not a passport</h2>
          <p class="res-note">
            This route grants <strong>residence in {r.country}</strong> — the
            right to live there. It does <strong>not</strong> grant a{' '}
            {r.country} passport, and it is not a shortcut to citizenship beyond
            the naturalisation rules stated above. The figures below describe
            the {r.country} passport itself, which is a separate status.
          </p>
        </>
      ) : null
    }
    <h2>{closed ? `The ${r.country} passport itself` : 'What this passport reaches'}</h2>
    <p>
      Holders of a {r.country} passport can enter <strong>{easy} destinations</strong>
      without applying in advance (visa-free, visa on arrival or an electronic
      authorisation), out of {totalDestinations} destinations
      in our index.
      {
        closed
          ? ' That standing belongs to the passport itself and is unrelated to this closed programme.'
          : ''
      }
    </p>
    <p>
      <a href={`/passport/${c.slug}/`}>See everywhere the {r.country} passport reaches →</a>
      {' · '}
      <a href={`/compare/?a=${c.slug}`}>Compare this passport →</a>
    </p>

    {
      !closed && (
        <>
          <h2>Data sources and basis</h2>
          {r.legal_basis && (
            <p>
              Legal basis: {r.legal_basis}.
            </p>
          )}
          {(r.basis_note ?? r.status_note) && <p>{r.basis_note ?? r.status_note}</p>}
        </>
      )
    }
    <h2>Official sources</h2>
    <ul class="res-sources">
      {
        r.sources.map((s) => (
          <li>
            <a href={s} target="_blank" rel="noopener">
              {hostOf(s)}
            </a>
            <span class="muted small"> — {s}</span>
          </li>
        ))
      }
    </ul>
    <p class="muted small">Every figure on this page was checked against these official sources on {verifiedLong}.</p>

    <h2>{closed ? 'Open programmes' : 'Related routes'}</h2>
    <div class="res-rcards">
      {
        related.map((x) => (
          <a class="rcard" href={routePath(x)}>
            <span class="rc-line1">
              <span class="rc-id">
                <span aria-hidden="true">{flagEmoji(x.code)}</span> {x.country}
              </span>
              <span class="rc-min">
                <span class="rc-min-label">Minimum (single)</span>
                <span class="rc-amt">{fmtMoney(minThreshold(x) ?? 0, x.currency)}</span>
              </span>
            </span>
            <span class="rc-line2">
              <span class="res-badge open">Open</span>
              <span class="rc-prog">{relTypeLabel(x)}</span>
            </span>
            <span class="rc-fam">
              Family of 4 — government total{' '}
              <strong>
                {x.government_total_family4 != null
                  ? familyTotalText(x)
                  : 'not officially published'}
              </strong>
            </span>
          </a>
        ))
      }
    </div>
    <p>
      <a href={`/residency/${c.slug}/`}>All routes for {r.country} →</a>
      {' · '}
      <a href="/residency/">All residency &amp; citizenship routes →</a>
    </p>

    <p class="res-disclaimer">{residencyDisclaimer(verifiedLong)}</p>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>

<style>
  .res-badges { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .res-badge { font-weight: 700; font-size: 13px; padding: 4px 12px; border-radius: 999px; }
  .res-badge.open { background: #eef7f2; color: var(--brand-deep); border: 1px solid #bfe3d0; font-weight: 600; }
  .res-badge.closed { background: #fbe7e7; color: #9c1c1c; border: 1px solid #f0b4b4; font-size: 15px; padding: 6px 14px; }
  .res-stamp { color: var(--muted); font-size: 13px; }
  .res-lede { font-size: 16.5px; line-height: 1.65; max-width: 68ch; margin-top: 14px; }
  .res-body { padding-top: 10px; padding-bottom: 30px; }
  /* KB-11 (2026-11-15): editorial prose layer — 68ch measure, 1.65
     line, hairline chapter rules (first heading exempt); the status
     note joins the same measure (was 75ch). The open badge is quieter
     (brand-green family, lighter weight) and the verified stamp steps
     down a size; the closed badge and the closed box keep their red —
     archive recognition is a hard rule of this vertical. Same prose
     block in all three residency views. */
  .res-body > p { max-width: 68ch; line-height: 1.65; }
  .res-body > h2 { margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--line); }
  .res-body > h2:first-child { margin-top: 10px; padding-top: 0; border-top: none; }
  .res-note { max-width: 68ch; }
  .res-closed-box { border: 2px solid #d64545; background: #fdf1f1; border-radius: 16px; padding: 16px 20px; margin: 14px 0; }
  .res-closed-box h2 { margin-top: 0; color: #9c1c1c; }
  /* Redo (2026-11-15): verdict-hero fact tiles + decision tile grid.
     A tile is label (11.5px uppercase, single line with ellipsis
     fallback) / value (800) / small print carrying the full official
     wording, so no verified text leaves the page. */
  .res-hero-tiles { display: grid; gap: 10px; grid-template-columns: 1fr; margin: 6px 0 4px; }
  @media (min-width: 900px) { .res-hero-tiles { grid-template-columns: 1fr 1fr; } }
  .fact-tile { display: flex; flex-direction: column; gap: 3px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 17px; box-shadow: var(--sh-sm); min-width: 0; }
  .fact-tile .fv { font-size: 26px; }
  .spec-grid { display: grid; gap: 10px; grid-template-columns: 1fr; align-items: start; margin: 10px 0 4px; }
  @media (min-width: 900px) { .spec-grid { grid-template-columns: repeat(3, 1fr); } }
  .spec-tile { display: flex; flex-direction: column; gap: 3px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 13px 15px; min-width: 0; }
  /* Long uppercase labels must ellipsis-clip, never stretch the grid
     track (Greece/UAE hero tiles pushed 390px pages 6px wide before
     this guard). */
  .fact-tile > *, .spec-tile > * { min-width: 0; }
  .fl { font-size: 11.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fv { font-size: 21px; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.25; }
  .fs { font-size: 12.5px; color: var(--muted); line-height: 1.55; }
  /* Redo: government fees + investment options share one row grammar —
     label (+ small print) left, amount right-aligned tabular, hairline
     separators, group headings in small caps. */
  .fee-card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 4px 17px; margin: 10px 0 14px; }
  .fee-group { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 14px 0 0; font-weight: 700; }
  .fee-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .fee-card > .fee-row:last-child, .fee-card > :last-child .fee-row:last-child { border-bottom: none; }
  .fee-main { display: flex; flex-direction: column; gap: 2px; }
  .fee-label { font-size: 15.5px; }
  .fee-basis { color: var(--muted); }
  .fee-sub { font-size: 13px; color: var(--muted); line-height: 1.5; }
  .fee-amt { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .res-note-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 13px 17px; max-width: 85ch; line-height: 1.6; }
  .res-sources li { overflow-wrap: anywhere; }
  .res-docs, .res-sources { max-width: 68ch; }
  /* Redo: documents become a checklist — green tick, hairline rows. */
  .res-docs { list-style: none; padding: 0; margin: 8px 0 14px; }
  .res-docs li { position: relative; padding: 8px 0 8px 27px; border-bottom: 1px solid var(--line); margin: 0; }
  .res-docs li:last-child { border-bottom: none; }
  .res-docs li::before { content: '✓'; position: absolute; left: 3px; color: var(--brand); font-weight: 800; }
  .res-conflict { border-left: 4px solid #e0a800; background: #fdf6e0; padding: 10px 14px; border-radius: 0 12px 12px 0; max-width: 85ch; }
  .res-sources { font-size: 14px; }
  /* Redo: related routes take the hub route-card grammar. */
  .res-rcards { display: grid; gap: 10px; grid-template-columns: 1fr; margin: 10px 0 14px; }
  @media (min-width: 900px) { .res-rcards { grid-template-columns: 1fr 1fr; } }
  .rcard { display: flex; flex-direction: column; gap: 7px; padding: 15px 17px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--sh-sm); color: var(--ink); text-decoration: none; }
  .rc-line1 { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .rc-id { font-size: 17px; font-weight: 800; line-height: 1.3; }
  .rc-min { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; flex-shrink: 0; }
  .rc-min-label { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .rc-amt { font-size: 21px; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 560px) { .rc-amt { font-size: 19px; } }
  .rc-line2 { display: flex; align-items: center; gap: 8px; }
  .rc-line2 .res-badge { font-size: 12px; padding: 3px 10px; }
  .rc-prog { font-size: 14px; color: var(--muted); }
  .rc-fam { font-size: 14px; }
  .rc-fam strong { font-variant-numeric: tabular-nums; }
  .rc-proc { font-size: 13.5px; color: var(--muted); line-height: 1.55; }
  .res-disclaimer { margin-top: 26px; padding: 12px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; color: var(--muted); font-size: 13.5px; max-width: 85ch; }
</style>
