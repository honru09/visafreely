---
import Base from '../layouts/Base.astro';
import ExploreStrip from '../components/ExploreStrip.astro';
import {
  countries,
  countsForPassport,
  passportsByEasy,
  passportRank,
  verifiedCount,
  data,
  type Country,
  pairPath,
} from '../lib/data';
import { t as i18nT, countryName, hrefFor, type LocaleCode } from '../i18n/locales';
import availabilityRaw from '../i18n/availability.json';
import policyChangesRaw from '../data/policy-changes.json';
import { AUDIENCE9, hotChipsFor, type HeadRoute } from '../lib/head-routes';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);
const nm = (c: Country) => countryName(locale, c);

const extras = data.extras as Record<string, { verified?: string }>;
const verifiedByPassport: Record<string, number> = {};
for (const [key, e] of Object.entries(extras)) {
  if (!e.verified) continue;
  const pc = key.split(':')[0];
  verifiedByPassport[pc] = (verifiedByPassport[pc] || 0) + 1;
}
const rows = passportsByEasy.map((r) => {
  const counts = countsForPassport(r.c.code);
  return {
    c: r.c,
    rank: passportRank[r.c.code],
    free: counts.F || 0,
    arrival: counts.A || 0,
    eta: counts.T || 0,
    easy: r.easy,
    verified: verifiedByPassport[r.c.code] || 0,
  };
});
const latestVerified = Object.values(extras).reduce(
  (m, e) => (e.verified && e.verified > m ? e.verified : m), '');
const policyChangeCount = (policyChangesRaw as unknown[]).length;
const destCount = countries.length - 1;
const totalRoutes = countries.length * destCount;
const totalRoutesFmt = totalRoutes.toLocaleString('en-US');
const top = rows[0];
const year = new Date().getFullYear();
// SEO L10 (2026-11-14): Dataset + FAQPage + BreadcrumbList structured
// data; the FAQ is also rendered visibly below the dataset section.
const faqItems = [
  { q: T('l10_rank_q1', { year }), a: T('l10_rank_a1', { top: nm(top.c), easy: top.easy }) },
  { q: T('l10_rank_q2'), a: T('l10_rank_a2', { dests: destCount }) },
  { q: T('l10_rank_q3'), a: T('l10_rank_a3', { changes: policyChangeCount }) },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const absUrl = (p: string) => new URL(href(p), Astro.site).href;
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Visa requirements for ${totalRoutesFmt} passport–destination pairs`,
  description: T('rank_data_p'),
  url: `${absUrl('/passport-ranking/')}#dataset`,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'VisaFreely', url: 'https://visafreely.com/' },
  dateModified: latestVerified,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://visafreely.com/data/visa-requirements.csv' },
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://visafreely.com/data/visa-requirements-verified.csv' },
  ],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T('l10_crumb_home'), item: absUrl('/') },
    { '@type': 'ListItem', position: 2, name: T('rank_h1', { year }), item: absUrl('/passport-ranking/') },
  ],
};
---

<Base
  title={T('rank_title', { year })}
  description={T('rank_desc', { passports: countries.length, routes: totalRoutesFmt, top: nm(top.c), easy: top.easy })}
  locale={locale}
>
  <h1>{T('rank_h1')}</h1>
  <p class="lede">
    {T('rank_lede_a')}<strong>{T('rank_lede_strong')}</strong>{T('rank_lede_b', { routes: totalRoutesFmt })}
  </p>
  <p>
    {T('rank_p2_a', { top: nm(top.c) })}<strong>{T('rank_p2_strong', { easy: top.easy })}</strong>{T('rank_p2_b')}<strong>{T('rank_p2_strong2', { verified: verifiedCount.toLocaleString('en-US'), routes: totalRoutesFmt })}</strong>{T('rank_p2_c', { dests: destCount })}
  </p>
  <p>
    {T('rank_p3_a')}<a href={href('/compare/')}>{T('rank_p3_link')}</a>{T('rank_p3_b')}
  </p>

  <div class="rank-table-wrap">
    <table class="rank-table">
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">{T('rank_th_passport')}</th>
          <th scope="col" class="num">{T('rank_th_free')}</th>
          <th scope="col" class="num">{T('rank_th_arrival')}</th>
          <th scope="col" class="num">{T('rank_th_eta')}</th>
          <th scope="col" class="num">{T('rank_th_noprior')}</th>
          <th scope="col" class="num">{T('rank_th_verified')}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td><span class={`rank-medal${r.rank <= 3 ? ' top' : ''}`}>{r.rank}</span></td>
            <td><a href={href(`/passport/${r.c.slug}/`)}>{nm(r.c)}</a>{(AUDIENCE9.includes(r.c.code) || r.rank <= 20) && (
              <span class="rank-chips"><span class="rank-chips-cap">{T('rank_routes_cap')}</span>{hotChipsFor(r.c.code).map((cr: HeadRoute) => (
                <a class="rank-chip" href={href(pairPath(cr.p, cr.d))}>{nm(cr.d)}</a>
              ))}</span>
            )}</td>
            <td class="num">{r.free}</td>
            <td class="num">{r.arrival}</td>
            <td class="num">{r.eta}</td>
            <td class="num"><strong>{r.easy}</strong></td>
            <td class="num">{r.verified} / {destCount}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="rank-ins">
    <div class="ri-main">
      <div class="ri-k">{T('rank_ins_kicker')}<span class="partner-tag">{T('partner_tag')}</span></div>
      <div class="ri-t">SafetyWing</div>
      <p>{T('rank_ins_p')}</p>
    </div>
    <a class="ri-cta" data-offer="safetywing-rank" href="https://safetywing.com/nomad-insurance?referenceID=26624375&utm_source=26624375&utm_medium=Ambassador" rel="sponsored nofollow noopener" target="_blank">{T('rank_ins_cta')} <span class="arr">→</span></a>
  </div>

  <h2>{T('rank_how_h2')}</h2>
  <p>
    {T('rank_how_a', { dests: destCount })}<strong>{T('rank_how_s1')}</strong>{T('rank_how_b')}<strong>{T('rank_how_s2')}</strong>{T('rank_how_c')}<strong>{T('rank_how_s3')}</strong>{T('rank_how_d')}
  </p>
  <p>
    {T('rank_how2_a')}<a href={href('/visa-policy-changes/')}>{T('rank_how2_link1')}</a>{T('rank_how2_b')}<a href="/changelog/">{T('rank_how2_link2')}</a>{T('rank_how2_c')}
  </p>
  <h2>{T('rank_method_h2')}</h2>
  <p>{T('rank_method_sources')}</p>
  <p>{T('rank_method_process', { verified: verifiedCount.toLocaleString('en-US'), routes: totalRoutesFmt })}</p>
  <p>{T('rank_method_updates', { changes: policyChangeCount })}</p>

  <h2 id="dataset">{T('rank_data_h2')}</h2>
  <p>{T('rank_data_p')}</p>
  <p class="rank-data-btns">
    <a href="/data/visa-requirements.csv" download>{T('rank_data_all_btn', { routes: totalRoutesFmt })}</a>
    <a href="/data/visa-requirements-verified.csv" download>{T('rank_data_verified_btn')}</a>
  </p>
  <p class="muted small">{T('rank_data_license', { date: latestVerified })}</p>

  <h2>{T('l10_faq_h')}</h2>
  {faqItems.map((f, i) => (
    <div class={`faq-item${i === 0 ? ' open' : ''}`}>
      <h3 style="margin:0;">
        <button class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'}>
          <span>{f.q}</span>
          <svg class="chev" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </h3>
      <div class="faq-panel">
        <div class="faq-a"><p>{f.a}</p></div>
      </div>
    </div>
  ))}

  <ExploreStrip locale={locale} items={[{ key: 'feat_map', href: href('/map/') }, { key: 'feat_compare', href: href('/compare/') }, { key: 'explore_check', href: href('/#checker') }]} />
  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>

<style>
  .rank-table-wrap { overflow-x: auto; margin: 1.2rem 0 2rem; }
  .rank-chips { display: block; margin-top: 6px; white-space: nowrap; overflow-x: auto; max-width: 380px; padding-bottom: 4px; scrollbar-width: thin; }
  .rank-chips-cap { font-size: 12px; color: #5a6472; margin-right: 6px; }
  .rank-table td a.rank-chip { display: inline-block; margin: 0 3px 3px 0; padding: 1px 8px; border: 1px solid #d8dee6; border-radius: 999px; font-size: 12.5px; background: #fff; }
  .rank-table { border-collapse: collapse; width: 100%; font-size: 14.5px; }
  .rank-table th, .rank-table td { padding: 0.5rem 0.6rem; border-bottom: 1px solid #e3e6ea; text-align: left; white-space: nowrap; vertical-align: top; }
  .rank-table td a { display: block; margin: -0.5rem -0.6rem; padding: 0.5rem 0.6rem; }
  .rank-table th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: #5a6472; }
  .rank-table td.num, .rank-table th.num { text-align: right; font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1, "ss01" 1, "zero" 1; }
  .rank-table tbody tr:hover { background: #f6f8fa; }
  /* B3: the ranking page's single commercial slot — insurance only (plan §4). */
  .rank-ins {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    box-shadow: var(--sh-sm); padding: 16px 18px; margin: 0 0 2rem;
  }
  .ri-main { flex: 1; min-width: 240px; }
  .ri-k { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); display: flex; align-items: center; gap: 8px; }
  .ri-t { font-size: 17px; font-weight: 800; margin-top: 2px; }
  .ri-main p { margin: 3px 0 0; font-size: 14.5px; color: var(--ink-2); }
  .ri-cta {
    flex: none; display: inline-flex; align-items: center; gap: 6px;
    background: var(--brand); color: #fff; font-weight: 700; font-size: 14px; padding: 10px 15px; border-radius: 999px; box-shadow: var(--sh-sm);
    transition: background-color .16s var(--ease);
  }
  .ri-cta:hover { background: var(--brand-deep); text-decoration: none; }
  .rank-data-btns { display: flex; gap: 10px; flex-wrap: wrap; margin: 14px 0 8px; }
  .rank-data-btns a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 10px 18px;
    border-radius: 999px; background: var(--brand); color: #fff; font-weight: 650;
    font-size: 15px; text-decoration: none;
  }
  .rank-data-btns a:last-child { background: var(--surface); color: var(--brand-ink); border: 1.5px solid var(--line); }
</style>
