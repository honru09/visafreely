---
// Residency hub (batch 1, 2026-11-14; redo 2026-11-15): the vertical's
// front door — route cards grouped open / closed, every figure from
// src/data/residency-routes.json with its verified date. The redo
// retires the comparison table (its processing column was a full
// official-text paragraph and clipped on mobile) for the shared route
// card: minimum up front, family total and a one-line reader
// distillation of processing time below it.
import Base from '../layouts/Base.astro';
import { flagEmoji, formatDateLong } from '../lib/data';
import {
  closedRoutes,
  familyTotalText,
  fmtMoney,
  minThreshold,
  openRoutes,
  processingShort,
  residencyDisclaimer,
  routePath,
  RESIDENCY_VERIFIED_DATE,
  type ResidencyRoute,
} from '../lib/residency';

const verifiedLong = formatDateLong(RESIDENCY_VERIFIED_DATE);
const openSorted = [...openRoutes].sort(
  (a, b) => (minThreshold(a) ?? 0) - (minThreshold(b) ?? 0),
);
const typeLabel = (r: ResidencyRoute) =>
  r.type === 'cbi' ? 'Citizenship by investment' : 'Residence by investment';
const closedLabel = (r: ResidencyRoute) =>
  r.type === 'cbi' ? 'Citizenship by investment' : 'Golden visa';
const title = 'Residency & citizenship by investment — verified programme figures | VisaFreely';
const description = `Investment citizenship and residence programmes with thresholds, government fees and status checked against official sources on ${verifiedLong} — closed programmes included and marked closed.`;
const absUrl = (p: string) => new URL(p, Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Residency & citizenship', item: absUrl('/residency/') },
  ],
};
---

<Base title={title} description={description} locale="en">
  <section class="band light">
    <div class="band-in">
      <h1>Residency &amp; citizenship by investment</h1>
      <p class="lede">
        Programme thresholds, government fees and status — every figure on
        these pages is taken from an official source and carries the date it
        was checked. Where officials publish no figure, the page says so
        instead of guessing.
      </p>
      <p class="muted">Data verified {verifiedLong} · Official sources only</p>
    </div>
  </section>

  <div class="band-in res-body">
    <h2>Open programmes <span class="count-pill">{openSorted.length}</span></h2>
    <div class="res-rcards">
      {
        openSorted.map((r) => (
          <a class="rcard" href={routePath(r)}>
            <span class="rc-line1">
              <span class="rc-id">
                <span aria-hidden="true">{flagEmoji(r.code)}</span> {r.country}
              </span>
              <span class="rc-min">
                <span class="rc-min-label">Minimum (single)</span>
                <span class="rc-amt">{fmtMoney(minThreshold(r) ?? 0, r.currency)}</span>
              </span>
            </span>
            <span class="rc-line2">
              <span class="res-badge open">Open</span>
              <span class="rc-prog">{typeLabel(r)}</span>
            </span>
            <span class="rc-fam">
              Family of 4 — government total{' '}
              <strong>
                {r.government_total_family4 != null
                  ? familyTotalText(r)
                  : 'not officially published'}
              </strong>
            </span>
            {processingShort(r) && <span class="rc-proc">{processingShort(r)}</span>}
          </a>
        ))
      }
    </div>

    <h2>Closed programmes <span class="count-pill">{closedRoutes.length}</span></h2>
    <p>
      Closed programmes stay published as archives — clearly marked — because
      out-of-date sources keep selling them as available.
    </p>
    <div class="res-rcards">
      {
        closedRoutes.map((r) => (
          <a class="rcard closed" href={routePath(r)}>
            <span class="rc-line1">
              <span class="rc-id">
                <span aria-hidden="true">{flagEmoji(r.code)}</span> {r.country}
              </span>
              <span class="rc-closed-word">
                Closed{r.status_date ? ` — ${formatDateLong(r.status_date)}` : ''}
              </span>
            </span>
            <span class="rc-line2">
              <span class="res-badge closed">Closed</span>
              <span class="rc-prog">{closedLabel(r)}</span>
            </span>
          </a>
        ))
      }
    </div>

    <h2>How to read these pages</h2>
    <p>
      Each route page leads with the nine decision figures — minimum
      investment, the government-side total for a family of four, the fee
      breakdown, processing time, residence requirement, the path to
      permanent residence and citizenship, dual-citizenship rules and
      restricted nationalities. Where two official sources disagree, both
      are shown in a dedicated section instead of being silently averaged.
    </p>

    <p class="res-disclaimer">{residencyDisclaimer(verifiedLong)}</p>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>

<style>
  .res-body { padding-top: 10px; padding-bottom: 30px; }
  /* KB-11 (2026-11-15): editorial prose layer — long-form paragraphs
     take a 68ch measure at a looser 1.65 line, chapters are separated
     by a hairline rule (the first heading sits at the top, no rule).
     Same block in all three residency views. */
  .res-body > p { max-width: 68ch; line-height: 1.65; }
  .res-body > h2 { margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--line); }
  .res-body > h2:first-child { margin-top: 10px; padding-top: 0; border-top: none; }
  /* Redo (2026-11-15): route cards replace the comparison table —
     one column on mobile, two on desktop (>=900px). Card grammar is
     shared with the country view's route list and the route view's
     related routes. The badge sits on the programme line, not the
     country line: long country names plus a badge pushed the amount
     out of place (mock finding, kept). */
  .res-rcards { display: grid; gap: 10px; grid-template-columns: 1fr; margin: 10px 0 14px; }
  @media (min-width: 900px) { .res-rcards { grid-template-columns: 1fr 1fr; } }
  .rcard { display: flex; flex-direction: column; gap: 7px; padding: 15px 17px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--sh-sm); color: var(--ink); text-decoration: none; }
  .rcard.closed { opacity: .82; }
  .rc-line1 { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .rc-id { font-size: 17px; font-weight: 800; line-height: 1.3; }
  .rc-min { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; flex-shrink: 0; }
  .rc-min-label { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .rc-amt { font-size: 21px; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 560px) { .rc-amt { font-size: 19px; } }
  .rc-line2 { display: flex; align-items: center; gap: 8px; }
  .rc-prog { font-size: 14px; color: var(--muted); }
  .rc-fam { font-size: 14px; }
  .rc-fam strong { font-variant-numeric: tabular-nums; }
  .rc-proc { font-size: 13.5px; color: var(--muted); line-height: 1.55; }
  .rc-closed-word { font-weight: 800; color: #9c1c1c; white-space: nowrap; }
  .res-badge { font-weight: 700; font-size: 12px; padding: 3px 10px; border-radius: 999px; }
  .res-badge.open { background: #eef7f2; color: var(--brand-deep); border: 1px solid #bfe3d0; font-weight: 600; }
  .res-badge.closed { background: #fbe7e7; color: #9c1c1c; border: 1px solid #f0b4b4; }
  .res-disclaimer { margin-top: 26px; padding: 12px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; color: var(--muted); font-size: 13.5px; max-width: 85ch; }
</style>
