---
// For business — commercial licensing / API / embed enquiries (competitor
// study path 5, closing segment: B9 embed attribution shipped 2026-11-13,
// this page is the enquiry surface). Facts only: counts are computed from
// the data layer at build time, nothing is priced, no customers are named,
// and no update frequency or SLA is promised — arrangements are per enquiry.
import Base from '../layouts/Base.astro';
import policyChanges from '../data/policy-changes.json';
import { data, verifiedCount, countries } from '../lib/data';
import { t as i18nT, hrefFor, type LocaleCode } from '../i18n/locales';
import availabilityRaw from '../i18n/availability.json';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);

const pairFmt = data.pairCount.toLocaleString('en-US');
const verifiedFmt = verifiedCount.toLocaleString('en-US');
const changeCount = (policyChanges as unknown[]).length;
const fbStr = { ok: T('fb_ok'), bad: T('pc_alert_bad'), err: T('fb_err'), sending: T('form_sending') };
---

<Base
  title={T('fb_title')}
  description={T('fb_desc', { pairs: pairFmt })}
  locale={locale}
>
  <h1>{T('fb_h1')}</h1>
  <p class="lede">
    {T('fb_lede', { pairs: pairFmt })}
  </p>

  <h2>{T('fb_cover_h2')}</h2>
  <ul class="fb-list">
    <li>
      <strong>{T('fb_li1_strong', { pairs: pairFmt })}</strong>{T('fb_li1_b', { count: countries.length })}
    </li>
    <li>
      <strong>{T('fb_li2_strong', { verified: verifiedFmt })}</strong>{T('fb_li2_b')}<a href={href('/about/')}>{T('fb_li2_link')}</a>{T('fb_li2_c')}
    </li>
    <li>
      <strong>{T('fb_li3_strong', { changes: changeCount })}</strong>{T('fb_li3_b')}<a href={href('/visa-policy-changes/')}>{T('fb_li3_link')}</a>{T('fb_li3_c')}
    </li>
    <li>
      {T('fb_li4_a')}<a href={href('/widget/')}>{T('fb_li4_link1')}</a>{T('fb_li4_b')}<a href={href('/compare/')}>{T('fb_li4_link2')}</a>{T('fb_li4_c')}
    </li>
  </ul>

  <h2>{T('fb_ways_h2')}</h2>
  <div class="fb-cards">
    <section class="fb-card">
      <h3>{T('fb_card1_t')}</h3>
      <p>{T('fb_card1_p')}</p>
    </section>
    <section class="fb-card">
      <h3>{T('fb_card2_t')}</h3>
      <p>{T('fb_card2_p')}</p>
    </section>
    <section class="fb-card">
      <h3>{T('fb_card3_t')}</h3>
      <p>
        {T('fb_card3_a')}<a href={href('/widget/')}>{T('fb_card3_link')}</a>{T('fb_card3_b')}
      </p>
    </section>
  </div>

  <h2>{T('fb_same_h2')}</h2>
  <p>
    {T('fb_same_p1')}
  </p>
  <p>
    {T('fb_same_p2')}
  </p>

  <h2>{T('fb_ask_h2')}</h2>
  <p>
    {T('fb_ask_p')}
  </p>

  <form id="fb-form" class="fb-form">
    <div class="fb-field">
      <label for="fb-email">{T('fb_email_label')}</label>
      <input
        id="fb-email"
        type="email"
        required
        placeholder="you@company.com"
        autocomplete="email"
      />
    </div>
    <div class="fb-field">
      <label for="fb-company">{T('fb_company_label')} <span class="fb-opt">{T('fb_opt')}</span></label>
      <input id="fb-company" type="text" placeholder={T('fb_company_ph')} autocomplete="organization" />
    </div>
    <div class="fb-field fb-wide">
      <label for="fb-use">{T('fb_use_label')} <span class="fb-opt">{T('fb_use_opt')}</span></label>
      <input
        id="fb-use"
        type="text"
        maxlength="140"
        placeholder={T('fb_use_ph')}
      />
    </div>
    <div class="fb-actions">
      <button type="submit" class="btn" style="cursor:pointer;">{T('fb_send')}</button>
      <p class="fb-alt">
        {T('fb_alt_a')}<a href="mailto:partners@visafreely.com">partners@visafreely.com</a>
      </p>
    </div>
    <p id="fb-status" hidden></p>
  </form>
  <script is:inline define:vars={{ fbStr }}>
    (function () {
      var form = document.getElementById('fb-form');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = form.querySelector('button');
        if (btn.disabled) return;
        var email = document.getElementById('fb-email').value.trim();
        var company = document.getElementById('fb-company').value.trim();
        var use = document.getElementById('fb-use').value.trim();
        var status = document.getElementById('fb-status');
        // The signup service stores {site, email, route} only, so the enquiry
        // detail rides in the route string (kept under its 200-char limit);
        // an enquiry without optional detail lands on the plain page route.
        var route = '/for-business/';
        var parts = [];
        if (company) parts.push('company=' + encodeURIComponent(company));
        if (use) parts.push('use=' + encodeURIComponent(use));
        if (parts.length) route = (route + '?' + parts.join('&')).slice(0, 200);
        // QA-001: same pending-state + keepalive treatment as the alert form.
        var origLabel = btn.textContent;
        btn.disabled = true;
        btn.textContent = fbStr.sending;
        status.hidden = false;
        status.textContent = fbStr.sending;
        fetch('https://honru09--site-stats-web.us-east.modal.run/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({ site: 'visafreely', email: email, route: route })
        }).then(function (r) {
          if (r.ok) {
            status.textContent = fbStr.ok;
            btn.textContent = origLabel;
          } else {
            status.textContent = fbStr.bad;
            btn.disabled = false;
            btn.textContent = origLabel;
          }
        }).catch(function () {
          status.textContent = fbStr.err;
          btn.disabled = false;
          btn.textContent = origLabel;
        });
      });
    })();
  </script>

  <style>
    .fb-list { display: grid; gap: 10px; margin: 0 0 8px; padding-left: 20px; }
    .fb-list li { line-height: 1.55; }
    .fb-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 14px 0 6px; }
    @media (max-width: 860px) { .fb-cards { grid-template-columns: 1fr; } }
    .fb-card {
      background: var(--card); border: 1px solid var(--line); border-radius: 14px;
      padding: 16px 18px; box-shadow: var(--sh-sm);
    }
    .fb-card h3 { margin: 0 0 8px; font-size: 17px; }
    .fb-card p { margin: 0; line-height: 1.55; }
    .fb-form {
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
      background: var(--soft); border: 1px solid var(--line); border-radius: 14px;
      padding: 18px; margin: 14px 0 8px;
    }
    @media (max-width: 640px) { .fb-form { grid-template-columns: 1fr; } }
    .fb-field label { display: block; font-weight: 600; color: var(--ink-2); margin-bottom: 5px; font-size: 14.5px; }
    .fb-opt { font-weight: 500; color: var(--muted); }
    .fb-field input {
      width: 100%; min-height: 44px; padding: 10px 12px; border-radius: 10px;
      border: 1px solid var(--line-strong); background: #fff; color: var(--ink);
      font: inherit; font-size: 15px;
    }
    .fb-wide { grid-column: 1 / -1; }
    .fb-actions { grid-column: 1 / -1; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .fb-actions .btn { min-height: 44px; }
    .fb-alt { margin: 0; color: var(--muted); font-size: 14.5px; }
    #fb-status { grid-column: 1 / -1; margin: 0; color: var(--brand-deep); font-size: 14.5px; }
  </style>
</Base>
