---
import Base from '../layouts/Base.astro';
import HubStrip from '../components/HubStrip.astro';
import {
  countries,
  countryByCode,
  groupedForDestination,
  pairPath,
  pairExtra,
  easyAccessCount,
  flagEmoji,
  data,
  type Country,
} from '../lib/data';
import {
  t as i18nT,
  countryName,
  statusLabelL,
  verdictTextL,
  hrefFor,
  type LocaleCode,
} from '../i18n/locales';
import availabilityRaw from '../i18n/availability.json';

interface Props {
  locale: LocaleCode;
  c: Country;
}
const { locale, c } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);
const nm = (x: Country) => countryName(locale, x);

const groups = groupedForDestination(c.code);
const countOf = (code: string) => groups.find((g) => g.code === code)?.passports.length || 0;
const freeCount = countOf('F');
const title = T('hubd_title', { name: nm(c) });
const description = T('hubd_desc', { name: nm(c), free: freeCount });
const others = countries.filter((x) => x.code !== c.code);
const total = groups.reduce((n, g) => n + g.passports.length, 0);
// B3 hub strip: passports that need paperwork (E/T/R) to enter this
// destination. Static rule: verified pairs first, then passport strength
// (destinations reachable without a prior application), then name.
const stripRoutes = countries
  .filter((x) => x.code !== c.code)
  .map((x) => ({ x, r: (data.byPassport[x.code] || []).find((row) => row.d === c.code) }))
  .filter((y) => y.r && (y.r.s === 'E' || y.r.s === 'T' || y.r.s === 'R'))
  .sort((a, b) => {
    const va = pairExtra(a.x.code, c.code).verified ? 0 : 1;
    const vb = pairExtra(b.x.code, c.code).verified ? 0 : 1;
    if (va !== vb) return va - vb;
    const ea = easyAccessCount(a.x.code);
    const eb = easyAccessCount(b.x.code);
    if (ea !== eb) return eb - ea;
    return a.x.name < b.x.name ? -1 : 1;
  })
  .slice(0, 3)
  .map((y) => ({
    href: href(pairPath(y.x, c)),
    flag: flagEmoji(y.x.code),
    name: nm(y.x),
    meta: verdictTextL(locale, y.r!),
    status: y.r!.s,
  }));
---

<Base title={title} description={description} locale={locale}>
  <section class="band light">
    <div class="band-in">
      <div class="crumbs"><a href={href('/destinations/')}>{T('idxd_h1')}</a></div>
      <h1>{T('hubd_h1', { name: nm(c) })}</h1>
      <p class="lede" style="margin-bottom:0;">
        <strong>{T('hubd_lede_strong', { free: freeCount })}</strong>{T('hubd_lede_b', { name: nm(c) })}
      </p>
    </div>
  </section>

  <HubStrip
    heading={T('hubd_strip_heading', { name: nm(c) })}
    sub={T('hubd_strip_sub')}
    routes={stripRoutes}
    locale={locale}
  />

  {/* Path 4 (2026-11-13): one compact insurance line under the paperwork
      strip — staggered, not stacked: a single row, no card body. Qualitative
      copy only; SafetyWing publishes no clean from-price (see batch-2
      PROGRESS), so no number is shown. */}
  <a
    class="hub-ins"
    data-offer="safetywing-hub"
    href="https://safetywing.com/nomad-insurance?referenceID=26624375&utm_source=26624375&utm_medium=Ambassador"
    rel="sponsored nofollow noopener"
    target="_blank">
    <span class="hub-ins-ic" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3.2 19 5.8v5.4c0 4.4-2.9 7.4-7 9.3-4.1-1.9-7-4.9-7-9.3V5.8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M12 8.2v5.6M9.2 11h5.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
    </span>
    <span class="hub-ins-text">
      <strong>{T('hub_ins_title', { name: nm(c) })}</strong>
      <span class="hub-ins-sub">{T('hub_ins_sub')}</span>
    </span>
    <span class="partner-tag">{T('partner_tag')}</span>
    <svg class="hub-ins-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>

  <div class="stat-band five">
    <div class="stat-tile"><b>{freeCount}</b><span>{T('tile_df')}</span></div>
    <div class="stat-tile"><b>{countOf('A')}</b><span>{T('tile_a')}</span></div>
    <div class="stat-tile"><b>{countOf('E')}</b><span>{T('tile_e')}</span></div>
    <div class="stat-tile"><b>{countOf('T')}</b><span>{T('tile_t')}</span></div>
    <div class="stat-tile"><b>{countOf('R')}</b><span>{T('tile_r')}</span></div>
  </div>

  <div data-filter-root>
    <div class="filter-chips" role="group" aria-label={T('hub_filter_pass')}>
      <button type="button" class="fchip on" data-filter="all" aria-pressed="true">{T('hub_all')}<span class="fcount">{total}</span></button>
      {groups.map((g) => (
        <button type="button" class={`fchip s-${g.code}`} data-filter={g.code} aria-pressed="false">
          <span class={`sdot ${g.code}`}></span>{statusLabelL(locale, g.code)}<span class="fcount">{g.passports.length}</span>
        </button>
      ))}
    </div>

    {groups.map((g) => (
      <section data-status={g.code}>
        <h2>{statusLabelL(locale, g.code)}<span class="count-pill">{g.passports.length}</span></h2>
        <div class="route-grid">
          {g.passports.map((x) => (
            <a class="route-card" href={href(pairPath(countryByCode[x.p], c))}>
              <span class="rc-top"><span class="rc-flag" aria-hidden="true">{flagEmoji(x.p)}</span><span class={`sdot ${g.code}`}></span><span class="rc-name">{nm(countryByCode[x.p])}</span></span>
              <span class="rc-meta">{x.days ? T('days_word', { days: x.days }) : statusLabelL(locale, g.code)}</span>
              <svg class="rc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <h2>{T('hub_other_dests')}</h2>
  <div class="pill-cloud">
    {others.slice(0, 40).map((x) => (
      <a href={href(`/destination/${x.slug}/`)}>{nm(x)}</a>
    ))}
    <a href={href('/destinations/')}>{T('hub_see_all_dests', { count: countries.length })}</a>
  </div>

  <style>
    .hub-ins {
      display: flex; align-items: center; gap: 10px;
      margin: 10px 0 4px; padding: 10px 14px;
      background: var(--card); border: 1px solid var(--line); border-radius: 14px;
      color: var(--ink); text-decoration: none; box-shadow: var(--sh-sm);
    }
    .hub-ins:hover { text-decoration: none; border-color: #bfe3d0; }
    .hub-ins:hover strong { color: var(--brand); }
    .hub-ins-ic {
      flex: none; display: flex; align-items: center; justify-content: center;
      width: 32px; height: 32px; border-radius: 50%;
      background: #eef7f2; border: 1px solid #bfe3d0; color: var(--brand);
    }
    .hub-ins-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .hub-ins-text strong { font-size: 15px; line-height: 1.25; }
    .hub-ins-sub {
      font-size: 13px; color: var(--muted); line-height: 1.3;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .hub-ins .partner-tag { margin-left: 0; }
    .hub-ins-arrow { flex: none; color: var(--muted); }
    @media (max-width: 720px) {
      .hub-ins { padding: 9px 12px; gap: 9px; }
      .hub-ins-text strong { font-size: 14.5px; }
      .hub-ins-sub { font-size: 12.5px; }
    }
  </style>
</Base>
