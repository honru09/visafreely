---
import Base from '../layouts/Base.astro';
import RouteChecker from '../components/RouteChecker.astro';
import { pairPath, type Country } from '../lib/data';
import { gridByPassport, topHeadRoutes } from '../lib/head-routes';
import { t as i18nT, countryName, statusLabelL, hrefFor, type LocaleCode } from '../i18n/locales';
import availabilityRaw from '../i18n/availability.json';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);
const nm = (c: Country) => countryName(locale, c);

// Head-route directory (indexation batch): the wave-A head set's
// core grid — nine audience passports x 14 hot destinations — plus the
// next 240 head routes by score, all as static links from this
// depth-1 page so the head pairs sit two clicks from home.
const gridKeys = new Set(
  gridByPassport.flatMap((g) => g.routes.map((r) => `${r.p.code}:${r.d.code}`)),
);
const moreRoutes = topHeadRoutes(240, gridKeys);
// SEO L10 breadcrumb (2026-11-14).
const absUrl = (p: string) => new URL(href(p), Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T('l10_crumb_home'), item: absUrl('/') },
    { '@type': 'ListItem', position: 2, name: T('visa_h1'), item: absUrl('/visa/') },
  ],
};
---

<Base title={T('visa_title')} description={T('visa_desc')} locale={locale}>
  <h1>{T('visa_h1')}</h1>
  <p class="lede">
    {T('visa_lede')}
  </p>
  <RouteChecker locale={locale} />
  <h2>{T('visa_popular_h2')}</h2>
  {gridByPassport.map((g) => (
    <h3 style="margin:22px 0 8px;font-size:17px;"><a href={href(`/passport/${g.p.slug}/`)}>{nm(g.p)}</a></h3>
    <div class="index-rows">
      {g.routes.map((r) => (
        <a class="index-row" href={href(pairPath(r.p, r.d))}>
          <span class="ir-name">{nm(r.p)} → {nm(r.d)}</span>
          <span class="ir-stat">{statusLabelL(locale, r.row.s)}</span>
        </a>
      ))}
    </div>
  ))}
  <h2>{T('visa_dir_more_h')}</h2>
  <div class="index-rows">
    {moreRoutes.map((r) => (
      <a class="index-row" href={href(pairPath(r.p, r.d))}>
        <span class="ir-name">{nm(r.p)} → {nm(r.d)}</span>
        <span class="ir-stat">{statusLabelL(locale, r.row.s)}</span>
      </a>
    ))}
  </div>
  <h2>{T('visa_browse_h2')}</h2>
  <div class="index-rows">
    <a class="index-row" href={href('/passports/')}>
      <span class="ir-name">{T('visa_all_passports')}</span>
      <span class="ir-stat">{T('visa_all_passports_stat')}</span>
    </a>
    <a class="index-row" href={href('/destinations/')}>
      <span class="ir-name">{T('visa_all_dests')}</span>
      <span class="ir-stat">{T('visa_all_dests_stat')}</span>
    </a>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>
