---
// World visa map — discovery surface (passports.io study, ADOPT-1).
// Pick a passport: every destination is coloured by the requirement its
// holders face, from the same dataset as the route pages. SSR renders the
// default passport fully (colours + links); the inline script re-colours
// in place when another passport is chosen. No shelf, no affiliate links.
//
// Localized variant: display names, status labels and every script
// string come from the message payload (M.names / M.labels / M.str), so
// the English page renders exactly the original text.
import Base from '../layouts/Base.astro';
import ExploreStrip from '../components/ExploreStrip.astro';
import world from '../data/world-paths.json';
import {
  countries,
  countryByCode,
  countsForPassport,
  easyAccessCount,
  passportRank,
  pairPath,
  flagEmoji,
  data,
  STATUS_ORDER,
  type Country,
} from '../lib/data';
import {
  t as i18nT,
  countryName,
  statusLabelL,
  hrefFor,
  localeByCode,
  type LocaleCode,
} from '../i18n/locales';
import availabilityRaw from '../i18n/availability.json';
import aliasesRaw from '../data/country-aliases.json';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);
const nm = (c: Country) => countryName(locale, c);

const DEFAULT_CODE = 'US';

// ---- Per-passport status strings, indexed by the countries array order ----
// 'S' marks the passport's own country; every other slot is its pair status.
const posByCode: Record<string, number> = Object.fromEntries(countries.map((c, i) => [c.code, i]));
const rows: Record<string, string> = {};
for (const c of countries) {
  const byDest = new Map((data.byPassport[c.code] || []).map((r) => [r.d, r.s]));
  rows[c.code] = countries.map((d) => (d.code === c.code ? 'S' : byDest.get(d.code) ?? '·')).join('');
}
// Build-time guards: the map must mirror the pair pages exactly, or not ship.
const totalRows = Object.values(data.byPassport).reduce((n, r) => n + r.length, 0);
if (totalRows !== data.pairCount) throw new Error(`map: row total ${totalRows} != pairCount ${data.pairCount}`);
for (const c of countries) {
  if ((data.byPassport[c.code] || []).length !== countries.length - 1)
    throw new Error(`map: ${c.code} has ${(data.byPassport[c.code] || []).length} rows, expected ${countries.length - 1}`);
  if (rows[c.code].includes('·')) throw new Error(`map: ${c.code} status string has a gap`);
}

const def = countryByCode[DEFAULT_CODE];
const defRow = rows[DEFAULT_CODE];
const statusFor = (code: string) => defRow[posByCode[code]];
const defCounts = countsForPassport(DEFAULT_CODE);
const defEasy = easyAccessCount(DEFAULT_CODE);
const defRank = passportRank[DEFAULT_CODE];

const mapEntries = Object.entries(world.paths as Record<string, string>);
const offMap = countries.filter((c) => !(world.paths as Record<string, string>)[c.code]);

const payload = {
  codes: countries.map((c) => c.code),
  names: Object.fromEntries(countries.map((c) => [c.code, nm(c)])),
  aka: aliasesRaw,
  slugs: Object.fromEntries(countries.map((c) => [c.code, c.slug])),
  ranks: passportRank,
  rows,
  labels: Object.fromEntries(STATUS_ORDER.map((s) => [s, statusLabelL(locale, s)])),
  total: countries.length,
  hubBase: locale === 'en' ? '/passport/' : `/${localeByCode[locale].prefix}/passport/`,
  locale,
  str: {
    ariaSelf: T('map_aria_self', { name: '{name}' }),
    ariaReq: T('map_aria_req', { name: '{name}', label: '{label}' }),
    titleSelf: T('map_title_self', { name: '{name}' }),
    titleStatus: T('map_title_status', { name: '{name}', label: '{label}' }),
    readout: T('map_readout', { name: '{name}' }),
    nameTpl: T('home_name_passport', { name: '{name}' }),
    pageTpl: T('map_more_page', { name: '{name}' }),
    empty: T('ck_empty'),
  },
};
// Popular-passport quick chips under the picker (selector-fix 2026-11-14):
// ranking head + main source markets — most visitors tap instead of typing.
const QUICK = ['US', 'GB', 'JP', 'CN', 'DE', 'FR', 'AU', 'SG'];

const pairCountFmt = data.pairCount.toLocaleString('en-US');
// SEO L10 breadcrumb (2026-11-14).
const absUrl = (p: string) => new URL(href(p), Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T('l10_crumb_home'), item: absUrl('/') },
    { '@type': 'ListItem', position: 2, name: T('map_h1'), item: absUrl('/map/') },
  ],
};
---

<Base
  title={T('map_title')}
  description={T('map_desc', { pairs: pairCountFmt })}
  locale={locale}
>
  <h1>{T('map_h1')}</h1>
  <p class="lede">
    {T('map_lede', { pairs: pairCountFmt })}
  </p>

  <div class="map-picker">
    <label class="map-label" for="map-passport">{T('ck_from_label')}</label>
    <div class="ck-wrap map-wrap">
      <span class="ck-flag" id="map-flag" aria-hidden="true">{flagEmoji(def.code)}</span>
      <input
        id="map-passport"
        class="ck-input has-flag"
        value={nm(def)}
        placeholder={T('ck_placeholder')}
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="map-list"
        aria-autocomplete="list"
      />
      <svg class="ck-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <button type="button" class="ck-clear" id="map-clear" aria-label={T('map_clear')} tabindex="-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      </button>
      <ul class="ck-list" id="map-list" role="listbox" aria-label={T('ck_list_passports')}></ul>
    </div>
    <div class="map-quick" role="group" aria-label={T('map_quick_label')}>
      {QUICK.map((qc) => (
        <button type="button" class={`mq-chip${qc === DEFAULT_CODE ? ' active' : ''}`} data-qc={qc} aria-pressed={qc === DEFAULT_CODE ? 'true' : 'false'}>
          <span aria-hidden="true">{flagEmoji(qc)}</span>{nm(countryByCode[qc])}
        </button>
      ))}
    </div>
  </div>

  <p class="map-summary">
    <span id="ms-flag" aria-hidden="true">{flagEmoji(def.code)}</span>
    <b id="ms-name">{T('home_name_passport', { name: nm(def) })}</b> —
    <b class="tnum" id="ms-easy">{defEasy}</b>{T('map_sum_a')}<b class="tnum" id="ms-rank">#{defRank}</b>{T('map_sum_of', { total: countries.length })}
  </p>
  <p class="map-hint">{T('map_hint')}</p>

  <div class="map-card">
    <svg
      id="world-map"
      class="world-map"
      viewBox={world.viewBox}
      role="group"
      aria-label={T('map_svg_label')}
    >
      <path class="m-land" d={world.land}></path>
      {
        mapEntries.map(([code, d]) => {
          const dest = countryByCode[code];
          const self = code === DEFAULT_CODE;
          const st = statusFor(code);
          return (
            <a
              class={`mc${self ? ' self' : ` s-${st}`}`}
              data-code={code}
              href={self ? href(`/passport/${def.slug}/`) : href(pairPath(def, dest))}
              aria-label={self ? T('map_aria_self', { name: nm(dest) }) : T('map_aria_req', { name: nm(dest), label: statusLabelL(locale, st) })}
            >
              <title>{self ? T('map_title_self', { name: nm(dest) }) : T('map_title_status', { name: nm(dest), label: statusLabelL(locale, st) })}</title>
              <path d={d} />
            </a>
          );
        })
      }
    </svg>
  </div>

  <ul class="map-legend" aria-label={T('map_legend_label')}>
    {
      STATUS_ORDER.map((s) => (
        <li>
          <span class={`sdot ${s}`} aria-hidden="true"></span>
          {statusLabelL(locale, s)}
          <b class="lg-n tnum" data-lg={s}>{defCounts[s] || 0}</b>
        </li>
      ))
    }
    <li><span class="sdot lg-self" aria-hidden="true"></span>{T('map_your_passport')}</li>
    <li><span class="sdot lg-none" aria-hidden="true"></span>{T('map_not_in_dataset')}</li>
  </ul>
  <p class="map-readout" id="map-readout" aria-live="polite">{T('map_readout', { name: nm(def) })}</p>

  <h2 class="map-h2">{T('map_off_h2')}</h2>
  <p class="muted small">
    {T('map_off_a', { n: offMap.length })}<span id="chips-passport">{nm(def)}</span>{T('map_off_b')}
  </p>
  <div class="map-chips" id="map-chips">
    {
      offMap.map((d) => {
        const st = statusFor(d.code);
        return (
          <a class="map-chip" data-chip={d.code} href={href(pairPath(def, d))}>
            <span class={`sdot ${st}`} aria-hidden="true"></span>
            <span aria-hidden="true">{flagEmoji(d.code)}</span>
            {nm(d)}
          </a>
        );
      })
    }
  </div>

  <p class="map-more">
    {T('map_more_b').replace(/^ · /, '')}<a id="map-hub-link" href={href(`/passport/${def.slug}/`)}>{T('map_more_page', { name: nm(def) })}</a>
  </p>

  <script is:inline define:vars={{ payload, defaultCode: DEFAULT_CODE }}>
    (function () {
      var M = payload;
      var pos = {};
      M.codes.forEach(function (c, i) { pos[c] = i; });
      var byName = {};
      var bySlug = {};
      M.codes.forEach(function (c) {
        byName[M.names[c].toLowerCase()] = c;
        bySlug[M.slugs[c]] = c;
      });
      var ALL = M.codes.map(function (c) { return { code: c, name: M.names[c], slug: M.slugs[c], a: M.aka[c] || '' }; });
      function normQ(s) {
        return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7a3\u0e00-\u0e7f]/g, '');
      }
      function akaHit(a, qn, prefix) {
        if (!a || !qn) return false;
        var ts = a.split('|');
        for (var k = 0; k < ts.length; k++) {
          var ix = ts[k].indexOf(qn);
          if (prefix ? ix === 0 : ix >= 0) return true;
        }
        return false;
      }

      var input = document.getElementById('map-passport');
      var list = document.getElementById('map-list');
      var flagEl = document.getElementById('map-flag');
      var wrap = input.parentElement;
      var svg = document.getElementById('world-map');
      var readout = document.getElementById('map-readout');
      var current = defaultCode;

      function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
      function fill(tpl, vars) {
        return String(tpl).replace(/\{(\w+)\}/g, function (_, k) { return vars[k] != null ? vars[k] : ''; });
      }
      function flagEmoji(code) {
        if (!/^[A-Za-z]{2}$/.test(code || '')) return '';
        try {
          return String.fromCodePoint.apply(null, code.toUpperCase().split('').map(function (c) { return 127397 + c.charCodeAt(0); }));
        } catch (e) { return ''; }
      }
      function easyOf(row) {
        var n = 0;
        for (var i = 0; i < row.length; i++) { var ch = row[i]; if (ch === 'F' || ch === 'A' || ch === 'T') n++; }
        return n;
      }

      /* ---------- map state ---------- */
      /* P0 (2026-11-14): pair links prefer the localized pair page when
         the route is launched for this locale (wave-A set), else the
         English pair page — same availability manifest the language
         switcher consults. Server-rendered hrefs already carry the
         localized-first choice; this keeps JS-rewritten hrefs in step,
         and re-applies once the manifest arrives. */
      var AVAIL = null;
      var availReady = fetch('/i18n-availability.json')
        .then(function (r) { return r.json(); })
        .then(function (j) { AVAIL = j; })
        .catch(function () {});
      function pairHref(pslug, dslug) {
        var en = '/visa/' + pslug + '/' + dslug + '/';
        if (M.locale === 'en' || !AVAIL) return en;
        var locs = AVAIL[en];
        return locs && locs.indexOf(M.locale) >= 0 ? '/' + M.locale + en : en;
      }
      availReady.then(function () { try { if (current) applyPassport(current); } catch (e) {} });
      function applyPassport(code) {
        current = code;
        var row = M.rows[code];
        var pslug = M.slugs[code];
        svg.querySelectorAll('a.mc').forEach(function (a) {
          var dc = a.getAttribute('data-code');
          var dname = M.names[dc];
          var t = a.querySelector('title');
          if (dc === code) {
            a.setAttribute('class', 'mc self');
            a.setAttribute('href', M.hubBase + pslug + '/');
            a.setAttribute('aria-label', fill(M.str.ariaSelf, { name: dname }));
            if (t) t.textContent = fill(M.str.titleSelf, { name: dname });
          } else {
            var st = row[pos[dc]];
            a.setAttribute('class', 'mc s-' + st);
            a.setAttribute('href', pairHref(pslug, M.slugs[dc]));
            a.setAttribute('aria-label', fill(M.str.ariaReq, { name: dname, label: M.labels[st] }));
            if (t) t.textContent = fill(M.str.titleStatus, { name: dname, label: M.labels[st] });
          }
        });
        var counts = { F: 0, A: 0, E: 0, T: 0, R: 0, N: 0 };
        for (var i = 0; i < row.length; i++) { if (counts[row[i]] !== undefined) counts[row[i]]++; }
        document.querySelectorAll('[data-lg]').forEach(function (el) {
          el.textContent = counts[el.getAttribute('data-lg')];
        });
        document.querySelectorAll('[data-chip]').forEach(function (chip) {
          var dc = chip.getAttribute('data-chip');
          var st = row[pos[dc]];
          chip.setAttribute('href', pairHref(pslug, M.slugs[dc]));
          var dot = chip.querySelector('.sdot');
          if (dot) dot.setAttribute('class', 'sdot ' + st);
        });
        document.getElementById('ms-flag').textContent = flagEmoji(code);
        document.getElementById('ms-name').textContent = fill(M.str.nameTpl, { name: M.names[code] });
        document.getElementById('ms-easy').textContent = easyOf(row);
        document.getElementById('ms-rank').textContent = '#' + M.ranks[code];
        document.getElementById('chips-passport').textContent = M.names[code];
        var hub = document.getElementById('map-hub-link');
        hub.setAttribute('href', M.hubBase + pslug + '/');
        hub.textContent = fill(M.str.pageTpl, { name: M.names[code] });
        document.querySelectorAll('.mq-chip').forEach(function (chip) {
          var on = chip.getAttribute('data-qc') === code;
          chip.classList.toggle('active', on);
          chip.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        readout.textContent = fill(M.str.readout, { name: M.names[code] });
        try { localStorage.setItem('vf_map_p', code); } catch (e) {}
        try {
          var url = new URL(location.href);
          if (url.searchParams.get('p') !== pslug) {
            url.searchParams.set('p', pslug);
            history.replaceState(null, '', url);
          }
        } catch (e) {}
      }

      function readoutFor(a) {
        var dc = a.getAttribute('data-code');
        if (dc === current) return fill(M.str.titleSelf, { name: M.names[dc] });
        var st = M.rows[current][pos[dc]];
        return fill(M.str.titleStatus, { name: M.names[dc], label: M.labels[st] });
      }
      svg.addEventListener('mouseover', function (ev) {
        var a = ev.target && ev.target.closest ? ev.target.closest('a.mc') : null;
        if (a) readout.textContent = readoutFor(a);
      });
      svg.addEventListener('focusin', function (ev) {
        var a = ev.target && ev.target.closest ? ev.target.closest('a.mc') : null;
        if (a) readout.textContent = readoutFor(a);
      });
      svg.addEventListener('mouseleave', function () {
        readout.textContent = fill(M.str.readout, { name: M.names[current] });
      });

      /* ---------- passport combobox (same pattern as the route checker) ---------- */
      var active = -1;
      var currentList = [];
      function close() {
        wrap.classList.remove('open');
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        active = -1;
      }
      function render() {
        var q = input.value.trim().toLowerCase();
        var qn = normQ(q);
        // An untouched selected name is a label, not a query: show the full list.
        if (q === M.names[current].toLowerCase()) q = '';
        var starts = [], contains = [];
        for (var i = 0; i < ALL.length; i++) {
          var n = ALL[i].name.toLowerCase();
          if (n.indexOf(q) === 0 || akaHit(ALL[i].a, qn, true)) starts.push(ALL[i]);
          else if (q && (n.indexOf(q) >= 0 || akaHit(ALL[i].a, qn, false))) contains.push(ALL[i]);
        }
        currentList = q ? starts.concat(contains) : ALL;
        if (!currentList.length) {
          list.innerHTML = '<li class="ck-empty">' + M.str.empty + '</li>';
        } else {
          list.innerHTML = currentList.map(function (c, i) {
            return '<li class="ck-option" role="option" id="map-list-o' + i + '" data-name="' + esc(c.name) + '" aria-selected="false">'
              + '<span class="fl">' + flagEmoji(c.code) + '</span>' + esc(c.name)
              + '<span class="cd">' + esc(c.code) + '</span></li>';
          }).join('');
        }
        wrap.classList.add('open');
        input.setAttribute('aria-expanded', 'true');
        active = -1;
      }
      function setActive(i) {
        var opts = list.querySelectorAll('.ck-option');
        opts.forEach(function (o, j) { o.classList.toggle('active', j === i); });
        active = i;
        if (i >= 0 && opts[i]) { input.setAttribute('aria-activedescendant', opts[i].id); opts[i].scrollIntoView({ block: 'nearest' }); }
        else input.removeAttribute('aria-activedescendant');
      }
      function choose(c) {
        input.value = c.name;
        var f = flagEmoji(c.code);
        flagEl.textContent = f;
        input.classList.toggle('has-flag', !!f);
        close();
        syncClear();
        applyPassport(c.code);
      }
      /* Selector-fix (2026-11-14): the field opens showing the selected name.
         On open, select it all so typing replaces it — no manual deleting.
         The × button clears the text and opens the full list; neither changes
         the applied passport until a new one is chosen (same rule as typing). */
      var clearBtn = document.getElementById('map-clear');
      function syncClear() { wrap.classList.toggle('ck-has-text', input.value.length > 0); }
      function maybeSelectAll() {
        if (input.value !== M.names[current]) return;
        try { input.select(); } catch (e) {}
        try { input.setSelectionRange(0, input.value.length); } catch (e) {}
        // WebKit applies the tap caret after the focus/click handlers run,
        // wiping the selection — re-apply once the gesture task has settled.
        setTimeout(function () {
          if (document.activeElement === input && input.value === M.names[current]
              && (input.selectionStart !== 0 || input.selectionEnd !== input.value.length)) {
            try { input.select(); } catch (e) {}
            try { input.setSelectionRange(0, input.value.length); } catch (e) {}
          }
        }, 0);
      }
      function doClear() {
        input.value = '';
        flagEl.textContent = '';
        input.classList.remove('has-flag');
        render();
        syncClear();
        input.focus();
      }
      clearBtn.addEventListener('pointerdown', function (ev) { ev.preventDefault(); doClear(); });
      clearBtn.addEventListener('click', function (ev) { ev.preventDefault(); if (input.value) doClear(); });
      input.addEventListener('input', function () { flagEl.textContent = ''; input.classList.remove('has-flag'); render(); syncClear(); });
      input.addEventListener('focus', function () { render(); maybeSelectAll(); });
      // After a choice the field keeps focus with the list closed; a fresh tap
      // must reopen it (no new focus event fires) — and re-select the name.
      input.addEventListener('click', function () { if (!wrap.classList.contains('open')) { render(); maybeSelectAll(); } });
      /* BUG-001 hold: a touch-scroll of the list must never let the blur timer close it mid-gesture. */
      var holdUntil = 0;
      function hold() { holdUntil = Date.now() + 800; }
      list.addEventListener('pointerdown', hold);
      list.addEventListener('touchstart', hold, { passive: true });
      list.addEventListener('scroll', hold, { passive: true });
      input.addEventListener('blur', function () {
        setTimeout(function deferClose() {
          if (Date.now() < holdUntil) setTimeout(deferClose, 400);
          else close();
        }, 120);
      });
      input.addEventListener('keydown', function (ev) {
        if (ev.key === 'ArrowDown') { ev.preventDefault(); if (!wrap.classList.contains('open')) render(); setActive(Math.min(active + 1, currentList.length - 1)); }
        else if (ev.key === 'ArrowUp') { ev.preventDefault(); setActive(Math.max(active - 1, 0)); }
        else if (ev.key === 'Enter' && wrap.classList.contains('open') && active >= 0 && currentList[active]) { ev.preventDefault(); choose(currentList[active]); }
        else if (ev.key === 'Escape') { close(); }
      });
      list.addEventListener('mousedown', function (ev) {
        var li = ev.target.closest ? ev.target.closest('.ck-option') : null;
        if (!li) return;
        ev.preventDefault();
        var code = byName[li.getAttribute('data-name').toLowerCase()];
        if (code) choose({ code: code, name: M.names[code], slug: M.slugs[code] });
      });

      /* ---------- popular-passport quick chips ---------- */
      document.querySelectorAll('.mq-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          var code = chip.getAttribute('data-qc');
          if (code && M.rows[code]) choose({ code: code, name: M.names[code], slug: M.slugs[code] });
        });
      });

      /* ---------- initial selection: ?p= wins, then the last-used passport ---------- */
      var initial = null;
      try {
        var p = new URL(location.href).searchParams.get('p');
        if (p && bySlug[p]) initial = bySlug[p];
      } catch (e) {}
      if (!initial) {
        try {
          var saved = localStorage.getItem('vf_map_p');
          if (saved && M.rows[saved]) initial = saved;
        } catch (e) {}
      }
      if (initial && initial !== defaultCode) {
        var c0 = { code: initial, name: M.names[initial], slug: M.slugs[initial] };
        input.value = c0.name;
        flagEl.textContent = flagEmoji(initial);
        applyPassport(initial);
      }
      syncClear();
    })();
  </script>

  <style>
    .map-picker { max-width: 520px; margin: 20px 0 6px; }
    .map-label {
      display: block; margin: 0 0 6px; font-size: 12px; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase; color: var(--gold-ink);
    }
    .map-wrap { max-width: 520px; }
    .map-quick { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .mq-chip {
      display: inline-flex; align-items: center; gap: 7px; min-height: 40px;
      padding: 6px 13px; border: 1px solid var(--line); border-radius: 999px;
      background: var(--card); color: var(--ink); font: inherit;
      font-size: 14px; font-weight: 600; cursor: pointer; touch-action: manipulation;
