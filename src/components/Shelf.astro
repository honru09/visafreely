      </span>
      <span class="q-main">
        <span class="q-name">SafetyWing</span>
        <span class="q-sub">Travel medical cover, priced per day or by the month</span>
      </span>
      <span class="partner-tag">Partner</span>
      <span class="q-arr" aria-hidden="true">→</span>
    </a>
    <a class="qrow" data-offer={`worldnomads-${pos}`} href="https://www.kqzyfj.com/click-101912829-15736546" rel="sponsored nofollow noopener" target="_blank">
      <span class="q-ic" aria-hidden="true">
