      </span>
      <span class="partner-tag">Partner</span>
      <span class="q-arr" aria-hidden="true">→</span>
    </a>
    )}
    <a class="qrow" data-offer={`safetywing-${pos}`} href="https://safetywing.com/nomad-insurance?referenceID=26624375&utm_source=26624375&utm_medium=Ambassador" rel="sponsored nofollow noopener" target="_blank">
      <span class="q-ic" aria-hidden="true">
