---
// Affiliate shelf — sits at the natural action point on pair pages: after the
// verdict, steps and "Before you go" checklist, before the requirement spec table.
// Live programs: eVisas (ref=visafreely, PRIMARY processor since 2026-11-11 per the marketing plan), VisaHQ (vaff18633, demoted to fallback), SafetyWing (26624375) and World Nomads (CJ click-101912829-15736546, joined 2026-11-05). Airalo runs on the Travelpayouts tracked link (airalo.tpx.lt, 12%, 30-day cookie, switched 2026-11-15).
// Presentation is driven by the route's raw status (processor swap 2026-11-11):
//   R (embassy visa) — eVisas featured full-width, VisaHQ fallback card, insurance + eSIM secondary.
//   E (e-visa)       — eVisas featured, with an honest note that the official online application exists; VisaHQ fallback.
//   F (visa free)    — no processor; insurance + eSIM as an equal two-card row.
//   A (on arrival)   — no processor; eSIM leads (data on landing), insurance second.
//   T (ETA)          — eVisas card (authorisation filing) + insurance + eSIM.
//   N (no admission) — renders nothing at all.
// Position split (shelf dedup, 2026-11-14): the full cards render ONCE, at
// pos="top". pos="bottom" repeats the same offers — same hrefs, same
// data-offer anchors, same sid deep links — as compact one-line quick rows
// under a different heading, so a page never shows the same card twice. The
// B10 insurance fact notes (cardNote/cutNote) and the honest line belong to
// the top shelf only; the bottom rows are links, not a second printing of
// the facts.
// Visual identity: "travel kit" panel — tinted band with a dashed stamp-style inner
// border; cards are boarding-pass style with an icon stub, a Partner tag and a pill CTA.
// Localization (wave A): copy comes from the message catalogue (shelf_* keys)
// and the B10 notes from the localized insurance text map; hrefs, data-offer
// anchors and sid deep links are identical in every locale.
import Stamp from './Stamp.astro';
import campaigns from '../data/evisas-campaigns.json';
import { insuranceFor } from '../lib/insurance';
import { t as i18nT, type LocaleCode } from '../i18n/locales';
import { insuranceTextL } from '../i18n/insurance-text';
interface Props {
  status: string;
  passportName: string;
  destinationName: string;
  passportCode?: string;
  destinationCode?: string;
  pos?: string;
  locale?: LocaleCode;
}
const { status, destinationName, passportCode, destinationCode, pos = 'bottom' } = Astro.props;
const locale: LocaleCode = Astro.props.locale ?? 'en';
const T = i18nT(locale);
const sid = passportCode && destinationCode ? (campaigns as Record<string, string>)[`${passportCode}:${destinationCode}`] : undefined;
const evisasHref = sid ? `https://evisas.com/?ref=visafreely&sid=${sid}` : 'https://evisas.com/?ref=visafreely';
const isVisa = status === 'R' || status === 'E';
const quick = pos === 'bottom';
const headings: Record<string, string> = {
  R: T('shelf_h_r'),
  E: T('shelf_h_e'),
  F: T('shelf_h_f'),
  A: T('shelf_h_a', { d: destinationName }),
  T: T('shelf_h_t'),
};
const heading = headings[status] ?? T('shelf_h_f');
const shelfClass = isVisa ? 'shelf shelf--featured' : 'shelf shelf--duo';
// B10: factual insurance-requirement annotation. cardNote exists only for
// destinations where a general travel-medical policy can meet the rule;
// officialOnly destinations (QA/SA/KE/TZ) get no card note, and QA adds a
// separation line under the shelf instead (see cutNote in the data file).
const ins = passportCode && destinationCode ? insuranceFor(destinationCode, status, passportCode) : null;
const cardNote = ins ? insuranceTextL(locale, ins, 'cardNote') : null;
const cutNote = ins ? insuranceTextL(locale, ins, 'cutNote') : null;
---

{status !== 'N' && !quick && (
<section class="shelf-section">
  <div class="shelf-head">
    <span class="shelf-stamp" aria-hidden="true"><Stamp size={24} /></span>
    <h2>{heading}</h2>
  </div>
  <div class={shelfClass}>
    {isVisa && (
    <div class="card featured">
      <div class="stub" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14" height="17" rx="2" stroke="currentColor" stroke-width="1.9"/><path d="M9 8.5h6M9 12h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M9.2 16.4l1.6 1.6 3-3.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="pass-main">
        <div class="k">{T('shelf_ev_k')}<span class="partner-tag">{T('partner_tag')}</span></div>
        <div class="t">eVisas</div>
        <p>
          {T('shelf_ev_p')}
        </p>
        {status === 'E' && (
        <p class="official-note">{T('shelf_ev_official')}</p>
        )}
        <a class="visit-link" data-offer={`evisas-${pos}`} href={evisasHref} rel="sponsored nofollow noopener" target="_blank">{T('shelf_ev_cta')} <span class="arr">→</span></a>
      </div>
    </div>
    <!-- B7-2 (2026-11-13): VisaHQ demoted from a full card to a compact text
         line — same href and data-offer anchor, so attribution is unchanged,
         but the visual weight goes to the primary offer (eVisas, 45% vs 10%).
         30-day CTR comparison runs from the deploy date; see batch PROGRESS. -->
    <div class="alt-line">
      <p class="alt-text">
        <span class="alt-k">{T('shelf_alt_k')}</span> — {T('shelf_alt_p')}<span class="partner-tag">{T('partner_tag')}</span>
      </p>
      <a class="alt-link" data-offer={`visahq-${pos}`} href="https://www.visahq.co.uk/?a_aid=vaff18633" rel="sponsored nofollow noopener" target="_blank">{T('shelf_alt_cta')} <span class="arr">→</span></a>
    </div>
    )}
    {status === 'T' && (
    <div class="card">
      <div class="stub" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14" height="17" rx="2" stroke="currentColor" stroke-width="1.9"/><path d="M9 8.5h6M9 12h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M9.2 16.4l1.6 1.6 3-3.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="pass-main">
        <div class="k">{T('shelf_ta_k')}<span class="partner-tag">{T('partner_tag')}</span></div>
        <div class="t">eVisas</div>
        <p>{T('shelf_ta_p')}</p>
        <a class="visit-link" data-offer={`evisas-${pos}`} href={evisasHref} rel="sponsored nofollow noopener" target="_blank">{T('shelf_ev_cta')} <span class="arr">→</span></a>
      </div>
    </div>
    )}
    <div class="card">
      <div class="stub" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 3.2 19 5.8v5.4c0 4.4-2.9 7.4-7 9.3-4.1-1.9-7-4.9-7-9.3V5.8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M12 8.2v5.6M9.2 11h5.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
      </div>
      <div class="pass-main">
        <div class="k">{T('shelf_ins_k')}<span class="partner-tag">{T('partner_tag')}</span></div>
        <div class="t">SafetyWing</div>
        <p>{T('shelf_ins_p')}</p>
        {cardNote && <p class="ins-note">{cardNote}</p>}
        <a class="visit-link" data-offer={`safetywing-${pos}`} href="https://safetywing.com/nomad-insurance?referenceID=26624375&utm_source=26624375&utm_medium=Ambassador" rel="sponsored nofollow noopener" target="_blank">{T('shelf_ins_cta')} <span class="arr">→</span></a>
      </div>
    </div>
    <div class="card">
      <div class="stub" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3.5 18.5 9.8 8l3.4 4.9 2.3-3.1 5 8.7Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><circle cx="17.2" cy="6.2" r="1.7" stroke="currentColor" stroke-width="1.9"/></svg>
      </div>
      <div class="pass-main">
        <div class="k">{T('shelf_wn_k')}<span class="partner-tag">{T('partner_tag')}</span></div>
        <div class="t">World Nomads</div>
        <p>{T('shelf_wn_p')}</p>
        <a class="visit-link" data-offer={`worldnomads-${pos}`} href="https://www.kqzyfj.com/click-101912829-15736546" rel="sponsored nofollow noopener" target="_blank">{T('shelf_wn_cta')} <span class="arr">→</span></a>
      </div>
    </div>
    <div class={status === 'A' ? 'card card--lead' : 'card'}>
      <div class="stub" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M4.5 10.3a11 11 0 0 1 15 0M7.3 13.7a6.8 6.8 0 0 1 9.4 0" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><circle cx="12" cy="17.4" r="1.4" fill="currentColor"/></svg>
      </div>
      <div class="pass-main">
        <div class="k">{T('shelf_esim_k')}</div>
        <div class="t">Airalo</div>
        <p>{T('shelf_esim_p')}</p>
        <a class="visit-link" data-offer={`airalo-${pos}`} href="https://airalo.tpx.lt/GU9747nV" rel="sponsored nofollow noopener" target="_blank">{T('shelf_esim_cta')} <span class="arr">→</span></a>
      </div>
    </div>
  </div>
  {cutNote && <p class="ins-cut">{cutNote}</p>}
  <p class="honest-line">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 11v5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="8" r="1.3" fill="currentColor"/></svg>
    <span>{T('shelf_honest')}</span>
  </p>
</section>
)}

{status !== 'N' && quick && (
<section class="shelf-section shelf-section--quick">
  <div class="shelf-head">
    <span class="shelf-stamp" aria-hidden="true"><Stamp size={24} /></span>
    <h2>{T('shelf_quick_h')}</h2>
  </div>
  <div class="shelf shelf--quick">
    {isVisa && (
    <a class="qrow" data-offer={`evisas-${pos}`} href={evisasHref} rel="sponsored nofollow noopener" target="_blank">
      <span class="q-ic" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14" height="17" rx="2" stroke="currentColor" stroke-width="1.9"/><path d="M9 8.5h6M9 12h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M9.2 16.4l1.6 1.6 3-3.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="q-main">
        <span class="q-name">eVisas</span>
        <span class="q-sub">{T('shelf_q_ev_sub')}</span>
      </span>
      <span class="partner-tag">{T('partner_tag')}</span>
      <span class="q-arr" aria-hidden="true">→</span>
    </a>
    <div class="alt-line">
      <p class="alt-text">
        <span class="alt-k">{T('shelf_alt_k')}</span> — {T('shelf_alt_p')}<span class="partner-tag">{T('partner_tag')}</span>
      </p>
      <a class="alt-link" data-offer={`visahq-${pos}`} href="https://www.visahq.co.uk/?a_aid=vaff18633" rel="sponsored nofollow noopener" target="_blank">{T('shelf_alt_cta')} <span class="arr">→</span></a>
    </div>
    )}
    {status === 'T' && (
    <a class="qrow" data-offer={`evisas-${pos}`} href={evisasHref} rel="sponsored nofollow noopener" target="_blank">
      <span class="q-ic" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14" height="17" rx="2" stroke="currentColor" stroke-width="1.9"/><path d="M9 8.5h6M9 12h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M9.2 16.4l1.6 1.6 3-3.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="q-main">
        <span class="q-name">eVisas</span>
        <span class="q-sub">{T('shelf_q_ta_sub')}</span>
      </span>
      <span class="partner-tag">{T('partner_tag')}</span>
      <span class="q-arr" aria-hidden="true">→</span>
    </a>
    )}
    <a class="qrow" data-offer={`safetywing-${pos}`} href="https://safetywing.com/nomad-insurance?referenceID=26624375&utm_source=26624375&utm_medium=Ambassador" rel="sponsored nofollow noopener" target="_blank">
      <span class="q-ic" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3.2 19 5.8v5.4c0 4.4-2.9 7.4-7 9.3-4.1-1.9-7-4.9-7-9.3V5.8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M12 8.2v5.6M9.2 11h5.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
      </span>
      <span class="q-main">
        <span class="q-name">SafetyWing</span>
        <span class="q-sub">{T('shelf_q_ins_sub')}</span>
      </span>
      <span class="partner-tag">{T('partner_tag')}</span>
      <span class="q-arr" aria-hidden="true">→</span>
    </a>
    <a class="qrow" data-offer={`worldnomads-${pos}`} href="https://www.kqzyfj.com/click-101912829-15736546" rel="sponsored nofollow noopener" target="_blank">
      <span class="q-ic" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3.5 18.5 9.8 8l3.4 4.9 2.3-3.1 5 8.7Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><circle cx="17.2" cy="6.2" r="1.7" stroke="currentColor" stroke-width="1.9"/></svg>
      </span>
      <span class="q-main">
        <span class="q-name">World Nomads</span>
        <span class="q-sub">{T('shelf_q_wn_sub')}</span>
      </span>
      <span class="partner-tag">{T('partner_tag')}</span>
      <span class="q-arr" aria-hidden="true">→</span>
    </a>
    <a class="qrow" data-offer={`airalo-${pos}`} href="https://airalo.tpx.lt/GU9747nV" rel="sponsored nofollow noopener" target="_blank">
      <span class="q-ic" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4.5 10.3a11 11 0 0 1 15 0M7.3 13.7a6.8 6.8 0 0 1 9.4 0" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><circle cx="12" cy="17.4" r="1.4" fill="currentColor"/></svg>
      </span>
      <span class="q-main">
        <span class="q-name">Airalo</span>
        <span class="q-sub">{T('shelf_q_esim_sub')}</span>
      </span>
      <span class="q-arr" aria-hidden="true">→</span>
    </a>
  </div>
</section>
)}
