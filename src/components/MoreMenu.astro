---
// "More" menu in the header (discovery plan D1). One button + popup
// panel, modelled on LangSwitcher: the panel is the site's full feature
// list in two groups, so on mobile — where the word nav is hidden —
// this is the navigation. Feature names come from the feat_* message
// keys, the single frozen name per feature shared by the header, this
// panel, the home tool cards, the ExploreMore strip and the footer
// (plan rule R3). Links go through hrefFor + the availability manifest,
// so every entry lands on the current locale's version where one
// exists (changelog is English-only by design and falls back as-is).
import { t as i18nT, hrefFor, type LocaleCode } from '../i18n/locales';
import availabilityRaw from '../i18n/availability.json';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const T = i18nT(locale);
const availability = availabilityRaw as Record<string, string[]>;
const href = (p: string) => hrefFor(locale, p, availability);

const groups = [
  {
    heading: T('more_h_explore'),
    items: [
      { path: '/compare/', label: T('feat_compare') },
      { path: '/passport-ranking/', label: T('feat_ranking') },
      { path: '/visa-policy-changes/', label: T('feat_policy') },
    ],
  },
  {
    heading: T('more_h_site'),
    items: [
      { path: '/widget/', label: T('feat_widget') },
      { path: '/for-business/', label: T('feat_business') },
      { path: '/about/', label: T('footer_about_data') },
      { path: '/changelog/', label: T('nav_changelog') },
    ],
  },
];
---

<div class="more-menu" data-more-menu>
  <button
    type="button"
    class="more-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={T('nav_more')}
  >
    <span>{T('nav_more')}</span>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9.5l7 7 7-7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <div class="more-panel" hidden>
    {groups.map((g) => (
      <div class="more-group">
        <p class="more-h">{g.heading}</p>
        <ul>
          {g.items.map((it) => (
            <li><a class="more-item" href={href(it.path)}>{it.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    if (window.__vfMoreBound) return;
    window.__vfMoreBound = true;
    var root = document.querySelector('[data-more-menu]');
    if (!root) return;
    var btn = root.querySelector('.more-btn');
    var panel = root.querySelector('.more-panel');
    function close() {
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    }
    function open() {
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
    }
    btn.addEventListener('click', function () {
      if (panel.hidden) open(); else close();
    });
    document.addEventListener('click', function (e) {
      if (!panel.hidden && !root.contains(e.target)) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>

<style>
  .more-menu { position: relative; flex: none; }
  .more-btn {
    display: inline-flex; align-items: center; gap: 5px;
    min-height: 40px; padding: 9px 11px; border: none; border-radius: 8px;
    background: transparent; color: var(--ink-2); cursor: pointer;
    font-family: inherit; font-size: 15px; font-weight: 600; white-space: nowrap;
    transition: background-color .16s var(--ease), color .16s var(--ease);
    touch-action: manipulation;
  }
  .more-btn:hover { background: rgba(10, 37, 64, .05); color: var(--ink); }
  .more-btn svg { flex: none; opacity: .75; }
  .more-panel {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 90;
    width: 268px; margin: 0; padding: 10px 8px 6px;
    background: #fff; border: 1px solid var(--line); border-radius: 14px;
    box-shadow: var(--sh-lg);
  }
  .more-group { margin: 0 0 6px; }
  .more-h {
    margin: 2px 10px 4px; font-size: 11.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .08em; color: var(--muted);
  }
  .more-group ul { list-style: none; margin: 0; padding: 0; }
  .more-group li { margin: 0; }
  .more-item {
    display: flex; align-items: center;
    min-height: 40px; padding: 8px 10px; border-radius: 9px;
    color: var(--ink); font-size: 15px; white-space: nowrap;
  }
  .more-item:hover { text-decoration: none; background: var(--soft); }
  /* Mobile: the panel becomes a full-width sheet under the header (the
     component root goes static so the panel anchors to the header). */
  @media (max-width: 640px) {
    .more-menu { position: static; }
    .more-btn { padding: 9px 7px; }
    .more-panel { left: 10px; right: 10px; width: auto; top: calc(var(--header-h) + 4px); }
  }
</style>
