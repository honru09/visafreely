---
// Stamp mark — a passport-stamp ring with a check. Pure inline SVG.
interface Props { size?: number; class?: string }
const { size = 34, class: cls = '' } = Astro.props;
---
<svg class={`stampmark ${cls}`} width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <g transform="rotate(-4 24 24)">
    <rect x="4" y="4" width="40" height="40" rx="10" stroke="currentColor" stroke-width="2.6"/>
    <rect x="9.5" y="9.5" width="29" height="29" rx="6.5" stroke="currentColor" stroke-width="1.3" opacity="0.55"/>
    <path d="M16.5 24.5 L22 30 L32 18.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
<style>
  .stampmark { color: var(--brand); flex: none; }
  .stampmark.light { color: #7fd1ae; }
</style>
