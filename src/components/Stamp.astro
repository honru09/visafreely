---
// Stamp — visafreely's brand mark: a passport entry stamp whose centre glyph is
// a "V" drawn as a checkmark (Visa + Verified in one path: the right arm
// overshoots the cap line like a tick). Two variants:
//   mark — squircle stamp for header / footer / favicon contexts
//   seal — circular stamp with ring text, for verdict moments (pair pages, about)
// Ring + text take `currentColor` (set color via CSS or the `ink` prop); the
// check takes var(--check) so contexts can give it the stamp-green accent.
interface Props {
  variant?: 'mark' | 'seal';
  state?: 'verified' | 'pending';
  size?: number;
  class?: string;
  ink?: string;
}
const { variant = 'mark', state = 'verified', size = 34, class: cls = '', ink } = Astro.props;
// Ring text is illegible below ~72px: render a simplified seal (rings + glyph only).
const simpleSeal = variant === 'seal' && size < 72;
const uid = Math.random().toString(36).slice(2, 9);
const topId = `st-${uid}`;
const botId = `sb-${uid}`;
const style = ink ? `color:${ink}` : undefined;
---

{
  variant === 'mark' ? (
    <svg
      class={`stamp-svg ${cls}`}
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      style={style}
      aria-hidden="true"
      focusable="false"
    >
      <g transform="rotate(-6 24 24)">
        <rect x="5" y="5" width="38" height="38" rx="11" stroke="currentColor" stroke-width="3" />
        <rect x="10.5" y="10.5" width="27" height="27" rx="7.5" stroke="currentColor" stroke-width="1.4" opacity="0.55" />
        <path
          class="stamp-check"
          d="M15.5 17L23 30.5L33.5 13.5"
          stroke="var(--check, currentColor)"
          stroke-width="3.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  ) : (
    <svg
      class={`stamp-svg seal-svg ${cls}`}
      width={size}
      height={size}
      viewBox="0 0 96 96"
      fill="none"
      style={style}
      aria-hidden="true"
      focusable="false"
    >
      {!simpleSeal && (
        <defs>
          <path id={topId} d="M11.5,48 a36.5,36.5 0 0,1 73,0" fill="none" />
          <path id={botId} d="M4.8,48 a43.2,43.2 0 0,0 86.4,0" fill="none" />
        </defs>
      )}
      <g transform="rotate(-8 48 48)">
        <g opacity="0.16" transform="translate(1.6 1.2)">
          <circle cx="48" cy="48" r="45" stroke="currentColor" stroke-width="2.6" fill="none" />
        </g>
        <circle
          cx="48"
          cy="48"
          r="45"
          stroke="currentColor"
          stroke-width="2.6"
          fill="none"
          stroke-dasharray={state === 'pending' ? '5 4' : undefined}
        />
        <circle cx="48" cy="48" r="33.5" stroke="currentColor" stroke-width="1.3" opacity="0.55" fill="none" />
        {!simpleSeal && (
          <>
            <text class="seal-text" fill="currentColor">
              <textPath href={`#${topId}`} startOffset="50%" text-anchor="middle">
                VISAFREELY
              </textPath>
            </text>
            <text class="seal-text" fill="currentColor">
              <textPath href={`#${botId}`} startOffset="50%" text-anchor="middle">
                {state === 'verified' ? '· VERIFIED ·' : 'NOT YET VERIFIED'}
              </textPath>
            </text>
          </>
        )}
        {state === 'verified' ? (
          <path
            class="stamp-check"
            d="M32 40L44.5 58L65 33"
            stroke="var(--check, currentColor)"
            stroke-width="5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        ) : (
          <g stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="48" cy="47" r="11" fill="none" />
            <path d="M48 39.5V47l5 3.4" fill="none" />
          </g>
        )}
      </g>
    </svg>
  )
}
<style>
  .stamp-svg {
    flex: none;
    display: block;
  }
  .seal-text {
    font-family: var(--font);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 2.2px;
  }
</style>
