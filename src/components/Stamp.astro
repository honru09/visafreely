---
// Stamp — visafreely's brand mark: Concept E2 "Stamped Passport" (a passport
// booklet with globe embossed on cover and a corner checkmark stamp).
// Two variants:
//   mark — E2 passport mark for header / footer / checker / watermark contexts
//   seal — circular stamp with ring text, for verdict moments (pair pages, about)
// Ring + text + booklet take `currentColor` (set color via CSS or the `ink` prop);
// the mark check takes var(--check, #0FA47A) so contexts can give it the stamp-green accent.
interface Props {
  variant?: 'mark' | 'seal';
  state?: 'verified' | 'pending';
  tone?: 'verified' | 'pending';
  size?: number;
  word?: string;
  class?: string;
  ink?: string;
}
const {
  variant = 'mark',
  state,
  tone,
  size = 34,
  word,
  class: cls = '',
  ink,
} = Astro.props;
const resolvedState = state ?? tone ?? 'verified';
// Ring text is illegible below ~72px: render a simplified seal (rings + glyph only).
const simpleSeal = variant === 'seal' && size < 72;
const uid = Math.random().toString(36).slice(2, 9);
const topId = `st-${uid}`;
const botId = `sb-${uid}`;
const style = ink ? `color:${ink}` : undefined;
const botWord = word ?? (resolvedState === 'verified' ? '· VERIFIED ·' : 'NOT YET VERIFIED');
---

{
  variant === 'mark' ? (
    <svg
      class={`stamp-svg ${cls}`}
      width={size}
      height={size}
      viewBox="11.90 3.90 50.60 56.20"
      fill="none"
      style={style}
      aria-hidden="true"
      focusable="false"
    >
      <rect
        x="16"
        y="8"
        width="32"
        height="48"
        rx="6"
        stroke="currentColor"
        stroke-width="3.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M21.5 14 V50"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle
        cx="34"
        cy="27.5"
        r="10.5"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <ellipse
        cx="34"
        cy="27.5"
        rx="4.2"
        ry="10.5"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M23.5 27.5 H44.5"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        class="stamp-check"
        d="M38 44 L45.5 52.5 L58 39"
        stroke="var(--check, currentColor)"
        stroke-width="4.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  ) : (
    <svg
      class={`stamp-svg seal-svg ${cls}`}
      width={size}
      height={size}
      viewBox="0 0 96 96"
      fill="none"
      style={style}
      aria-hidden="true"
      focusable="false"
    >
      {!simpleSeal && (
        <defs>
          <path id={topId} d="M11.5,48 a36.5,36.5 0 0,1 73,0" fill="none" />
          <path id={botId} d="M4.8,48 a43.2,43.2 0 0,0 86.4,0" fill="none" />
        </defs>
      )}
      <g transform="rotate(-8 48 48)">
        <g opacity="0.16" transform="translate(1.6 1.2)">
          <circle cx="48" cy="48" r="45" stroke="currentColor" stroke-width="2.6" fill="none" />
        </g>
        <circle
          cx="48"
          cy="48"
          r="45"
          stroke="currentColor"
          stroke-width="2.6"
          fill="none"
          stroke-dasharray={resolvedState === 'pending' ? '5 4' : undefined}
        />
        <circle cx="48" cy="48" r="33.5" stroke="currentColor" stroke-width="1.3" opacity="0.55" fill="none" />
        {!simpleSeal && (
          <>
            <text class="seal-text" fill="currentColor">
              <textPath href={`#${topId}`} startOffset="50%" text-anchor="middle">
                VISAFREELY
              </textPath>
            </text>
            <text class="seal-text" fill="currentColor">
              <textPath href={`#${botId}`} startOffset="50%" text-anchor="middle">
                {botWord}
              </textPath>
            </text>
          </>
        )}
        <g
          transform="translate(48 48.8) scale(0.58) translate(-37.2 -32)"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="16" y="8" width="32" height="48" rx="6" stroke-width="3.8" />
          <path d="M21.5 14 V50" stroke-width="2" />
          <circle cx="34" cy="27.5" r="10.5" stroke-width="2.4" />
          <ellipse cx="34" cy="27.5" rx="4.2" ry="10.5" stroke-width="2.2" />
          <path d="M23.5 27.5 H44.5" stroke-width="2.2" />
          <path
            class="stamp-check"
            d="M38 44 L45.5 52.5 L58 39"
            stroke="var(--check, currentColor)"
            stroke-width="4.6"
          />
        </g>
      </g>
    </svg>
  )
}
<style>
  .stamp-svg {
    flex: none;
    display: block;
  }
  .seal-text {
    font-family: var(--font);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 2.2px;
  }
</style>
