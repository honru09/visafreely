---
import Base from '../layouts/Base.astro';
import ShareRow from '../components/ShareRow.astro';
import policyChanges from '../data/policy-changes.json';
import {
  countries,
  countryByCode,
  formatDateLong,
  pairRow,
  pairExtra,
  pairPath,
  verdictText,
  easyAccessCount,
  flagEmoji,
} from '../lib/data';

interface Change {
  date: string;
  destination: string;
  passport?: string;
  title: string;
  summary: string;
  source: string;
  source_name: string;
}
function sourceHost(source: string): string {
  try {
    return new URL(source).hostname.replace(/^www\./, '');
  } catch {
    return source;
  }
}
interface RouteLink {
  href: string;
  flag: string;
  name: string;
  meta: string;
  status: string;
}
/** Affected routes for one entry (B6, 2026-11-13). An entry that names a
 *  passport links that exact pair first — it is the route the change hit.
 *  Remaining slots (max 3 total) follow the destination HubStrip rule:
 *  passports needing paperwork (E/T/R) for this destination, verified pairs
 *  first, then dataset reach, then name. No routes are invented: when the
 *  destination is not in the dataset the entry gets no route links. */
function affectedRoutes(e: Change): RouteLink[] {
  const dc = countryByCode[e.destination];
  if (!dc) return [];
  const out: { code: string; name: string; row: NonNullable<ReturnType<typeof pairRow>> }[] = [];
  if (e.passport && countryByCode[e.passport]) {
    const r = pairRow(e.passport, e.destination);
    if (r) out.push({ code: e.passport, name: countryByCode[e.passport].name, row: r });
  }
  const rest = countries
    .filter((x) => x.code !== e.destination && !out.some((o) => o.code === x.code))
    .map((x) => ({ x, r: pairRow(x.code, e.destination) }))
    .filter((y) => y.r && (y.r.s === 'E' || y.r.s === 'T' || y.r.s === 'R'))
    .sort((a, b) => {
      const va = pairExtra(a.x.code, e.destination).verified ? 0 : 1;
      const vb = pairExtra(b.x.code, e.destination).verified ? 0 : 1;
      if (va !== vb) return va - vb;
      const ea = easyAccessCount(a.x.code);
      const eb = easyAccessCount(b.x.code);
      if (ea !== eb) return eb - ea;
      return a.x.name < b.x.name ? -1 : 1;
    });
  for (const y of rest) {
    if (out.length >= 3) break;
    out.push({ code: y.x.code, name: y.x.name, row: y.r! });
  }
  return out.map((o) => ({
    href: pairPath(countryByCode[o.code], dc),
    flag: flagEmoji(o.code),
    name: o.name,
    meta: verdictText(o.row),
    status: o.row.s,
  }));
}
const entries = (policyChanges as Change[])
  .slice()
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .map((e) => {
    const dc = countryByCode[e.destination];
    return {
      ...e,
      destName: dc?.name || e.destination,
      destHref: dc ? `/destination/${dc.slug}/` : null,
      host: sourceHost(e.source),
      routes: affectedRoutes(e),
    };
  });
---

<Base
  title="Visa Policy Changes — Tracked & Verified | visafreely"
  description="The visa rule changes that actually took effect — new exemptions, e-Visa mandates, suspensions and fee changes — each one read in the official gazette, ministry notice or government portal that issued it, with the date it took effect."
>
  <h1>Visa policy changes</h1>
  <p class="lede">
    Visa rules change constantly, and most datasets notice months later. This page tracks the changes
    themselves — a new exemption, an e-Visa mandate, a suspension, a fee reform — on the date each one
    took effect, with the official text it comes from.
  </p>
  <p>
    <strong>{entries.length} changes tracked since March 2025.</strong> How this page is built: every
    entry below was read in the official source named on it — a government gazette, a ministry
    communiqué, an immigration authority's own portal — while verifying that destination's rules pair by
    pair. Announced-but-not-in-force measures are not listed as changes; where a change is temporary or
    residence-based, the entry says so. For the pair-level record of what we corrected in our own data,
    see the <a href="/changelog/">data changelog</a>.
  </p>

  <ShareRow
    url="https://visafreely.com/visa-policy-changes/"
    text="Visa policy changes, tracked from the official source on the date each one takes effect:"
    label="Share this tracker"
  />
  <p class="muted small">
    Run a travel site or newsletter? This tracker and the route checker are free to reuse:
    <a href="/widget/">embed the checker</a> or build on the
    <a href="https://github.com/honru09/visa-requirements-dataset" rel="noopener" target="_blank">open dataset</a>.
  </p>

  <div class="timeline">
    {entries.map((e) => (
      <article class="tl-entry">
        <div class="tl-date">{formatDateLong(e.date)}</div>
        <div class="tl-card">
          {e.destHref
            ? <a class="pair-chip" href={e.destHref}>{e.destName} — current rules</a>
            : <span class="pair-chip">{e.destName}</span>}
          <h3>{e.title}</h3>
          <p>{e.summary}</p>
          {e.routes.length > 0 && (
            <div class="tl-routes">
              <span class="tl-routes-label">Affected routes</span>
              {e.routes.map((r) => (
                <a class="tl-route" href={r.href}>
                  <span class={`sdot ${r.status}`} aria-hidden="true"></span>
                  <span aria-hidden="true">{r.flag}</span> {r.name}
                  <span class="tl-route-meta">{r.meta}</span>
                </a>
              ))}
            </div>
          )}
          <p>
            <a class="source-chip" href={e.source} rel="noopener" target="_blank">Official source: {e.host}</a>
          </p>
        </div>
      </article>
    ))}
  </div>

  <div class="closing-band">
    <h2>Rules change — hear about the next one</h2>
    <p style="max-width:560px;margin:0 auto;">
      Every change above was read in the official text on the date it took effect.
      Leave an email address and we will tell you when the next tracked change is published.
    </p>
    <form id="route-alert-form" style="margin:20px auto 0;max-width:520px;">
      <label for="route-alert-email" style="display:block;font-weight:600;color:#fff;margin-bottom:8px;">Get an email when a tracked visa rule changes</label>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
        <input id="route-alert-email" type="email" required placeholder="you@example.com" autocomplete="email"
          style="flex:1 1 240px;max-width:340px;padding:11px 14px;border-radius:10px;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.1);color:#fff;font-size:15px;" />
        <button type="submit" class="btn on-dark" style="cursor:pointer;">Alert me</button>
      </div>
      <p id="route-alert-status" hidden style="margin:10px auto 0;color:#bfe3cd;font-size:14px;"></p>
    </form>
    <script is:inline>
      (function () {
        var form = document.getElementById('route-alert-form');
        if (!form) return;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = document.getElementById('route-alert-email').value.trim();
          var status = document.getElementById('route-alert-status');
          fetch('https://honru09--site-stats-web.us-east.modal.run/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ site: 'visafreely', email: email, route: location.pathname })
          }).then(function (r) {
            status.hidden = false;
            if (r.ok) {
              status.textContent = 'You are on the list — we will email you when the next tracked change is published.';
              form.querySelector('button').disabled = true;
            } else {
              status.textContent = 'That email did not go through — please check it and try again.';
            }
          }).catch(function () {
            status.hidden = false;
            status.textContent = 'Could not reach the signup service — please try again later.';
          });
        });
      })();
    </script>
  </div>

  <style>
    .tl-routes { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 9px 0 7px; }
    .tl-routes-label {
      font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em;
      color: var(--gold-ink); margin-right: 2px;
    }
    .tl-route {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px;
      background: var(--soft); color: var(--ink); font-size: 13px; font-weight: 700;
    }
    a.tl-route:hover { text-decoration: none; border-color: var(--brand); background: var(--f-bg); }
    .tl-route-meta { font-weight: 500; color: var(--muted); }
    @media (max-width: 720px) {
      .tl-route { font-size: 13px; padding: 4px 10px; min-height: 40px; }
      .tl-route-meta { display: none; }
    }
  </style>
</Base>
