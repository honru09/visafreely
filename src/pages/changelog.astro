---
import Base from '../layouts/Base.astro';
import changelog from '../data/changelog.json';
import { countryByCode, pairPath, formatDateLong } from '../lib/data';

interface Entry {
  date: string;
  pair: string | null;
  title: string;
  old: string | null;
  new: string | null;
  reason: string;
  source: string | null;
}
const rawEntries = changelog as Entry[];
function sourceHost(source: string): string {
  try {
    return new URL(source).hostname.replace(/^www\./, '');
  } catch {
    return source;
  }
}
const entries = rawEntries.map((e) => {
  let pairLabel: string | null = null;
  let pairHref: string | null = null;
  if (e.pair) {
    const [p, d] = e.pair.split(':');
    const pc = countryByCode[p];
    const dc = countryByCode[d];
    if (pc && dc) {
      pairLabel = `${pc.name} → ${dc.name}`;
      pairHref = pairPath(pc, dc);
    } else {
      pairLabel = `${pc?.name || p} → ${dc?.name || d}`;
    }
  }
  return { ...e, pairLabel, pairHref, host: e.source ? sourceHost(e.source) : null };
});
---

<Base
  title="Data Changelog — visafreely"
  description="Every correction and verification applied to visafreely's visa data, with dates, old and new values, and the official source behind each change."
>
  <h1>Data changelog</h1>
  <p class="lede">
    Visa rules change constantly, and datasets go stale quietly. This page is the public record of every
    correction we apply: what changed, when, and which official source says so.
  </p>
  <p>
    <strong>{entries.length} corrections published.</strong> How to read this page: newest first — each
    entry shows the pair, the old value and the new value as pills, why it changed, and the official
    source behind the change. Click a pair to open its requirement page.
  </p>
  <p>
    Pairs that have been individually checked against an official source show a “Last verified” date on
    their page. Everything else is labelled with the underlying dataset's date (February 2026 snapshot)
    rather than a claim we have not earned. If you spot an error, the changelog is also how you can tell
    whether it is already fixed.
  </p>

  <div class="timeline">
    {entries.map((e) => (
      <article class="tl-entry">
        <div class="tl-date">{formatDateLong(e.date)}</div>
        <div class="tl-card">
          {e.pairLabel && (
            e.pairHref
              ? <a class="pair-chip" href={e.pairHref}>{e.pairLabel}</a>
              : <span class="pair-chip">{e.pairLabel}</span>
          )}
          <h3>{e.title}</h3>
          {e.old && e.new && (
            <p>
              <span class="pill-old">{e.old}</span> → <span class="pill-new">{e.new}</span>
            </p>
          )}
          <p>{e.reason}</p>
          {e.source && (
            <p>
              <a class="source-chip" href={e.source} rel="noopener" target="_blank">Official source: {e.host}</a>
            </p>
          )}
        </div>
      </article>
    ))}
  </div>
</Base>
