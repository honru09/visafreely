---
import Base from '../../layouts/Base.astro';
import {
  countries,
  countryByCode,
  groupedForDestination,
  statusLabel,
  pairPath,
  flagEmoji,
} from '../../lib/data';

export function getStaticPaths() {
  return countries.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const groups = groupedForDestination(c.code);
const countOf = (code: string) => groups.find((g) => g.code === code)?.passports.length || 0;
const freeCount = countOf('F');
const title = `${c.name} Visa Requirements: Who Can Enter & How`;
const description = `Visa requirements for visiting ${c.name}: ${freeCount} passports enter visa free. Full list by requirement — visa free, on arrival, e-Visa, ETA and visa required.`;
const others = countries.filter((x) => x.code !== c.code);
const total = groups.reduce((n, g) => n + g.passports.length, 0);
---

<Base title={title} description={description}>
  <section class="band light">
    <div class="band-in">
      <div class="crumbs"><a href="/destinations/">All destinations</a></div>
      <h1>Visiting {c.name}</h1>
      <p class="lede" style="margin-bottom:0;">
        <strong>{freeCount} passports</strong> can enter {c.name} visa free. Below is the requirement for
        every passport we track, grouped by type — open any pair for stay limits and verification status.
      </p>
    </div>
  </section>

  <div class="stat-band five">
    <div class="stat-tile"><b>{freeCount}</b><span>passports enter visa free</span></div>
    <div class="stat-tile"><b>{countOf('A')}</b><span>visa on arrival</span></div>
    <div class="stat-tile"><b>{countOf('E')}</b><span>e-Visa</span></div>
    <div class="stat-tile"><b>{countOf('T')}</b><span>ETA</span></div>
    <div class="stat-tile"><b>{countOf('R')}</b><span>visa required</span></div>
  </div>

  <div data-filter-root>
    <div class="filter-chips" role="group" aria-label="Filter passports by requirement">
      <button type="button" class="fchip on" data-filter="all" aria-pressed="true">All<span class="fcount">{total}</span></button>
      {groups.map((g) => (
        <button type="button" class={`fchip s-${g.code}`} data-filter={g.code} aria-pressed="false">
          <span class={`sdot ${g.code}`}></span>{statusLabel(g.code)}<span class="fcount">{g.passports.length}</span>
        </button>
      ))}
    </div>

    {groups.map((g) => (
      <section data-status={g.code}>
        <h2>{statusLabel(g.code)}<span class="count-pill">{g.passports.length}</span></h2>
        <div class="route-grid">
          {g.passports.map((x) => (
            <a class="route-card" href={pairPath(countryByCode[x.p], c)}>
              <span class="rc-top"><span class="rc-flag" aria-hidden="true">{flagEmoji(x.p)}</span><span class={`sdot ${g.code}`}></span><span class="rc-name">{countryByCode[x.p].name}</span></span>
              <span class="rc-meta">{x.days ? `${x.days} days` : statusLabel(g.code)}</span>
              <svg class="rc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <h2>Other destinations</h2>
  <div class="pill-cloud">
    {others.slice(0, 40).map((x) => (
      <a href={`/destination/${x.slug}/`}>{x.name}</a>
    ))}
    <a href="/destinations/">See all {countries.length} destinations →</a>
  </div>
</Base>
