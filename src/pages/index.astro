---
import Base from '../layouts/Base.astro';
import {
  countries,
  countryBySlug,
  easyAccessCount,
  visaFreePassportCount,
  verifiedCount,
  changelogCount,
  passportsByEasy,
  statusLabel,
  STATUS_ORDER,
  STATUS_BLURB,
  STATUS_GLYPH,
  data,
} from '../lib/data';

const ranked = passportsByEasy.slice(0, 10);
const maxEasy = ranked[0]?.easy || 1;
const popularPassports = ['united-states', 'united-kingdom', 'japan', 'germany', 'canada', 'australia', 'singapore', 'france']
  .map((slug) => countryBySlug[slug])
  .filter(Boolean);
const popularDestinations = ['thailand', 'japan', 'united-states', 'france', 'united-arab-emirates', 'turkiye', 'vietnam', 'united-kingdom']
  .map((slug) => countryBySlug[slug])
  .filter(Boolean);
const popularRoutes = [
  ['japan', 'thailand'],
  ['united-states', 'japan'],
  ['china', 'singapore'],
  ['united-states', 'united-kingdom'],
  ['germany', 'thailand'],
  ['australia', 'indonesia'],
]
  .map(([ps, ds]) => ({ p: countryBySlug[ps], d: countryBySlug[ds] }))
  .filter((r) => r.p && r.d);
const pairCountFmt = data.pairCount.toLocaleString('en-US');
const verifiedFmt = verifiedCount.toLocaleString('en-US');
const correctionsFmt = changelogCount.toLocaleString('en-US');
---

<Base
  title="Visa Requirements Checker — Do You Need a Visa? | visafreely"
  description="Check visa requirements for 199 passports and 39,402 country pairs: visa free, visa on arrival, e-Visa, ETA or visa required — with per-pair verification dates."
>
  <section class="band dark">
    <div class="hero-wm" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><g transform="rotate(-4 24 24)"><rect x="4.5" y="4.5" width="39" height="39" rx="10" stroke="currentColor" stroke-width="1.6"/><rect x="10" y="10" width="28" height="28" rx="6.5" stroke="currentColor" stroke-width="0.9"/><path d="M16 24.5l5.5 5.5L32 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
    </div>
    <div class="band-in">
      <h1 class="h-display">Do you need a visa? Get the answer — and the evidence.</h1>
      <p class="lede">
        {countries.length} passports · {pairCountFmt} routes. Every answer shows when it was last
        checked against an official source — or says plainly that it hasn't been yet.
      </p>
      <div class="checker-card" id="checker" style="scroll-margin-top:76px;">
        <form id="ck-form" class="checker" aria-label="Visa requirement checker">
          <label>
            I hold a passport from
            <input id="ck-passport" list="ck-passport-list" placeholder="Start typing a country…" autocomplete="off" required />
            <datalist id="ck-passport-list"></datalist>
          </label>
          <button type="button" id="ck-swap" class="swap-btn" aria-label="Swap passport and destination" title="Swap">⇄</button>
          <label>
            I want to visit
            <input id="ck-destination" list="ck-destination-list" placeholder="Start typing a country…" autocomplete="off" required />
            <datalist id="ck-destination-list"></datalist>
          </label>
          <button type="submit" class="go-btn">Check</button>
        </form>
        <div id="ck-result" class="instant-verdict" hidden></div>
      </div>
      <div class="route-chips">
        <span class="rc-label">Popular routes:</span>
        {popularRoutes.map((r) => (
          <button type="button" class="route-chip" data-p={r.p.name} data-d={r.d.name}>{r.p.name} → {r.d.name}</button>
        ))}
      </div>
      <p class="hero-note">
        visafreely is a free information service, not a government agency. Every answer links to its evidence.
      </p>
    </div>
  </section>

  <div class="stat-band">
    <div class="stat-tile"><b>{countries.length}</b><span>passports covered</span></div>
    <div class="stat-tile"><b>{pairCountFmt}</b><span>passport → destination pairs</span></div>
    <div class="stat-tile"><b>{verifiedFmt}</b><span>pairs verified against official sources</span></div>
    <div class="stat-tile"><b>{correctionsFmt}</b><span>corrections published</span></div>
  </div>

  <h2>How it works</h2>
  <div class="how-grid">
    <div class="how-card">
      <span class="num">1</span>
      <h3>Check the route</h3>
      <p>Pick a passport and a destination. You get the requirement and the maximum stay in one screen — no account, no paywall.</p>
    </div>
    <div class="how-card">
      <span class="num">2</span>
      <h3>Read the evidence</h3>
      <p>Every pair page carries one of two stamps: verified against an official source on a stated date, or honestly labelled as dataset-only. Nothing in between.</p>
      <div class="seal verified mini">
        <div class="seal-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><g transform="rotate(-4 24 24)"><rect x="4.5" y="4.5" width="39" height="39" rx="10" stroke="currentColor" stroke-width="2.6"/><rect x="10" y="10" width="28" height="28" rx="6.5" stroke="currentColor" stroke-width="1.3"/><path d="M16 24.5l5.5 5.5L32 19" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
        </div>
        <div>
          <p class="seal-title">✓ Verified — last checked 25 Oct 2026</p>
          <p>Example stamp. Each one names its official source and links to it.</p>
        </div>
      </div>
    </div>
    <div class="how-card">
      <span class="num">3</span>
      <h3>Travel</h3>
      <p>Follow the “What to do next” steps on the pair page — apply ahead where the status requires it, or just go where it doesn't.</p>
    </div>
  </div>

  <h2>Checked data vs copied data</h2>
  <div class="contrast">
    <div class="contrast-card bad">
      <h3>Most visa sites</h3>
      <ul>
        <li>Copy one dataset and never re-check it</li>
        <li>No date on any answer — fresh and stale look identical</li>
        <li>Errors fixed silently, if at all</li>
        <li>Expiry dates on temporary rules never shown</li>
      </ul>
    </div>
    <div class="contrast-card good">
      <h3>visafreely</h3>
      <ul>
        <li>A verified date and a named official source on {verifiedFmt} pairs — and counting</li>
        <li>Every correction published in a public <a href="/changelog/">changelog</a>: old value, new value, source</li>
        <li>Announced end dates shown as “Scheduled change” warnings on the pair page</li>
        <li>Unverified pairs labelled plainly, never dressed up</li>
      </ul>
    </div>
  </div>

  <h2>Most powerful passports right now</h2>
  <p class="muted small">Ranked by the number of destinations reachable without applying for a visa in advance (visa free + on arrival + e-Visa + ETA).</p>
  <div class="rank-rows">
    {ranked.map((r, i) => (
      <div class="rank-row">
        <span class={`rank-medal${i < 3 ? ' top' : ''}`}>{i + 1}</span>
        <a class="rr-name" href={`/passport/${r.c.slug}/`}>{r.c.name}</a>
        <span class="bar" aria-hidden="true"><i style={`width:${Math.round((r.easy / maxEasy) * 100)}%`}></i></span>
        <span class="rr-count">{r.easy} without a prior visa · {r.free} fully visa free</span>
      </div>
    ))}
  </div>

  <h2>Popular passports</h2>
  <div class="route-grid">
    {popularPassports.map((c) => (
      <a class="route-card" href={`/passport/${c.slug}/`}>
        <span class="rc-name">{c.name} passport</span>
        <span class="rc-meta">{easyAccessCount(c.code)} destinations without a prior visa — where can you go?</span>
      </a>
    ))}
  </div>

  <h2>Popular destinations</h2>
  <div class="route-grid">
    {popularDestinations.map((c) => (
      <a class="route-card" href={`/destination/${c.slug}/`}>
        <span class="rc-name">{c.name}</span>
        <span class="rc-meta">{visaFreePassportCount(c.code)} passports enter visa free — who can enter, and how?</span>
      </a>
    ))}
  </div>

  <h2>How to read a result</h2>
  <div class="legend-grid">
    {STATUS_ORDER.map((code) => (
      <div class="legend-card">
        <span class={`chip ${code}`}><span class="g"><i>{STATUS_GLYPH[code]}</i></span>{statusLabel(code)}</span>
        <p>{STATUS_BLURB[code]}</p>
      </div>
    ))}
  </div>
  <p>
    Most visa sites quietly copy one dataset and never check it. We show our work: pairs checked against
    an official source carry a “Last verified” date and a link to that source, corrections are published
    in the <a href="/changelog/">data changelog</a>, and everything else is honestly labelled with the
    dataset's own date. <a href="/about/">How verification works →</a>
  </p>

  <div class="closing-band">
    <h2>Spot an error?</h2>
    <p class="muted" style="max-width:560px;margin:0 auto 14px;">
      If a page here disagrees with an official source, that is exactly the feedback the changelog runs
      on — every confirmed discrepancy becomes a published correction with its source attached.
    </p>
    <a class="btn" href="/changelog/">See the corrections</a>{' '}
    <a class="btn" href="/about/" style="background:var(--brand-ink);">How we verify</a>
  </div>

  <script is:inline>
    (function () {
      var form = document.getElementById('ck-form');
      var inP = document.getElementById('ck-passport');
      var inD = document.getElementById('ck-destination');
      var listP = document.getElementById('ck-passport-list');
      var listD = document.getElementById('ck-destination-list');
      var out = document.getElementById('ck-result');
      var swap = document.getElementById('ck-swap');
      swap.addEventListener('click', function () {
        var t = inP.value; inP.value = inD.value; inD.value = t; inP.focus();
      });
      fetch('/check.json')
        .then(function (r) { return r.json(); })
        .then(function (idx) {
          var byName = {};
          var byCode = {};
          idx.countries.forEach(function (c) {
            byName[c.name.toLowerCase()] = c;
            byCode[c.code] = c;
            var o1 = document.createElement('option'); o1.value = c.name; listP.appendChild(o1);
            var o2 = document.createElement('option'); o2.value = c.name; listD.appendChild(o2);
          });
          function resolve(input) {
            var v = input.value.trim().toLowerCase();
            if (!v) return null;
            if (byName[v]) return byName[v];
            for (var i = 0; i < idx.countries.length; i++) {
              if (idx.countries[i].name.toLowerCase().indexOf(v) === 0) return idx.countries[i];
            }
            return null;
          }
          function doCheck() {
            var pc = resolve(inP), dc = resolve(inD);
            out.hidden = false;
            if (!pc || !dc) {
              out.className = 'instant-verdict';
              out.innerHTML = '<div class="big">Pick both countries from the list</div><div class="muted">Start typing and choose a passport and a destination.</div>';
              return;
            }
            if (pc.code === dc.code) {
              out.className = 'instant-verdict';
              out.innerHTML = '<div class="big">That is your own country</div><div class="muted">No visa is involved — you already live there.</div>';
              return;
            }
            var row = (idx.rows[pc.code] || []).find(function (r) { return idx.countries[r[0]].code === dc.code; });
            if (!row) { out.className = 'instant-verdict'; out.textContent = 'No data for this pair.'; return; }
            var label = idx.status[row[1]];
            var verdict = label;
            if (row[1] === 'F' && row[2]) verdict = 'Visa free for ' + row[2] + ' days';
            else if (row[1] === 'A' && row[2]) verdict = 'Visa on arrival (up to ' + row[2] + ' days)';
            else if (row[1] === 'E') verdict = 'e-Visa required before travel';
            else if (row[1] === 'T') verdict = 'Electronic travel authorisation required';
            out.className = 'instant-verdict s-' + row[1];
            out.innerHTML =
              '<div class="big">' + verdict + '</div>' +
              '<div class="muted">' + pc.name + ' passport → ' + dc.name + (row[2] ? ' · maximum stay ' + row[2] + ' days' : '') + '</div>' +
              '<p style="margin:12px 0 0"><a class="btn" href="/visa/' + pc.slug + '/' + dc.slug + '/">Full requirement page →</a></p>';
          }
          form.addEventListener('submit', function (ev) { ev.preventDefault(); doCheck(); });
          var chips = document.querySelectorAll('.route-chip');
          for (var i = 0; i < chips.length; i++) {
            chips[i].addEventListener('click', function () {
              inP.value = this.getAttribute('data-p');
              inD.value = this.getAttribute('data-d');
              doCheck();
              out.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            });
          }
        })
        .catch(function () { out.hidden = false; out.className = 'instant-verdict'; out.textContent = 'The checker could not load its index. Please use the passport pages instead.'; });
    })();
  </script>
</Base>
