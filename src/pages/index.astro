---
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import Checker from '../components/Checker.astro';
import {
  countries,
  countryBySlug,
  easyAccessCount,
  visaFreePassportCount,
  verifiedCount,
  changelogCount,
  passportsByEasy,
  statusLabel,
  STATUS_ORDER,
  STATUS_BLURB,
  STATUS_GLYPH,
  data,
} from '../lib/data';

const ranked = passportsByEasy.slice(0, 10);
const maxEasy = ranked[0]?.easy || 1;
const minEasy = ranked[ranked.length - 1]?.easy ?? 0;
// Rescale bars across the displayed top-10 range so close scores (185 vs 186) still read differently.
const barPct = (easy: number) =>
  maxEasy === minEasy ? 100 : Math.round(42 + ((easy - minEasy) / (maxEasy - minEasy)) * 58);
const popularPassports = ['united-states', 'united-kingdom', 'japan', 'germany', 'canada', 'australia', 'singapore', 'france']
  .map((slug) => countryBySlug[slug])
  .filter(Boolean);
const popularDestinations = ['thailand', 'japan', 'united-states', 'france', 'united-arab-emirates', 'turkiye', 'vietnam', 'united-kingdom']
  .map((slug) => countryBySlug[slug])
  .filter(Boolean);
const popularRoutes = [
  ['japan', 'thailand'],
  ['united-states', 'japan'],
  ['china', 'singapore'],
  ['united-states', 'united-kingdom'],
  ['germany', 'thailand'],
  ['australia', 'indonesia'],
]
  .map(([ps, ds]) => ({ p: countryBySlug[ps], d: countryBySlug[ds] }))
  .filter((r) => r.p && r.d);
const pairCountFmt = data.pairCount.toLocaleString('en-US');
const verifiedFmt = verifiedCount.toLocaleString('en-US');
const correctionsFmt = changelogCount.toLocaleString('en-US');
---

<Base
  title="Visa Requirements Checker — Do You Need a Visa? | visafreely"
  description="Check visa requirements for 199 passports and 39,402 country pairs: visa free, visa on arrival, e-Visa, ETA or visa required — with per-pair verification dates."
>
  <section class="band dark">
    <div class="hero-wm" aria-hidden="true"><Stamp size={330} /></div>
    <div class="band-in">
      <h1 class="h-display">Do you need a visa? Get the answer — and the evidence.</h1>
      <p class="lede">
        {countries.length} passports · {pairCountFmt} routes. Every answer shows when it was last
        checked against an official source — or says plainly that it hasn't been yet.
      </p>
      <Checker />
      <div class="route-chips">
        <span class="rc-label">Popular routes:</span>
        {popularRoutes.map((r) => (
          <button type="button" class="route-chip" data-p={r.p.name} data-d={r.d.name}>{r.p.name} → {r.d.name}</button>
        ))}
      </div>
      <p class="hero-note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>visafreely is a free information service, not a government agency. Every answer links to its evidence.</span>
      </p>
    </div>
  </section>

  <div class="stat-band">
    <div class="stat-tile"><b>{countries.length}</b><span>passports covered</span></div>
    <div class="stat-tile"><b>{pairCountFmt}</b><span>passport → destination pairs</span></div>
    <div class="stat-tile"><b>{verifiedFmt}</b><span>pairs verified against official sources</span></div>
    <div class="stat-tile"><b>{correctionsFmt}</b><span>corrections published</span></div>
  </div>

  <h2>How it works</h2>
  <div class="how-grid">
    <div class="how-card">
      <span class="num">1</span>
      <h3>Check the route</h3>
      <p>Pick a passport and a destination. You get the requirement and the maximum stay in one screen — no account, no paywall.</p>
    </div>
    <div class="how-card">
      <span class="num">2</span>
      <h3>Read the evidence</h3>
      <p>Every pair page carries one of two stamps: verified against an official source on a stated date, or honestly labelled as dataset-only. Nothing in between.</p>
      <div class="seal-block verified compact">
        <div class="seal-art" aria-hidden="true"><Stamp variant="seal" size={52} /></div>
        <div>
          <p class="seal-title">Verified — last checked 25 Oct 2026</p>
          <p>Example stamp. Each one names its official source and links to it.</p>
        </div>
      </div>
    </div>
    <div class="how-card">
      <span class="num">3</span>
      <h3>Travel</h3>
      <p>Follow the “What to do next” steps on the pair page — apply ahead where the status requires it, or just go where it doesn't.</p>
    </div>
  </div>

  <h2>Checked data vs copied data</h2>
  <div class="contrast">
    <div class="contrast-card bad">
      <h3><svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Most visa sites</h3>
      <ul>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Copy one dataset and never re-check it</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>No date on any answer — fresh and stale look identical</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Errors fixed silently, if at all</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Expiry dates on temporary rules never shown</li>
      </ul>
    </div>
    <div class="contrast-card good">
      <h3><svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>visafreely</h3>
      <ul>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12.5l5 5L19.5 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>A verified date and a named official source on {verifiedFmt} pairs — and counting</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12.5l5 5L19.5 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Every correction published in a public <a href="/changelog/">changelog</a>: old value, new value, source</span></li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12.5l5 5L19.5 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Announced end dates shown as “Scheduled change” warnings on the pair page</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12.5l5 5L19.5 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Unverified pairs labelled plainly, never dressed up</li>
      </ul>
    </div>
  </div>

  <h2>Most powerful passports right now</h2>
  <p class="muted small">Ranked by the number of destinations reachable without applying for a visa in advance (visa free + on arrival + e-Visa + ETA).</p>
  <div class="rank-rows" data-reveal>
    {ranked.map((r, i) => (
      <div class="rank-row">
        <span class={`rank-medal${i < 3 ? ' top' : ''}`}>{i + 1}</span>
        <a class="rr-name" href={`/passport/${r.c.slug}/`}>{r.c.name}</a>
        <span class="bar" aria-hidden="true"><i style={`--w:${barPct(r.easy)}%;width:var(--w)`}></i></span>
        <span class="rr-count">{r.easy} without a prior visa · {r.free} fully visa free</span>
      </div>
    ))}
  </div>

  <h2>Popular passports</h2>
  <div class="route-grid">
    {popularPassports.map((c) => (
      <a class="route-card" href={`/passport/${c.slug}/`}>
        <span class="rc-top"><span class="rc-name">{c.name} passport</span></span>
        <span class="rc-meta">{easyAccessCount(c.code)} destinations without a prior visa — where can you go?</span>
        <svg class="rc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    ))}
  </div>

  <h2>Popular destinations</h2>
  <div class="route-grid">
    {popularDestinations.map((c) => (
      <a class="route-card" href={`/destination/${c.slug}/`}>
        <span class="rc-top"><span class="rc-name">{c.name}</span></span>
        <span class="rc-meta">{visaFreePassportCount(c.code)} passports enter visa free — who can enter, and how?</span>
        <svg class="rc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    ))}
  </div>

  <h2>How to read a result</h2>
  <div class="legend-grid">
    {STATUS_ORDER.map((code) => (
      <div class="legend-card">
        <span class={`chip ${code}`}><span class="g"><i>{STATUS_GLYPH[code]}</i></span>{statusLabel(code)}</span>
        <p>{STATUS_BLURB[code]}</p>
      </div>
    ))}
  </div>
  <p>
    Most visa sites quietly copy one dataset and never check it. We show our work: pairs checked against
    an official source carry a “Last verified” date and a link to that source, corrections are published
    in the <a href="/changelog/">data changelog</a>, and everything else is honestly labelled with the
    dataset's own date. <a href="/about/">How verification works →</a>
  </p>

  <div class="closing-band">
    <h2>Spot an error?</h2>
    <p style="max-width:560px;margin:0 auto;">
      If a page here disagrees with an official source, that is exactly the feedback the changelog runs
      on — every confirmed discrepancy becomes a published correction with its source attached.
    </p>
    <div class="cb-actions">
      <a class="btn on-dark" href="/changelog/">See the corrections</a>
      <a class="btn ghost-on-dark" href="/about/">How we verify</a>
    </div>
  </div>
</Base>
