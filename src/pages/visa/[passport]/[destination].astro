---
import Base from '../../../layouts/Base.astro';
import Shelf from '../../../components/Shelf.astro';
import evisasCampaigns from '../../../data/evisas-campaigns.json';
import Stamp from '../../../components/Stamp.astro';
import ShareRow from '../../../components/ShareRow.astro';
import { insuranceFor } from '../../../lib/insurance';
import {
  countries,
  countryByCode,
  pairExtra,
  verdictText,
  statusLabel,
  pairPath,
  STATUS_MEANING,
  STATUS_STEPS,
  STATUS_CHECKLIST,
  STATUS_GLYPH,
  STATUS_COLOR,
  applyBeforeText,
  maxStayText,
  entryBasisText,
  formatDateLong,
  pairFaq,
  data,
} from '../../../lib/data';

export function getStaticPaths() {
  const paths = [];
  for (const p of countries) {
    for (const row of data.byPassport[p.code] || []) {
      const d = countryByCode[row.d];
      paths.push({
        params: { passport: p.slug, destination: d.slug },
        props: { p, d, row },
      });
    }
  }
  return paths;
}

const { p, d, row } = Astro.props;
const barSid = (evisasCampaigns as Record<string, string>)[`${p.code}:${d.code}`];
const evisasBarHref = barSid ? `https://evisas.com/?ref=visafreely&sid=${barSid}` : 'https://evisas.com/?ref=visafreely';
const extra = pairExtra(p.code, d.code);
const verdict = verdictText(row);
const label = statusLabel(row.s);
const glyph = STATUS_GLYPH[row.s] || '✓';
const meaning = STATUS_MEANING[row.s](p.name, d.name);
const needsVisa = row.s === 'R' || row.s === 'E';
const shelfMode = row.s === 'N' ? 'none' : needsVisa ? 'visa' : 'general';
const steps = STATUS_STEPS[row.s](p.name, d.name);
const checklist = STATUS_CHECKLIST[row.s];
const insFact = insuranceFor(d.code, row.s, p.code, row.days);
const faq = pairFaq(p.name, d.name, row, extra);
const title = `${p.name} Passport to ${d.name}: ${verdict} — Visa Requirements`;
const description = `Do ${p.name} passport holders need a visa for ${d.name}? ${verdict}. Requirement details, stay limit and data verification status.`;
const statusColor = STATUS_COLOR[row.s];
let sourceHost = '';
try { sourceHost = extra.source ? new URL(extra.source).hostname.replace(/^www\./, '') : ''; } catch { sourceHost = ''; }

const urlFor = (path: string) => new URL(path, Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Passports', item: urlFor('/passports/') },
    { '@type': 'ListItem', position: 2, name: `${p.name} passport`, item: urlFor(`/passport/${p.slug}/`) },
    { '@type': 'ListItem', position: 3, name: d.name, item: urlFor(pairPath(p, d)) },
  ],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Related pairs: same passport, same status, other destinations (alphabetical, up to 10)
const sameStatus = (data.byPassport[p.code] || [])
  .filter((r) => r.s === row.s && r.d !== d.code)
  .slice(0, 10);
// Same destination, visa-free passports sample (up to 10)
const freePassports = countries
  .filter((c) => c.code !== p.code)
  .map((c) => ({ c, r: (data.byPassport[c.code] || []).find((x) => x.d === d.code) }))
  .filter((x) => x.r && x.r.s === 'F')
  .slice(0, 10);
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/passports/">Passports</a><span class="sep">›</span>
    <a href={`/passport/${p.slug}/`}>{p.name} passport</a><span class="sep">›</span>
    <span>{d.name}</span>
  </nav>

  <h1>{p.name} passport → {d.name}</h1>

  <div class={`verdict-hero s-${row.s}`}>
    <div class="hero-seal" aria-hidden="true">
      <Stamp variant="seal" state={extra.verified ? 'verified' : 'pending'} size={96} ink={statusColor} />
    </div>
    <p class="route-line">{p.name} passport → {d.name}</p>
    <div class="big">{verdict}</div>
    <p class="vh-sub">
      Visa requirement for citizens of {p.name} travelling to {d.name} for tourism or short visits.
    </p>
    <span class={`chip ${row.s}`}><span class="g"><i>{glyph}</i></span>{label}</span>
    <div class="fact-tiles">
      <div class="fact-tile">
        <div class="fl">Max stay</div>
        <div class="fv">{maxStayText(row)}</div>
      </div>
      <div class="fact-tile">
        <div class="fl">Apply before travel?</div>
        <div class="fv">{applyBeforeText(row.s)}</div>
      </div>
      <div class="fact-tile">
        <div class="fl">Entry basis</div>
        <div class="fv">{entryBasisText(row.s)}</div>
      </div>
    </div>
  </div>

  <ShareRow
    url={urlFor(pairPath(p, d))}
    text={`${p.name} passport → ${d.name}: ${verdict} — visa requirements with the verification status shown`}
    label="Share this route"
  />

  {
    extra.verified ? (
      <div class="seal-block verified" data-reveal>
        <div class="seal-art" aria-hidden="true">
          <Stamp variant="seal" size={64} />
        </div>
        <div>
          <p class="seal-title">
            Verified — last checked {formatDateLong(extra.verified)} against an official source
          </p>
          <p>
            <a class="source-link" href={extra.source} rel="noopener" target="_blank">
              <span class="src-name">
                {extra.source_name}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M9.5 7H17v7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              {sourceHost && <span class="host">{sourceHost}</span>}
            </a>
          </p>
          {extra.note && <p>{extra.note}</p>}
          {extra.changed && (
            <p>
              Value last changed {formatDateLong(extra.changed)} — see the <a href="/changelog/">changelog</a>.
            </p>
          )}
        </div>
      </div>
    ) : (
      <div class="seal-block pending" data-reveal>
        <div class="seal-art" aria-hidden="true">
          <Stamp variant="seal" state="pending" size={64} />
        </div>
        <div>
          <p class="seal-title">Dataset — not yet individually verified</p>
          <p>
            Data from the passport-index dataset, {data.vintage} snapshot
            {extra.overridden ? ' — with a correction applied by visafreely (see the changelog)' : ''}.
            This pair has not yet been individually verified against an official source; see
            <a href="/about/"> how verification works</a>.
          </p>
          {extra.note && <p>Note: {extra.note}</p>}
          {extra.changed && <p>This value was last changed on {formatDateLong(extra.changed)}.</p>}
        </div>
      </div>
    )
  }

  {
    extra.valid_until && (
      <div class="warn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5.5l3.8 2.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>
          <strong>Scheduled change:</strong> the rule shown here is currently announced to run until{' '}
          {formatDateLong(extra.valid_until)}. It may be extended or replaced — re-check before travelling after that date.
        </span>
      </div>
    )
  }

  <Shelf status={row.s} passportName={p.name} destinationName={d.name} passportCode={p.code} destinationCode={d.code} pos="top" />

  <h2>What to do next</h2>
  <ol class="steps" data-reveal>
    {steps.map((s) => <li><span><strong>{s.t}.</strong> {s.b}</span></li>)}
  </ol>

  <h2>Before you go</h2>
  <div class="checklist-card">
    <ul class="checklist">
      {checklist.map((item) => (
        <li>
          <span class="ck-ic" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M4.5 12.5l5 5L19.5 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span>{item}</span>
        </li>
      ))}
      {insFact && (
        <li class="ck-fact">
          <span class="ck-ic" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.4"/><path d="M12 11v5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><circle cx="12" cy="8" r="1.6" fill="currentColor"/></svg></span>
          <span>{insFact.note} <span class="ck-src">(<a href={insFact.sourceUrl} rel="noopener" target="_blank">{insFact.sourceName}</a>)</span></span>
        </li>
      )}
    </ul>
  </div>

  <Shelf status={row.s} passportName={p.name} destinationName={d.name} passportCode={p.code} destinationCode={d.code} pos="bottom" />

  <h2>Requirement details</h2>
  <div class="spec-card">
    <dl style="margin:0;">
      <div class="spec-row">
        <dt>Requirement</dt>
        <dd><span class={`chip ${row.s}`}><span class="g"><i>{glyph}</i></span>{label}</span></dd>
      </div>
      <div class="spec-row">
        <dt>Maximum stay</dt>
        <dd>{maxStayText(row)}</dd>
      </div>
      <div class="spec-row">
        <dt>Apply before travel?</dt>
        <dd>{applyBeforeText(row.s)}</dd>
      </div>
      {
        extra.verified && (
          <div class="spec-row">
            <dt>Evidence</dt>
            <dd>
              Last verified {formatDateLong(extra.verified)} ·{' '}
              <a href={extra.source} rel="noopener" target="_blank">{extra.source_name}</a>
            </dd>
          </div>
        )
      }
    </dl>
  </div>

  <div class="narrow">
    <h2>What this means</h2>
    <p>{meaning}</p>
    <p>
      Whatever the requirement, your passport generally needs at least six months of validity beyond your
      travel dates, and border officers can ask for proof of onward travel and sufficient funds. Rules on
      this page cover ordinary passports and short tourist visits — work, study and long stays follow
      different rules.
    </p>
    {
      row.s === 'F' && (
        <p>
          <strong>Visa-free does not always mean form-free:</strong> some destinations ask visa-exempt
          visitors to complete an official arrival form or digital arrival card. Where one exists, it is
          free through the government's own site — you never need to pay a third party for the form itself.
        </p>
      )
    }
  </div>

  <h2>Frequently asked questions</h2>
  {faq.map((f, i) => (
    <div class={`faq-item${i === 0 ? ' open' : ''}`}>
      <h3 style="margin:0;">
        <button class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'}>
          <span>{f.q}</span>
          <svg class="chev" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </h3>
      <div class="faq-panel">
        <div class="faq-a"><p>{f.a}</p></div>
      </div>
    </div>
  ))}

  {
    sameStatus.length > 0 && (
      <>
        <h2>More destinations for {p.name} passports</h2>
        <div class="route-grid">
          {sameStatus.map((r) => (
            <a class="route-card" href={pairPath(p, countryByCode[r.d])}>
              <span class="rc-top"><span class={`sdot ${r.s}`}></span><span class="rc-name">{countryByCode[r.d].name}</span></span>
              <span class="rc-meta">{verdictText(r)}</span>
              <svg class="rc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </>
    )
  }
  {
    freePassports.length > 0 && (
      <>
        <h2>Who else enters {d.name} visa free</h2>
        <div class="route-grid">
          {freePassports.map((x) => (
            <a class="route-card" href={pairPath(x.c, d)}>
              <span class="rc-top"><span class="sdot F"></span><span class="rc-name">{x.c.name}</span></span>
              <span class="rc-meta">{verdictText(x.r)}</span>
              <svg class="rc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </>
    )
  }

  <div class="closing-band">
    <h2>Visa rules change often</h2>
    <p style="max-width:560px;margin:0 auto;">
      New exemptions, e-Visa mandates and suspensions take effect every month — and most
      datasets notice late. We track the changes themselves, from the official text, on the
      date each one takes effect.
    </p>
    <form id="route-alert-form" style="margin:20px auto 0;max-width:520px;">
      <label for="route-alert-email" style="display:block;font-weight:600;color:#fff;margin-bottom:8px;">Get an email if the rules for this route change</label>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
        <input id="route-alert-email" type="email" required placeholder="you@example.com" autocomplete="email"
          style="flex:1 1 240px;max-width:340px;padding:11px 14px;border-radius:10px;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.1);color:#fff;font-size:15px;" />
        <button type="submit" class="btn on-dark" style="cursor:pointer;">Alert me</button>
      </div>
      <p id="route-alert-status" hidden style="margin:10px auto 0;color:#bfe3cd;font-size:14px;"></p>
    </form>
    <script is:inline>
      (function () {
        var form = document.getElementById('route-alert-form');
        if (!form) return;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = document.getElementById('route-alert-email').value.trim();
          var status = document.getElementById('route-alert-status');
          fetch('https://honru09--site-stats-web.us-east.modal.run/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ site: 'visafreely', email: email, route: location.pathname })
          }).then(function (r) {
            status.hidden = false;
            if (r.ok) {
              status.textContent = 'You are on the list — we will email you if this route changes.';
              form.querySelector('button').disabled = true;
            } else {
              status.textContent = 'That email did not go through — please check it and try again.';
            }
          }).catch(function () {
            status.hidden = false;
            status.textContent = 'Could not reach the signup service — please try again later.';
          });
        });
      })();
    </script>
    <div class="cb-actions">
      <a class="btn on-dark" href="/visa-policy-changes/">Latest visa policy changes</a>
      <a class="btn ghost-on-dark" href="/widget/">Put this checker on your site</a>
    </div>
  </div>

  {(row.s === 'R' || row.s === 'E' || row.s === 'T') && (
    <div class="sticky-bar" role="complementary" aria-label="Visa service">
      <span class="sb-text">{row.s === 'R' ? `Visa required for ${d.name}` : row.s === 'E' ? `e-Visa for ${d.name} — apply before you fly` : `Travel authorisation for ${d.name} — file it before you travel`}</span>
      <a class="sb-btn" data-offer="evisas-bar" href={evisasBarHref} rel="sponsored nofollow noopener" target="_blank">Get it handled →</a>
    </div>
  )}
</Base>
