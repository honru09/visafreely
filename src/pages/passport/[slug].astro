---
import Base from '../../layouts/Base.astro';
import {
  countries,
  countryByCode,
  groupedForPassport,
  countsForPassport,
  easyAccessCount,
  passportRank,
  statusLabel,
  verdictText,
  pairPath,
  flagEmoji,
} from '../../lib/data';

export function getStaticPaths() {
  return countries.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const groups = groupedForPassport(c.code);
const counts = countsForPassport(c.code);
const easy = easyAccessCount(c.code);
const rank = passportRank[c.code];
const title = `${c.name} Passport: Visa-Free Countries & Requirements`;
const description = `Where can ${c.name} passport holders travel without a visa? ${counts.F || 0} visa-free destinations, ${easy} reachable without applying in advance — full list with stay limits.`;
const others = countries.filter((x) => x.code !== c.code);
const total = groups.reduce((n, g) => n + g.rows.length, 0);
---

<Base title={title} description={description}>
  <section class="band light">
    <div class="band-in">
      <div class="crumbs"><a href="/passports/">All passports</a></div>
      <div class="hub-hero-flex">
        <div>
          <h1>{c.name} passport</h1>
          <p class="lede" style="margin-bottom:0;">
            Holders of a {c.name} passport can enter <strong>{counts.F || 0} destinations visa free</strong> and
            reach <strong>{easy} destinations</strong> in total without applying for a visa in advance.
          </p>
        </div>
        <div class="rank-block">
          <span class="rank-medal big top">#{rank}</span>
          <div class="rb-label">of {countries.length} passports</div>
          <div class="rb-note">Ranked by {easy} destinations reachable without applying for a visa in advance.</div>
        </div>
      </div>
    </div>
  </section>

  <div class="stat-band five">
    <div class="stat-tile"><b>{counts.F || 0}</b><span>visa free</span></div>
    <div class="stat-tile"><b>{counts.A || 0}</b><span>visa on arrival</span></div>
    <div class="stat-tile"><b>{counts.E || 0}</b><span>e-Visa</span></div>
    <div class="stat-tile"><b>{counts.T || 0}</b><span>ETA</span></div>
    <div class="stat-tile"><b>{counts.R || 0}</b><span>visa required</span></div>
  </div>

  <div data-filter-root>
    <div class="filter-chips" role="group" aria-label="Filter destinations by requirement">
      <button type="button" class="fchip on" data-filter="all" aria-pressed="true">All<span class="fcount">{total}</span></button>
      {groups.map((g) => (
        <button type="button" class={`fchip s-${g.code}`} data-filter={g.code} aria-pressed="false">
          <span class={`sdot ${g.code}`}></span>{statusLabel(g.code)}<span class="fcount">{g.rows.length}</span>
        </button>
      ))}
    </div>

    {groups.map((g) => (
      <section data-status={g.code}>
        <h2>{statusLabel(g.code)}<span class="count-pill">{g.rows.length}</span></h2>
        <div class="route-grid">
          {g.rows.map((r) => (
            <a class="route-card" href={pairPath(c, countryByCode[r.d])}>
              <span class="rc-top"><span class="rc-flag" aria-hidden="true">{flagEmoji(r.d)}</span><span class={`sdot ${g.code}`}></span><span class="rc-name">{countryByCode[r.d].name}</span></span>
              <span class="rc-meta">{verdictText(r)}</span>
              <svg class="rc-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5.5L19.5 12 13 18.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <h2>Other passports</h2>
  <div class="pill-cloud">
    {others.slice(0, 40).map((x) => (
      <a href={`/passport/${x.slug}/`}>{x.name}</a>
    ))}
    <a href="/passports/">See all {countries.length} passports →</a>
  </div>
</Base>
