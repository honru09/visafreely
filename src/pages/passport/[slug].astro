---
import Base from '../../layouts/Base.astro';
import {
  countries,
  countryByCode,
  groupedForPassport,
  countsForPassport,
  easyAccessCount,
  statusLabel,
  verdictText,
  pairPath,
} from '../../lib/data';

export function getStaticPaths() {
  return countries.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const groups = groupedForPassport(c.code);
const counts = countsForPassport(c.code);
const easy = easyAccessCount(c.code);
const rank = countries
  .map((x) => ({ code: x.code, easy: easyAccessCount(x.code) }))
  .sort((a, b) => b.easy - a.easy)
  .findIndex((x) => x.code === c.code) + 1;
const title = `${c.name} Passport: Visa-Free Countries & Requirements`;
const description = `Where can ${c.name} passport holders travel without a visa? ${counts.F || 0} visa-free destinations, ${easy} reachable without applying in advance — full list with stay limits.`;
const others = countries.filter((x) => x.code !== c.code);
---

<Base title={title} description={description}>
  <div class="crumbs"><a href="/passports/">All passports</a></div>
  <h1>{c.name} passport</h1>
  <p class="lede">
    Holders of a {c.name} passport can enter <strong>{counts.F || 0} destinations visa free</strong> and
    reach <strong>{easy} destinations</strong> in total without applying for a visa in advance
    (ranked #{rank} of {countries.length} passports on that measure).
  </p>
  <div class="stat-row">
    <div class="stat"><b>{counts.F || 0}</b><span>visa free</span></div>
    <div class="stat"><b>{counts.A || 0}</b><span>visa on arrival</span></div>
    <div class="stat"><b>{(counts.E || 0) + (counts.T || 0)}</b><span>e-Visa / ETA</span></div>
    <div class="stat"><b>{counts.R || 0}</b><span>visa required</span></div>
  </div>

  {groups.map((g) => (
    <>
      <h2>{statusLabel(g.code)} ({g.rows.length})</h2>
      <ul class="linklist">
        {g.rows.map((r) => (
          <li>
            <a href={pairPath(c, countryByCode[r.d])}>{countryByCode[r.d].name}</a>
            <span class="muted small"> — {verdictText(r)}</span>
          </li>
        ))}
      </ul>
    </>
  ))}

  <h2>Other passports</h2>
  <p class="small muted">
    {others.slice(0, 40).map((x, i) => (
      <>
        <a href={`/passport/${x.slug}/`}>{x.name}</a>{i < 39 ? ' · ' : ''}
      </>
    ))}
    {' '}— <a href="/passports/">see all {countries.length} passports</a>
  </p>
</Base>
